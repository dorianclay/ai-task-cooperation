TOOL submit_solution {"ticket_id": "T-3577", "code": "from typing import List\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        # copy[i] = original[i] + d for a fixed shift d = copy[0] - original[0].\n        # Each index i requires u_i <= original[i] + d <= v_i,\n        # so d must lie in [u_i - original[i], v_i - original[i]].\n        lo = float('-inf')\n        hi = float('inf')\n        for o, (u, v) in zip(original, bounds):\n            lo = max(lo, u - o)\n            hi = min(hi, v - o)\n            if lo > hi:\n                return 0\n        return max(0, int(hi - lo + 1))\n"}

