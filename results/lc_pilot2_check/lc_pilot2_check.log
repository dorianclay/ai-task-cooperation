TOOL submit_solution {"ticket_id": "Q-7113", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        last = {}  # value -> stack of depths of ancestors on current path\n        pathD = [0] * (n + 1)\n        best_len = -1\n        best_nodes = float('inf')\n        stack = [(\"enter\", 0, -1, 0, 0, 0)]\n        while stack:\n            item = stack.pop()\n            if item[0] == \"exit\":\n                val = item[1]\n                last[val].pop()\n                continue\n            _, v, parent, d, dist, lo_parent = item\n            val = nums[v]\n            lst = last.setdefault(val, [])\n            lo_v = lo_parent\n            if lst:\n                lo_v = max(lo_v, lst[-1] + 1)\n            lst.append(d)\n            pathD[d] = dist\n            length = dist - pathD[lo_v]\n            nodes = d - lo_v + 1\n            if length > best_len or (length == best_len and nodes < best_nodes):\n                best_len = length\n                best_nodes = nodes\n            stack.append((\"exit\", val))\n            for c, w in adj[v]:\n                if c != parent:\n                    stack.append((\"enter\", c, v, d + 1, dist + w, lo_v))\n        return [best_len, best_nodes]\n"}

