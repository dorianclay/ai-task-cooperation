TOOL submit_solution {"ticket_id": "Q-8840", "code": "from typing import List\n\nclass Solution:\n    def countMentions(self, numberOfUsers: int, events: List[List[str]]) -> List[int]:\n        mentions = [0] * numberOfUsers\n        offline_until = [0] * numberOfUsers  # user is offline while offline_until > t\n        # sort by timestamp; OFFLINE before MESSAGE at same timestamp\n        evs = sorted(events, key=lambda e: (int(e[1]), 0 if e[0] == \"OFFLINE\" else 1))\n        for typ, ts, data in evs:\n            t = int(ts)\n            if typ == \"OFFLINE\":\n                uid = int(data)\n                offline_until[uid] = t + 60\n            else:\n                if data == \"ALL\":\n                    for i in range(numberOfUsers):\n                        mentions[i] += 1\n                elif data == \"HERE\":\n                    for i in range(numberOfUsers):\n                        if offline_until[i] <= t:\n                            mentions[i] += 1\n                else:\n                    for tok in data.split():\n                        if tok.startswith(\"id\"):\n                            mentions[int(tok[2:])] += 1\n        return mentions\n"}

