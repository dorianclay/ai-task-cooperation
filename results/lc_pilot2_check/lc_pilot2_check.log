TOOL submit_solution {"ticket_id": "T-3554", "code": "class Solution:\n    def countSubstrings(self, s: str) -> int:\n        n = len(s)\n        digits = [ord(c) - 48 for c in s]\n\n        # Prefix digit sums for divisibility by 3 and 9.\n        ps = [0] * (n + 1)\n        for k in range(n):\n            ps[k + 1] = ps[k] + digits[k]\n\n        # Weighted prefix mod 7: Q[k+1] = Q[k] + d_k * 10^k (mod 7).\n        Q = [0] * (n + 1)\n        pw = 1\n        for k in range(n):\n            Q[k + 1] = (Q[k] + digits[k] * pw) % 7\n            pw = pw * 10 % 7\n\n        cnt3 = [0] * 3\n        cnt9 = [0] * 9\n        cnt7 = [0] * 7\n        ans = 0\n\n        for j in range(n):\n            d = digits[j]\n            # Include start index i = j.\n            cnt3[ps[j] % 3] += 1\n            cnt9[ps[j] % 9] += 1\n            cnt7[Q[j]] += 1\n\n            if d == 0:\n                continue\n            if d in (1, 2, 5):\n                # Divisible by last digit always.\n                ans += j + 1\n            elif d in (3, 6):\n                # Divisible by 3 <=> digit sum divisible by 3 (for 6, evenness is automatic).\n                ans += cnt3[ps[j + 1] % 3]\n            elif d == 9:\n                ans += cnt9[ps[j + 1] % 9]\n            elif d == 4:\n                last2 = digits[j - 1] * 10 + digits[j] if j >= 1 else 0\n                ans += 1 + (j if last2 % 4 == 0 else 0)\n            elif d == 8:\n                last2 = digits[j - 1] * 10 + digits[j] if j >= 1 else 0\n                last3 = digits[j - 2] * 100 + digits[j - 1] * 10 + digits[j] if j >= 2 else 0\n                ans += 1\n                if j >= 1 and last2 % 8 == 0:\n                    ans += 1\n                if j >= 2 and last3 % 8 == 0:\n                    ans += j - 1\n            elif d == 7:\n                # value(i..j) * 10^i ≡ Q[j+1] - Q[i] (mod 7), and 10 is invertible mod 7.\n                ans += cnt7[Q[j + 1]]\n\n        return ans\n"}

