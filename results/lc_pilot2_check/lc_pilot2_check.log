TOOL submit_solution {"ticket_id": "Q-6114", "code": "from bisect import bisect_left\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        def find_all(text, pat):\n            n = len(text)\n            if len(pat) == 0:\n                return list(range(n + 1))\n            if len(pat) > n:\n                return []\n            comb = pat + \"\\x00\" + text\n            m = len(comb)\n            pi = [0] * m\n            for q in range(1, m):\n                k = pi[q - 1]\n                while k > 0 and comb[q] != comb[k]:\n                    k = pi[k - 1]\n                if comb[q] == comb[k]:\n                    k += 1\n                pi[q] = k\n            L = len(pat)\n            res = []\n            for q in range(L + 1, m):\n                if pi[q] == L:\n                    res.append(q - 2 * L)  # start index in text\n            return res\n\n        parts = p.split(\"*\")\n        pre, mid, suf = parts[0], parts[1], parts[2]\n        lp, lm, ls = len(pre), len(mid), len(suf)\n        P = find_all(s, pre)\n        M = find_all(s, mid)\n        S = find_all(s, suf)\n        if not P or not M or not S:\n            return -1\n        best = None\n        for i in P:\n            j_idx = bisect_left(M, i + lp)\n            if j_idx >= len(M):\n                continue\n            j = M[j_idx]\n            k_idx = bisect_left(S, j + lm)\n            if k_idx >= len(S):\n                continue\n            k = S[k_idx]\n            length = k + ls - i\n            if best is None or length < best:\n                best = length\n        return -1 if best is None else best\n"}

