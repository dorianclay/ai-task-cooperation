TOOL submit_solution {"ticket_id": "Q-8490", "code": "from typing import List\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        NEG = float('-inf')\n        m, n = len(coins), len(coins[0])\n        # dp[i][j][k] = max profit reaching (i,j) having used k neutralizations\n        dp = [[[NEG] * 3 for _ in range(n)] for _ in range(m)]\n        for i in range(m):\n            for j in range(n):\n                v = coins[i][j]\n                for k in range(3):\n                    best = NEG\n                    if i == 0 and j == 0:\n                        if v >= 0:\n                            best = v if k == 0 else NEG\n                            if k >= 1:\n                                best = v  # no need to use neutralization; allow carrying\n                        else:\n                            if k == 0:\n                                best = v\n                            elif k == 1:\n                                best = 0\n                            else:\n                                best = 0\n                        dp[i][j][k] = best\n                        continue\n                    # previous states\n                    prevs = []\n                    if i > 0:\n                        prevs.append(dp[i - 1][j])\n                    if j > 0:\n                        prevs.append(dp[i][j - 1])\n                    for pv in prevs:\n                        # not neutralized using this cell\n                        if pv[k] != NEG:\n                            gain = v if v >= 0 else v\n                            best = max(best, pv[k] + gain)\n                        # neutralized using this cell\n                        if v < 0 and k >= 1 and pv[k - 1] != NEG:\n                            best = max(best, pv[k - 1])\n                    dp[i][j][k] = best\n        return max(dp[m - 1][n - 1])\n"}

