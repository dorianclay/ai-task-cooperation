TOOL submit_solution {"ticket_id": "Q-2991", "code": "from typing import List\n\nclass Solution:\n    def minimumPairRemoval(self, nums: List[int]) -> int:\n        arr = list(nums)\n        ops = 0\n\n        def sorted_ok(a):\n            return all(a[i] <= a[i + 1] for i in range(len(a) - 1))\n\n        while not sorted_ok(arr):\n            best = None\n            best_sum = None\n            for i in range(len(arr) - 1):\n                s = arr[i] + arr[i + 1]\n                if best_sum is None or s < best_sum:\n                    best_sum = s\n                    best = i\n            arr[best:best + 2] = [best_sum]\n            ops += 1\n        return ops\n"}

