TOOL submit_solution {"ticket_id": "T-8397", "code": "class Solution:\n    def generateString(self, str1: str, str2: str) -> str:\n        n, m = len(str1), len(str2)\n        L = n + m - 1\n        word = [None] * L\n        forced = [False] * L\n        # Place T constraints\n        for i, c in enumerate(str1):\n            if c == 'T':\n                for j in range(m):\n                    p = i + j\n                    if forced[p]:\n                        if word[p] != str2[j]:\n                            return \"\"\n                    else:\n                        forced[p] = True\n                        word[p] = str2[j]\n        # Fill free positions with 'a'\n        for p in range(L):\n            if word[p] is None:\n                word[p] = 'a'\n        # Handle F constraints: each F window must differ from str2.\n        # Adjust the rightmost unforced position in the window.\n        for i, c in enumerate(str1):\n            if c != 'F':\n                continue\n            if word[i:i + m] != list(str2):\n                continue\n            # find rightmost non-forced position in window\n            pos = -1\n            for j in range(m - 1, -1, -1):\n                if not forced[i + j]:\n                    pos = i + j\n                    break\n            if pos == -1:\n                return \"\"\n            # increase that character minimally to differ; since it was 'a'\n            # or some letter, bump to 'b' etc. Need next letter different from str2[...]\n            cur = word[pos]\n            nxt = chr(ord(cur) + 1)\n            if nxt > 'z':\n                return \"\"\n            word[pos] = nxt\n        return \"\".join(word)\n"}

