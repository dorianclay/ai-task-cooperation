TOOL submit_solution {"ticket_id": "Q-3577", "code": "from typing import List\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        lo, hi = -10**18, 10**18\n        base = original[0]\n        for i, (u, v) in enumerate(bounds):\n            d = original[i] - base\n            lo = max(lo, u - d)\n            hi = min(hi, v - d)\n            if lo > hi:\n                return 0\n        return hi - lo + 1\n"}

