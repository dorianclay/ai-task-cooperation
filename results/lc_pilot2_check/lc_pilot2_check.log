TOOL submit_solution {"ticket_id": "Q-8490", "code": "from typing import List\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        NEG = float(\"-inf\")\n        m, n = len(coins), len(coins[0])\n        prev = None\n        for i in range(m):\n            cur = [[NEG] * 3 for _ in range(n)]\n            for j in range(n):\n                v = coins[i][j]\n                if i == 0 and j == 0:\n                    prevs = [[0, NEG, NEG]]\n                    cand = [0, NEG, NEG]\n                    # start cell: base state\n                    base = [0, NEG, NEG]\n                    cand = base\n                else:\n                    cand = [NEG, NEG, NEG]\n                    if i > 0:\n                        for k in range(3):\n                            cand[k] = max(cand[k], prev[j][k])\n                    if j > 0:\n                        for k in range(3):\n                            cand[k] = max(cand[k], cur[j - 1][k])\n                for k in range(3):\n                    if cand[k] == NEG:\n                        continue\n                    # take cell value\n                    val = cand[k] + v\n                    if val > cur[j][k]:\n                        cur[j][k] = val\n                    # neutralize robber\n                    if v < 0 and k < 2:\n                        if cand[k] > cur[j][k + 1]:\n                            cur[j][k + 1] = cand[k]\n            prev = cur\n        return int(max(prev[n - 1]))\n"}

