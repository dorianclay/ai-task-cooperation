TOOL submit_solution {"ticket_id": "T-5583", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # state: (parity, alt_sum, product) where parity = len(chosen) % 2\n        # product tracked exactly while <= limit; zero-included is tracked as product 0\n        # with a separate \"has zero\" flag so further multiplications keep it 0.\n        # Represent states as set of (parity, alt_sum, product, zero_flag).\n        # Note: if zero included, product is 0 regardless of later values.\n        states = set()\n        best = -1\n        for x in nums:\n            new_states = set()\n            # start a new subsequence with x\n            new_states.add((1, x, x if x != 0 else 0, x == 0))\n            for parity, s, prod, z in states:\n                # alternating sign: even position (parity 0) adds, odd subtracts\n                sign = 1 if parity == 0 else -1\n                ns = s + sign * x\n                if z or x == 0:\n                    nprod = 0\n                    nz = True\n                else:\n                    nprod = prod * x\n                    if nprod > limit:\n                        # cannot exceed limit; but still keep state for alt sum?\n                        # product only grows (x>=1), so this branch is dead\n                        continue\n                    nz = False\n                new_states.add(((parity + 1) % 2, ns, nprod, nz))\n            states |= new_states\n            # bound state explosion: product <= limit, sums bounded by len*12\n        for parity, s, prod, z in states:\n            if s == k:\n                if prod > best:\n                    best = prod\n        return best\n"}

