TOOL submit_solution {"ticket_id": "T-6114", "code": "from bisect import bisect_left\nfrom typing import List\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n\n        def find_all(pat: str) -> List[int]:\n            # All start positions i with s[i:i+len(pat)] == pat (overlaps allowed).\n            if pat == \"\":\n                return list(range(n + 1))\n            m = len(pat)\n            # KMP prefix function\n            pi = [0] * m\n            k = 0\n            for q in range(1, m):\n                while k and pat[q] != pat[k]:\n                    k = pi[k - 1]\n                if pat[q] == pat[k]:\n                    k += 1\n                pi[q] = k\n            res = []\n            k = 0\n            for idx, ch in enumerate(s):\n                while k and ch != pat[k]:\n                    k = pi[k - 1]\n                if ch == pat[k]:\n                    k += 1\n                if k == m:\n                    res.append(idx - m + 1)\n                    k = pi[k - 1]\n            return res\n\n        A, B, C = p.split(\"*\")\n        occA = find_all(A)\n        occB = find_all(B)\n        occC = find_all(C)\n        if not occA or not occB or not occC:\n            return -1\n\n        lb, lc = len(B), len(C)\n        best = -1\n        for i in occA:\n            # Earliest B starting at or after the end of A-match.\n            j = bisect_left(occB, i + len(A))\n            if j == len(occB):\n                continue\n            k = occB[j]\n            # Earliest C starting at or after the end of B-match.\n            t = bisect_left(occC, k + lb)\n            if t == len(occC):\n                continue\n            end = occC[t] + lc\n            length = end - i\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

