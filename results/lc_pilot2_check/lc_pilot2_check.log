TOOL submit_solution {"ticket_id": "T-7113", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        last = {}          # value -> depth of its most recent occurrence on current root path\n        dd = [0] * (n + 1)  # dd[d] = distance from root to the node at depth d on current path\n        best_len = 0\n        best_cnt = 1\n\n        # Stack items: (0, node, parent, depth, dist, lo) = enter; (1, val, prev, ...) = exit\n        stack = [(0, 0, -1, 0, 0, 0)]\n        while stack:\n            item = stack.pop()\n            if item[0] == 1:\n                _, val, prev = item[0], item[1], item[2]\n                if prev == -1:\n                    del last[val]\n                else:\n                    last[val] = prev\n                continue\n\n            _, node, parent, depth, dist, lo = item\n            val = nums[node]\n            prev = last.get(val, -1)\n            nl = max(lo, prev + 1)\n            last[val] = depth\n            dd[depth] = dist\n\n            length = dist - dd[nl]\n            cnt = depth - nl + 1\n            if length > best_len or (length == best_len and cnt < best_cnt):\n                best_len = length\n                best_cnt = cnt\n\n            stack.append((1, val, prev, 0, 0, 0))\n            for c, w in adj[node]:\n                if c != parent:\n                    stack.append((0, c, node, depth + 1, dist + w, nl))\n\n        return [best_len, best_cnt]\n"}

