TOOL submit_solution {"ticket_id": "Q-6114", "code": "import bisect\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        pre, rest = p.split('*', 1)\n        mid, suf = rest.split('*', 1)\n        n = len(s)\n\n        def occurrences(t):\n            if t == \"\":\n                return list(range(n + 1))\n            # KMP prefix function on t + '#' + s\n            comb = t + '\\x00' + s\n            m = len(t)\n            pi = [0] * len(comb)\n            for i in range(1, len(comb)):\n                k = pi[i - 1]\n                while k and comb[i] != comb[k]:\n                    k = pi[k - 1]\n                if comb[i] == comb[k]:\n                    k += 1\n                pi[i] = k\n            res = []\n            for i in range(m + 1, len(comb)):\n                if pi[i] == m:\n                    res.append(i - m - m)  # start index in s\n            return res\n\n        pre_occ = occurrences(pre)\n        mid_occ = occurrences(mid)\n        suf_occ = occurrences(suf)\n        best = -1\n        for i in pre_occ:\n            idx = bisect.bisect_left(mid_occ, i + len(pre))\n            if idx == len(mid_occ):\n                continue\n            j = mid_occ[idx]\n            idx2 = bisect.bisect_left(suf_occ, j + len(mid))\n            if idx2 == len(suf_occ):\n                continue\n            k = suf_occ[idx2]\n            length = k + len(suf) - i\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

