TOOL submit_solution {"ticket_id": "T-6123", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # Bucket each pair by its larger endpoint, storing the smaller endpoint and pair id.\n        buckets = [[] for _ in range(n + 1)]\n        for idx, (x, y) in enumerate(conflictingPairs):\n            lo, hi = min(x, y), max(x, y)\n            buckets[hi].append((lo, idx))\n\n        m = len(conflictingPairs)\n        gain = [0] * m\n        base = 0\n        # Top two left endpoints (from distinct pairs) among pairs with right endpoint <= r.\n        v1, id1, v2 = 0, -1, 0\n        for r in range(1, n + 1):\n            for a, idx in buckets[r]:\n                if a > v1:\n                    v2 = v1\n                    v1, id1 = a, idx\n                elif a > v2:\n                    v2 = a\n            # Subarrays ending at r that avoid all conflicts: starts in (v1, r].\n            base += r - v1\n            # Removing pair id1 raises the bound from v1 to v2 for this r.\n            if id1 >= 0:\n                gain[id1] += v1 - v2\n\n        return base + max(gain)\n"}

