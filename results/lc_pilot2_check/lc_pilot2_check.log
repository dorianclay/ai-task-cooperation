TOOL submit_solution {"ticket_id": "Q-3523", "code": "from typing import List\nfrom collections import defaultdict\nfrom bisect import bisect_left\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        groups = defaultdict(list)\n        for i, v in enumerate(nums):\n            groups[v].append(i)  # already sorted by index\n        res = []\n        for q in queries:\n            pos = groups[nums[q]]\n            s = len(pos)\n            if s == 1:\n                res.append(-1)\n                continue\n            k = bisect_left(pos, q)\n            best = n\n            for other in (pos[(k - 1) % s], pos[(k + 1) % s]):\n                d = abs(other - q)\n                d = min(d, n - d)\n                if d < best:\n                    best = d\n            res.append(best)\n        return res\n"}

