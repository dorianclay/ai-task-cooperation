class Solution:
    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:


=== MODEL ===
This is a DFS problem: for each node, the valid downward paths are those whose values are all distinct. I'll DFS from the root while maintaining the current path's distances and a count map of values on the path. For each node, I'll keep a sliding left bound: the earliest ancestor index such that the path from there has unique values. The longest special path ending at a node is found using a per-value "last seen depth" map, with a stack-based left boundary. I'll use an iterative DFS to avoid recursion limits.
TOOL submit_solution {"ticket_id": "T-7113", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        # path_dist[d] = distance from root to node at depth d on current path\n        # path_node_val[d] = value at depth d\n        # last_depth: value -> depth of its most recent occurrence on current path\n        best_len = 0\n        best_nodes = 1  # minimal node count among longest paths\n\n        # Iterative DFS with explicit enter/exit to maintain path state.\n        # Each stack item: (node, parent, depth, dist, left_bound_index, state)\n        # left_bound: smallest depth index allowed as path start, so that values unique.\n        last_occ = {}  # value -> depth of last occurrence on current root path\n        dist_prefix = []  # dist_prefix[d] = dist from root to node at depth d\n        val_at_depth = []\n\n        # stack entries: (node, parent, depth, state, saved_left)\n        stack = [(0, -1, 0, 0, 0)]\n        # store per-node left bound on enter\n        left_of_depth = []  # left bound (min allowed start depth) for node at depth d\n        # When exiting, we must restore last_occ entry for that node's value\n        restore = {}\n\n        while stack:\n            node, parent, depth, state, _ = stack.pop()\n            if state == 0:\n                # entering node\n                val = nums[node]\n                # prev left bound from parent's chain\n                prev_left = left_of_depth[depth - 1] if depth > 0 else 0\n                prev_occ = last_occ.get(val, -1)\n                left = max(prev_left, prev_occ + 1)\n                # record state to restore on exit\n                restore[node] = (val, prev_occ)\n                last_occ[val] = depth\n                # trim per-depth arrays to current depth\n                del dist_prefix[depth:]\n                del val_at_depth[depth:]\n                del left_of_depth[depth:]\n                dist = dist_prefix[depth - 1] if depth > 0 else 0\n                # distance from root to node: dist_prefix (distances along path)\n                if depth == 0:\n                    cur_dist = 0\n                else:\n                    cur_dist = dist_prefix[depth - 1] + parent_w[node]\n                dist_prefix.append(cur_dist)\n                val_at_depth.append(val)\n                left_of_depth.append(left)\n                # path from depth 'left' to depth 'depth'\n                start_dist = dist_prefix[left]\n                length = cur_dist - start_dist\n                nodes = depth - left + 1\n                if length > best_len or (length == best_len and nodes < best_nodes):\n                    best_len = length\n                    best_nodes = nodes\n                # schedule exit\n                stack.append((node, parent, depth, 1, 0))\n                # schedule children\n                for child, w in adj[node]:\n                    if child != parent:\n                        parent_w[child] = w\n                        stack.append((child, node, depth + 1, 0, 0))\n            else:\n                # exiting node: restore last occurrence for its value\n                val, prev_occ = restore.pop(node)\n                if prev_occ == -1:\n                    last_occ.pop(val, None)\n                else:\n                    last_occ[val] = prev_occ\n\n        return [best_len, best_nodes]\n"}

