TOOL submit_solution {"ticket_id": "Q-6001", "code": "from typing import Dict, Tuple, List\n\nclass Solution:\n    def beautifulNumbers(self, l: int, r: int) -> int:\n        # G[L]: distribution of (digit_sum, digit_product) over all digit strings of length L (zeros allowed)\n        G: List[Dict[Tuple[int, int], int]] = [{(0, 1): 1}]\n\n        def get_G(L):\n            while len(G) <= L:\n                prev = G[-1]\n                cur: Dict[Tuple[int, int], int] = {}\n                for (s, p), c in prev.items():\n                    for d in range(10):\n                        key = (s + d, p * d)\n                        cur[key] = cur.get(key, 0) + c\n                G.append(cur)\n            return G[L]\n\n        def count_upto(N: int) -> int:\n            if N <= 0:\n                return 0\n            digits = [int(ch) for ch in str(N)]\n            m = len(digits)\n            total = 0\n            # numbers with fewer digits than N\n            for L in range(1, m):\n                dist = get_G(L - 1)\n                for x in range(1, 10):\n                    for (s, p), c in dist.items():\n                        ts = s + x\n                        tp = p * x\n                        if tp % ts == 0:\n                            total += c\n            # numbers with exactly m digits, <= N\n            pre_s, pre_p = 0, 1\n            for i in range(m):\n                di = digits[i]\n                rem = m - i - 1\n                dist = get_G(rem)\n                start = 1 if i == 0 else 0\n                for x in range(start, di):\n                    bs = pre_s + x\n                    bp = pre_p * x\n                    for (s, p), c in dist.items():\n                        ts = bs + s\n                        tp = bp * p\n                        if tp % ts == 0:\n                            total += c\n                pre_s += di\n                pre_p *= di\n            if pre_p % pre_s == 0:\n                total += 1\n            return total\n\n        return count_upto(r) - count_upto(l - 1)\n"}

