u]] = d\n        pr = [0] * n\n        run = 0\n        for x in range(n):\n            run = max(run, maxR[x])\n            pr[x] = run\n        sl = [0] * (n + 1)\n        run = 0\n        for x in range(n - 1, -1, -1):\n            run = max(run, maxL[x])\n            sl[x] = run\n\n        res = [0] * n\n        for i, w in enumerate(words):\n            # deepest node on the word's path with cnt >= k+1 (remains good after removal)\n            a = 0\n            u = 0\n            for ch in w:\n                u = children[u][ch]\n                if cnt[u] >= k + 1:\n                    a = dep[u]\n            p = pos[i]\n            M = 0\n            if p >= 1:\n                M = max(M, pr[p - 1])\n            if p + 1 < n:\n                M = max(M, sl[p + 1])\n            res[i] = max(a, M)\n        return res\n"}

