TOOL submit_solution {"ticket_id": "T-6630", "code": "import heapq\nfrom typing import List\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        n = len(nums1)\n        order = sorted(range(n), key=lambda i: nums1[i])\n        ans = [0] * n\n        heap = []   # min-heap holding the k largest nums2 values seen so far\n        total = 0\n        p = 0\n        while p < n:\n            q = p\n            # Group of indices sharing the same nums1 value\n            while q < n and nums1[order[q]] == nums1[order[p]]:\n                q += 1\n            # Answer for this group uses only strictly smaller nums1 values\n            for t in range(p, q):\n                ans[order[t]] = total\n            # Now insert this group's values into the structure\n            for t in range(p, q):\n                v = nums2[order[t]]\n                heapq.heappush(heap, v)\n                total += v\n                if len(heap) > k:\n                    total -= heapq.heappop(heap)\n            p = q\n        return ans\n"}

