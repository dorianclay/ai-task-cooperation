TOOL submit_solution {"ticket_id": "T-1232", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        # Build trie; cnt[v] = number of words passing through node v.\n        children = [{}]\n        depth = [0]\n        cnt = [0]\n        for w in words:\n            cur = 0\n            cnt[0] += 1\n            for ch in w:\n                nxt = children[cur].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children.append({})\n                    depth.append(depth[cur] + 1)\n                    cnt.append(0)\n                    children[cur][ch] = nxt\n                cur = nxt\n                cnt[cur] += 1\n\n        N = len(children)\n        # best[v] = max depth of node in subtree of v with cnt >= k (or -1)\n        best = [-1] * N\n        t1 = [-1] * N   # top-1 best among children\n        t1c = [-1] * N  # child achieving top-1\n        t2 = [-1] * N   # top-2 best among children (distinct child)\n        for v in range(N - 1, -1, -1):\n            own = depth[v] if cnt[v] >= k else -1\n            a1 = -1\n            c1 = -1\n            a2 = -1\n            for c in children[v].values():\n                bc = best[c]\n                if bc > a1:\n                    a2 = a1\n                    a1 = bc\n                    c1 = c\n                elif bc > a2:\n                    a2 = bc\n            best[v] = max(own, a1)\n            t1[v] = a1\n            t1c[v] = c1\n            t2[v] = a2\n\n        res = []\n        for w in words:\n            on = -1   # deepest path node still valid after removal\n            off = -1  # deepest valid node off the removed word's path\n            cur = 0\n            for ch in w:\n                nxt = children[cur][ch]\n                if cnt[cur] >= k + 1:\n                    on = max(on, depth[cur])\n                if t1c[cur] == nxt:\n                    cand = t2[cur]\n                else:\n                    cand = t1[cur]\n                if cand > off:\n                    off = cand\n                cur = nxt\n            # leaf node\n            if cnt[cur] >= k + 1:\n                on = max(on, depth[cur])\n            if t1[cur] > off:\n                off = t1[cur]\n            res.append(max(on, off, 0))\n        return res\n"}

