TOOL submit_solution {"ticket_id": "T-7141", "code": "from typing import List\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        # Within each row, only the largest `limits[i]` values can ever be useful.\n        # Collect those candidates, then take the top k overall. Because each row's\n        # candidates are sorted descending, any top-k selection takes at most\n        # limits[i] items from row i, so the limits are respected.\n        pool = []\n        for row, lim in zip(grid, limits):\n            if lim > 0:\n                pool.extend(sorted(row, reverse=True)[:lim])\n        pool.sort(reverse=True)\n        return sum(pool[:k])\n"}

