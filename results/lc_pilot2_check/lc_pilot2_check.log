TOOL submit_solution {"ticket_id": "Q-3554", "code": "class Solution:\n    def countSubstrings(self, s: str) -> int:\n        # cnt[d][r] = number of substrings ending at current position whose value mod d == r\n        cnt = [None] + [[0] * d for d in range(1, 10)]\n        ans = 0\n        for ch in s:\n            c = ord(ch) - 48\n            for d in range(1, 10):\n                old = cnt[d]\n                new = [0] * d\n                for r in range(d):\n                    v = old[r]\n                    if v:\n                        new[(10 * r + c) % d] += v\n                new[c % d] += 1  # substring starting at this position\n                cnt[d] = new\n            if c != 0:\n                ans += cnt[c][0]\n        return ans\n"}

