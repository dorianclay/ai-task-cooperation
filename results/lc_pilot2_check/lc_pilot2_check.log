For each group value, find the smallest index j with groups[i] % elements[j] == 0. Cache by value, since values are at most 10^5. Precomputing for all values up to 10^5 via the first index per element value (scanning divisors) is efficient enough.
TOOL submit_solution {"ticket_id": "Q-5406", "code": "from typing import List\n\nclass Solution:\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\n        first = {}\n        for j, e in enumerate(elements):\n            if e not in first:\n                first[e] = j\n        cache = {}\n        res = []\n        for g in groups:\n            if g in cache:\n                res.append(cache[g])\n                continue\n            best = -1\n            # iterate divisors of g\n            d = 1\n            while d * d <= g:\n                if g % d == 0:\n                    for cand in (d, g // d):\n                        if cand in first:\n                            idx = first[cand]\n                            if best == -1 or idx < best:\n                                best = idx\n                d += 1\n            cache[g] = best\n            res.append(best)\n        return res\n"}

