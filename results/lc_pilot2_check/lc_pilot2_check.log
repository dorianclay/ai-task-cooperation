TOOL submit_solution {"ticket_id": "Q-2763", "code": "from typing import List\n\nclass Solution:\n    def minTime(self, skill: List[int], mana: List[int]) -> int:\n        # P[i] = sum of skill[0..i-1]; Q[i] = P[i+1]\n        P = [0]\n        for s in skill:\n            P.append(P[-1] + s)\n        P_lo = P[:-1]  # P_i for i in 0..n-1\n        P_hi = P[1:]   # P_{i+1}\n        total = 0\n        for j in range(1, len(mana)):\n            a = mana[j - 1]\n            b = mana[j]\n            gap = max(h * a - l * b for h, l in zip(P_hi, P_lo))\n            total += gap\n        total += P[-1] * mana[-1]\n        return total\n"}

