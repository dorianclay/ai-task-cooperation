TOOL submit_solution {"ticket_id": "Q-3523", "code": "from typing import List\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        # Group indices by value (each list is in increasing index order)\n        groups = {}\n        pos = [0] * n\n        for i, v in enumerate(nums):\n            lst = groups.setdefault(v, [])\n            pos[i] = len(lst)\n            lst.append(i)\n\n        def circ(a, b):\n            d = abs(a - b)\n            return min(d, n - d)\n\n        res = []\n        for q in queries:\n            lst = groups[nums[q]]\n            s = len(lst)\n            if s == 1:\n                res.append(-1)\n                continue\n            k = pos[q]\n            # The nearest same-valued index in circular distance is always\n            # a cyclic neighbor in the sorted list.\n            prev_idx = lst[(k - 1) % s]\n            next_idx = lst[(k + 1) % s]\n            res.append(min(circ(q, prev_idx), circ(q, next_idx)))\n        return res\n"}

