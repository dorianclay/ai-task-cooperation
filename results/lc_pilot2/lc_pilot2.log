Starter code:

class Solution:
    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:


=== MODEL ===
This is a DFS with a sliding window over the root-to-node path. I'll maintain a count map of values on the current path, and a "left boundary" index: the nearest ancestor position such that all values from there to the current node are unique. For each node, the path start is max(current left, last occurrence of its value + 1). I'll use an iterative DFS to avoid recursion limits.
TOOL submit_solution {"ticket_id": "Q-7113", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        # Iterative DFS maintaining the root-to-node path as a stack of\n        # (node, depth, prefix_distance). For each value, track the depth\n        # of its most recent occurrence on the current path.\n        best_len = 0\n        best_nodes = 1\n        # last_depth[val] = depth of latest occurrence of val on current path, or -1\n        last_depth = {}\n        # dist_prefix[d] = distance from root to the node at depth d on current path\n        dist_prefix = [0] * (n + 1)\n        # left[d] = minimal depth index allowed as start of path ending at depth d\n        left = [0] * (n + 1)\n\n        # Stack entries: (node, parent, depth, state) where state 0 = enter, 1 = exit\n        stack = [(0, -1, 0, 0, 0)]  # node, parent, depth, state, edge_weight_from_parent\n        # We'll store the value previously at each depth to restore on exit.\n        saved_prev = [None] * (n + 1)  # previous last_depth for nums at depth d\n        saved_left = [0] * (n + 1)\n        while stack:\n            node, parent, depth, state, _ = stack.pop()\n            if state == 0:\n                # enter node at depth 'depth' (root depth 0)\n                val = nums[node]\n                prev_occ = last_depth.get(val, -1)\n                saved_prev[depth] = prev_occ\n                saved_left[depth] = left[depth - 1] if depth > 0 else 0\n                # path start must be after previous occurrence of val\n                cur_left = max(saved_left[depth], prev_occ + 1)\n                left[depth] = cur_left\n                last_depth[val] = depth\n                if depth == 0:\n                    dist_prefix[0] = 0\n                # distance from start of path (at depth cur_left) to this node\n                dist = dist_prefix[depth] - dist_prefix[cur_left]\n                nodes = depth - cur_left + 1\n                if dist > best_len:\n                    best_len = dist\n                    best_nodes = nodes\n                elif dist == best_len and nodes < best_nodes:\n                    best_nodes = nodes\n                # schedule exit, then children\n                stack.append((node, parent, depth, 1, 0))\n                for child, w in adj[node]:\n                    if child != parent:\n                        dist_prefix[depth + 1] = dist_prefix[depth] + w\n                        stack.append((child, node, depth + 1, 0, w))\n            else:\n                # exit: restore last_depth for this node's value\n                val = nums[node]\n                if saved_prev[depth] == -1:\n                    del last_depth[val]\n                else:\n                    last_depth[val] = saved_prev[depth]\n        # Zero-length path (single node) has 1 node; handled via dist=0 case above\n        if best_len == 0:\n            return [0, 1]\n        return [best_len, best_nodes]\n"}

