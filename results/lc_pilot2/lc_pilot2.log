TOOL submit_solution {"ticket_id": "T-2863", "code": "from typing import List\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int) -> int:\n        # Choosing shift x = k - v turns every v inside the subarray into k.\n        # Result for value v: totalK - (k's inside) + (v's inside).\n        # Maximize over subarrays via Kadane on +1 for v, -1 for k, 0 otherwise.\n        # Empty subarray gives totalK (x = 0 case covered too).\n        total_k = sum(1 for x in nums if x == k)\n        best = total_k\n        for v in set(nums):\n            if v == k:\n                continue\n            cur = 0\n            run_best = 0\n            for x in nums:\n                if x == v:\n                    delta = 1\n                elif x == k:\n                    delta = -1\n                else:\n                    delta = 0\n                cur = max(delta, cur + delta)\n                if cur > run_best:\n                    run_best = cur\n            if total_k + run_best > best:\n                best = total_k + run_best\n        return best\n"}

