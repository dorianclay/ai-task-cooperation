TOOL submit_solution {"ticket_id": "Q-7113", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n        last = {}\n        saved = [-1] * n\n        pathDist = [0] * (n + 1)\n        best_len = -1\n        best_cnt = 0\n        stack = [(0, -1, 0, 0, 0, False)]\n        while stack:\n            v, par, d, dist, Lp, is_exit = stack.pop()\n            if is_exit:\n                last[nums[v]] = saved[v]\n                continue\n            sv = last.get(nums[v], -1)\n            saved[v] = sv\n            last[nums[v]] = d\n            pathDist[d] = dist\n            Lv = max(Lp, sv + 1)\n            length = dist - pathDist[Lv]\n            cnt = d - Lv + 1\n            if length > best_len or (length == best_len and cnt < best_cnt):\n                best_len = length\n                best_cnt = cnt\n            stack.append((v, par, d, dist, Lp, True))\n            for u, w in adj[v]:\n                if u != par:\n                    stack.append((u, v, d + 1, dist + w, Lv, False))\n        return [best_len, best_cnt]\n"}

