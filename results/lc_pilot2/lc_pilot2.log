TOOL submit_solution {"ticket_id": "T-1232", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        n = len(words)\n        # Build trie\n        children = [dict()]\n        cnt = [0]\n        depth = [0]\n        parent_end = []\n        end_node = [0] * n\n        for idx, w in enumerate(words):\n            cur = 0\n            cnt[0] += 1\n            for ch in w:\n                nxt = children[cur].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children[cur][ch] = nxt\n                    children.append(dict())\n                    cnt.append(0)\n                    depth.append(depth[cur] + 1)\n                cur = nxt\n                cnt[cur] += 1\n            end_node[idx] = cur\n\n        total = len(children)\n        # Euler tour (preorder tin, tout) iteratively\n        tin = [0] * total\n        tout = [0] * total\n        timer = 0\n        stack = [(0, False)]\n        while stack:\n            v, done = stack.pop()\n            if done:\n                tout[v] = timer\n                continue\n            tin[v] = timer\n            timer += 1\n            stack.append((v, True))\n            for c in children[v].values():\n                stack.append((c, False))\n\n        # Nodes with cnt >= k+1 are valid regardless of removal\n        dV = 0\n        # Nodes with cnt == k are valid only if removed word is outside subtree\n        W = []\n        for v in range(total):\n            if cnt[v] >= k + 1:\n                if depth[v] > dV:\n                    dV = depth[v]\n            elif cnt[v] == k:\n                W.append(v)\n        W.sort(key=lambda v: -depth[v])\n\n        res = [0] * n\n        if n - 1 < k:\n            return res\n        for i in range(n):\n            e = end_node[i]\n            ans = dV\n            t = tin[e]\n            for w in W:\n                # w contains word i iff e lies in subtree of w\n                if tin[w] <= t < tout[w]:\n                    continue\n                if depth[w] > ans:\n                    ans = depth[w]\n                break\n            res[i] = ans\n        return res\n"}

