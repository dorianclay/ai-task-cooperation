Starter code:

class Solution:
    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:


=== MODEL ===
This is the "maximum subarrays after removing one conflicting pair" problem. The approach: normalize pairs as (min, max), group by the larger endpoint. For each right endpoint r, track the two largest left endpoints among pairs ending at ≤ r (the best and second-best left bounds). Count valid subarrays with the standard sweep, and for each removal candidate compute the gain from unblocking the pairs that constrain the best left bound. Let me write it.
TOOL submit_solution {"ticket_id": "Q-6123", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # For each right endpoint r, we track the largest left endpoint `best1[r]`\n        # among conflicts (a, b) with max(a,b) == r, and second largest `best2[r]`.\n        # Valid subarrays ending at r: r - (max left endpoint among conflicts with right <= r).\n        # Removing a pair can change the bound only for the r where that pair is the top.\n        best1 = [0] * (n + 1)  # largest left endpoint for right endpoint r\n        best2 = [0] * (n + 1)  # second largest\n        # Group pairs by right endpoint\n        for a, b in conflictingPairs:\n            lo, hi = min(a, b), max(a, b)\n            if lo > best1[hi]:\n                best2[hi] = best1[hi]\n                best1[hi] = lo\n            elif lo > best2[hi]:\n                best2[hi] = lo\n\n        total = 0\n        # Current max left endpoint (bound) and second max among all conflicts with right <= r\n        m1 = 0  # largest left among all pairs so far\n        m1_src = 0  # right endpoint that produced m1\n        m2 = 0  # second largest left overall (from a different pair)\n        gain = [0] * (n + 2)  # gain[x]: extra subarrays if the pair giving bound x is removed\n        for r in range(1, n + 1):\n            # Update running top-two lefts across all pairs with right <= r\n            cand1 = best1[r]\n            cand2 = best2[r]\n            if cand1 > m1:\n                # new top from this r\n                if m1_src != r:\n                    m2 = max(m1, m2)\n                else:\n                    m2 = max(m2, cand2)\n                m1 = cand1\n                m1_src = r\n                m2 = max(m2, cand2)\n            else:\n                m2 = max(m2, cand1)\n            # Bound for subarrays ending at r: m1 (left endpoints must be > m1)\n            total += r - m1\n            # If we remove the pair that defines m1, the bound becomes m2\n            gain[m1] += m1 - m2 if m1 > 0 else 0\n            # Note: gain is accumulated per bound value; it stays valid because\n            # the bound stays m1 for the r range with that same m1 and source.\n\n        base = total\n        # Recompute properly: the gain for removing a pair with left bound x applies\n        # to all r where the effective bound was that pair's left endpoint.\n        # Simplest correct approach: second pass tracking the effective bound.\n        best_gain = 0\n        # Recompute gain per removed-candidate directly\n        bound_gain = [0] * (n + 2)\n        m1 = 0\n        m2 = 0\n        for r in range(1, n + 1):\n            cand1 = best1[r]\n            cand2 = best2[r]\n            if cand1 > m1:\n                m2 = max(m1, cand2)\n                m1 = cand1\n            else:\n                m2 = max(m2, cand1)\n            # When the top pair is removed, the bound falls to m2 for this r\n            bound_gain[m1] += 0\n        # Gain per removal: for each r with bound m1 (>0), removing the top pair\n        # yields r - m2 instead of r - m1. Accumulate by the top value.\n        acc = {}\n        m1 = 0\n        m2 = 0\n        for r in range(1, n + 1):\n            cand1 = best1[r]\n            cand2 = best2[r]\n            if cand1 > m1:\n                m2 = max(m1, cand2)\n                m1 = cand1\n            else:\n                m2 = max(m2, cand1)\n            if m1 > 0:\n                acc[m1] = acc.get(m1, 0) + (m1 - m2)\n        for x, g in acc.items():\n            best_gain = max(best_gain, g)\n        return base + best_gain\n"}

