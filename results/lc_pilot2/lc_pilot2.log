TOOL submit_solution {"ticket_id": "T-3577", "code": "from typing import List\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        # copy[i] = original[i] + d for a single shift d = copy[0] - original[0].\n        # Each index i constrains d to [u_i - original[i], v_i - original[i]].\n        lo = float('-inf')\n        hi = float('inf')\n        for o, (u, v) in zip(original, bounds):\n            lo = max(lo, u - o)\n            hi = min(hi, v - o)\n        if hi < lo:\n            return 0\n        return int(hi - lo + 1)\n"}

