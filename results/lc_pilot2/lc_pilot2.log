TOOL submit_solution {"ticket_id": "Q-6123", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        by_hi = [[] for _ in range(n + 1)]\n        for i, (a, b) in enumerate(conflictingPairs):\n            lo, hi = min(a, b), max(a, b)\n            by_hi[hi].append((lo, i))\n        extra = [0] * len(conflictingPairs)\n        best1, best2, idx = 0, 0, -1\n        base = 0\n        for r in range(1, n + 1):\n            for lo, i in by_hi[r]:\n                if lo > best1:\n                    best2 = best1\n                    best1 = lo\n                    idx = i\n                elif lo >= best1:\n                    best2 = lo\n                elif lo > best2:\n                    best2 = lo\n            base += r - best1\n            if idx >= 0:\n                extra[idx] += best1 - best2\n        return base + max(extra)\n"}

