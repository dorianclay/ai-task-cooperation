TOOL submit_solution {"ticket_id": "Q-6123", "code": "class Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        by_right = [[] for _ in range(n + 1)]\n        for x, y in conflictingPairs:\n            a, b = min(x, y), max(x, y)\n            by_right[b].append(a)\n\n        best1 = 0  # largest left endpoint among pairs with right <= r\n        best2 = 0  # second largest (distinct pair) left endpoint\n        total = 0\n        gain = [0] * (n + 2)\n\n        for r in range(1, n + 1):\n            for a in by_right[r]:\n                if a > best1:\n                    best2 = best1\n                    best1 = a\n                elif a > best2:\n                    best2 = a\n            total += r - best1\n            # Removing the pair that owns best1 raises the bound to best2\n            gain[best1] += best1 - best2 if best1 > 0 else 0\n\n        extra = max(gain) if conflictingPairs else 0\n        return total + extra\n"}

