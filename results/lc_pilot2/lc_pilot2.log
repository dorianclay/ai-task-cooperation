TOOL submit_solution {"ticket_id": "Q-1232", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        n = len(words)\n        if n - 1 < k:\n            return [0] * n\n        children = [{}]\n        cnt = [0]\n        depth = [0]\n        paths = []\n        for w in words:\n            cur = 0\n            cnt[0] += 1\n            path = [0]\n            for ch in w:\n                nxt = children[cur].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children.append({})\n                    cnt.append(0)\n                    depth.append(depth[cur] + 1)\n                    children[cur][ch] = nxt\n                cur = nxt\n                cnt[cur] += 1\n                path.append(cur)\n            paths.append(path)\n        m = len(children)\n        # sub[v]: max depth of a node in subtree of v having cnt >= k (or -1)\n        sub = [-1] * m\n        for v in range(m - 1, -1, -1):\n            if cnt[v] >= k:\n                best = depth[v]\n                for c in children[v].values():\n                    if sub[c] > best:\n                        best = sub[c]\n                sub[v] = best\n        res = []\n        for path in paths:\n            # deepest node on the path that stays >= k after removal\n            A = 0\n            for v in path:\n                if cnt[v] >= k + 1 and depth[v] > A:\n                    A = depth[v]\n            # deepest node off the path with cnt >= k\n            B = 0\n            L = len(path)\n            for d in range(L):\n                p = path[d]\n                nxt = path[d + 1] if d + 1 < L else -1\n                for c in children[p].values():\n                    if c != nxt and sub[c] > B:\n                        B = sub[c]\n            res.append(max(A, B))\n        return res\n"}

