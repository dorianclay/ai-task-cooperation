TOOL submit_solution {"ticket_id": "Q-3523", "code": "from typing import List\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        groups = {}\n        where = [0] * n\n        for i, v in enumerate(nums):\n            lst = groups.setdefault(v, [])\n            where[i] = len(lst)\n            lst.append(i)\n\n        def circ(a, b):\n            d = abs(a - b)\n            return min(d, n - d)\n\n        answer = []\n        for q in queries:\n            lst = groups[nums[q]]\n            L = len(lst)\n            if L == 1:\n                answer.append(-1)\n                continue\n            p = where[q]\n            nxt = lst[(p + 1) % L]\n            prv = lst[(p - 1) % L]\n            answer.append(min(circ(q, nxt), circ(q, prv)))\n        return answer\n"}

