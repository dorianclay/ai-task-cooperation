TOOL submit_solution {"ticket_id": "Q-8490", "code": "from typing import List\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        m, n = len(coins), len(coins[0])\n        NEG = float('-inf')\n        # dp[i][j][k] = max profit reaching (i,j) having used k neutralizations\n        prev = None\n        for i in range(m):\n            cur = [[[NEG] * 3 for _ in range(n)] for _ in range(1)][0]\n            for j in range(n):\n                c = coins[i][j]\n                for k in range(3):\n                    best = NEG\n                    if i == 0 and j == 0:\n                        if k == 0:\n                            best = c\n                        elif c < 0:\n                            # neutralize this cell with k=1 or 2 used\n                            best = 0 if k >= 1 else NEG\n                        else:\n                            best = NEG\n                        cur[j][k] = best\n                        continue\n                    # from top\n                    cands = []\n                    if prev is not None:\n                        cands.append(prev[j][k])\n                    # from left\n                    if j > 0:\n                        cands.append(cur[j - 1][k])\n                    base = max(cands) if cands else NEG\n                    if base != NEG:\n                        best = base + c\n                    # neutralize this robber cell using one more use\n                    if c < 0 and k >= 1:\n                        cands2 = []\n                        if prev is not None:\n                            cands2.append(prev[j][k - 1])\n                        if j > 0:\n                            cands2.append(cur[j - 1][k - 1])\n                        b2 = max(cands2) if cands2 else NEG\n                        if b2 != NEG:\n                            best = max(best, b2)\n                    cur[j][k] = best\n            prev = cur\n        return int(max(prev[n - 1]))\n"}

