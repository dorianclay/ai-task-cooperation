TOOL submit_solution {"ticket_id": "Q-8397", "code": "class Solution:\n    def generateString(self, str1: str, str2: str) -> str:\n        n, m = len(str1), len(str2)\n        L = n + m - 1\n        forced = [None] * L\n        # Apply T constraints, checking for conflicts\n        for i, c in enumerate(str1):\n            if c == 'T':\n                for k in range(m):\n                    pos = i + k\n                    if forced[pos] is None:\n                        forced[pos] = str2[k]\n                    elif forced[pos] != str2[k]:\n                        return \"\"\n        # Start with smallest fill for free positions\n        word = [forced[p] if forced[p] is not None else 'a' for p in range(L)]\n        # Fix F constraints: break any window equal to str2 using a free position\n        for i, c in enumerate(str1):\n            if c != 'F':\n                continue\n            if ''.join(word[i:i + m]) != str2:\n                continue\n            # find rightmost free position in window\n            j = None\n            for p in range(i + m - 1, i - 1, -1):\n                if forced[p] is None:\n                    j = p\n                    break\n            if j is None:\n                return \"\"\n            # word[j] currently equals str2[j - i]; change to smallest different char\n            word[j] = 'a' if str2[j - i] != 'a' else 'b'\n        result = ''.join(word)\n        # Verify all constraints\n        for i, c in enumerate(str1):\n            sub = result[i:i + m]\n            if c == 'T' and sub != str2:\n                return \"\"\n            if c == 'F' and sub == str2:\n                return \"\"\n        return result\n"}

