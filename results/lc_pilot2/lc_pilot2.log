TOOL submit_solution {"ticket_id": "Q-2763", "code": "from typing import List\nfrom itertools import accumulate\n\nclass Solution:\n    def minTime(self, skill: List[int], mana: List[int]) -> int:\n        # P[i] = skill[0] + ... + skill[i]; Q[i] = P[i-1] with Q[0] = 0.\n        P = list(accumulate(skill))\n        Q = [0] + P[:-1]\n        T = 0  # start time of the current potion, relative to potion 0 starting at 0\n        for j in range(1, len(mana)):\n            a = mana[j - 1]\n            b = mana[j]\n            # Minimal gap so that no wizard is still busy with the previous potion\n            # when it needs to start the current one.\n            gap = max(a * x - b * y for x, y in zip(P, Q))\n            T += gap\n        # The last potion finishes when the last wizard completes it.\n        return T + mana[-1] * P[-1]\n"}

