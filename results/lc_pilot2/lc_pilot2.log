TOOL submit_solution {"ticket_id": "Q-8490", "code": "from typing import List\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        NEG = float('-inf')\n        m, n = len(coins), len(coins[0])\n\n        def enter(prev, v):\n            # prev: list of 3 values indexed by neutralizations used so far\n            cur = [NEG, NEG, NEG]\n            for c in range(3):\n                p = prev[c]\n                if p == NEG:\n                    continue\n                if v >= 0:\n                    if p + v > cur[c]:\n                        cur[c] = p + v\n                else:\n                    # pay the robber\n                    if p + v > cur[c]:\n                        cur[c] = p + v\n                    # neutralize\n                    if c < 2 and p > cur[c + 1]:\n                        cur[c + 1] = p\n            return cur\n\n        prev_row = None\n        for i in range(m):\n            row = [None] * n\n            for j in range(n):\n                if i == 0 and j == 0:\n                    base = [0, NEG, NEG]\n                    row[j] = enter(base, coins[0][0])\n                    continue\n                cands = []\n                if i > 0:\n                    cands.append(prev_row[j])\n                if j > 0:\n                    cands.append(row[j - 1])\n                prev = [NEG, NEG, NEG]\n                for s in cands:\n                    for c in range(3):\n                        if s[c] > prev[c]:\n                            prev[c] = s[c]\n                row[j] = enter(prev, coins[i][j])\n            prev_row = row\n        return int(max(prev_row[n - 1]))\n"}

