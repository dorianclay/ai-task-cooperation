TOOL submit_solution {"ticket_id": "Q-3523", "code": "from typing import List\nfrom collections import defaultdict\nfrom bisect import bisect_left\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        pos = defaultdict(list)\n        for i, v in enumerate(nums):\n            pos[v].append(i)\n\n        def circ(a, b):\n            d = abs(a - b)\n            return min(d, n - d)\n\n        res = []\n        for q in queries:\n            lst = pos[nums[q]]\n            L = len(lst)\n            if L == 1:\n                res.append(-1)\n                continue\n            idx = bisect_left(lst, q)\n            p = lst[(idx - 1) % L]\n            nx = lst[(idx + 1) % L]\n            res.append(min(circ(q, p), circ(q, nx)))\n        return res\n"}

