class Solution:
    def beautifulNumbers(self, l: int, r: int) -> int:


=== MODEL ===
This needs a digit DP. State: position, tight flag, started flag, digit sum (max 81), digit product (products of digits 0–9 are of form 2^a 3^b 5^c 7^d, but I can track it directly with a memo keyed by product — the set of reachable products is small). I'll count numbers ≤ X that are beautiful, then answer count(r) − count(l−1).
TOOL submit_solution {"ticket_id": "Q-6001", "code": "from functools import lru_cache\n\nclass Solution:\n    def beautifulNumbers(self, l: int, r: int) -> int:\n        def count_upto(x: int) -> int:\n            # count beautiful numbers in [1, x]\n            if x <= 0:\n                return 0\n            digits = list(map(int, str(x)))\n            n = len(digits)\n\n            @lru_cache(maxsize=None)\n            def dp(pos, tight, started, dsum, prod):\n                if pos == n:\n                    if not started:\n                        return 0\n                    return 1 if dsum > 0 and prod % dsum == 0 else 0\n                limit = digits[pos] if tight else 9\n                total = 0\n                for d in range(0, limit + 1):\n                    nt = tight and d == limit\n                    if not started and d == 0:\n                        total += dp(pos + 1, nt, False, 0, 1)\n                    else:\n                        total += dp(pos + 1, nt, True, dsum + d, prod * d)\n                return total\n\n            res = dp(0, True, False, 0, 1)\n            dp.cache_clear()\n            return res\n\n        return count_upto(r) - count_upto(l - 1)\n"}

