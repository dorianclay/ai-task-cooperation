TOOL submit_solution {"ticket_id": "Q-3577", "code": "from typing import List\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        lo = -10**18\n        hi = 10**18\n        for o, (u, v) in zip(original, bounds):\n            # copy[i] = o + d, need u <= o + d <= v\n            lo = max(lo, u - o)\n            hi = min(hi, v - o)\n            if lo > hi:\n                return 0\n        return hi - lo + 1\n"}

