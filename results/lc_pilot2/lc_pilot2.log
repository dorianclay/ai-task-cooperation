class Solution:
    def minTime(self, skill: List[int], mana: List[int]) -> int:


=== MODEL ===
This is the classic potions problem: between consecutive potions, the start offset of potion j+1 relative to j is max over wizards of (prefix_skill[i] * mana[j] - prefix_skill[i-1] * mana[j+1]) plus the total work, so the final answer is the sum of per-transition gaps plus the last potion's total time. I'll compute the gap for each consecutive pair as the max over i of (S[i]·mana[j] − S[i−1]·mana[j+1]) where S is the prefix sum of skill (with S[−1]=0), and take the total as sum(gaps) + mana[-1]·S[n−1].
TOOL submit_solution {"ticket_id": "Q-2763", "code": "from typing import List\n\nclass Solution:\n    def minTime(self, skill: List[int], mana: List[int]) -> int:\n        n, m = len(skill), len(mana)\n        # prefix sums of skill: P[i] = skill[0]+...+skill[i-1], P[0]=0\n        P = [0] * (n + 1)\n        for i in range(n):\n            P[i + 1] = P[i] + skill[i]\n        total = 0\n        for j in range(m - 1):\n            a, b = mana[j], mana[j + 1]\n            # offset start of potion j+1 relative to j must satisfy for all wizards:\n            # start_{j+1} >= start_j + P[i+1]*a - P[i]*b  for every i\n            gap = max(P[i + 1] * a - P[i] * b for i in range(n))\n            total += gap\n        total += mana[-1] * P[n]\n        return total\n"}

