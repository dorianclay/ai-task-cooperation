TOOL submit_solution {"ticket_id": "Q-5583", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # State key: (parity of count so far, alternating sum, nonempty flag)\n        # Value: set of achievable products, where -1 means \"exceeds limit\"\n        # (kept because a later 0 can bring the product back to 0).\n        OVER = -1\n        dp = {(0, 0, False): {1}}\n\n        def mul(products, x):\n            res = set()\n            if x == 0:\n                if products:\n                    res.add(0)\n                return res\n            for p in products:\n                if p == OVER or p == 0:\n                    res.add(p if p == 0 else OVER)\n                else:\n                    q = p * x\n                    res.add(q if q <= limit else OVER)\n            return res\n\n        for x in nums:\n            new_dp = {key: set(val) for key, val in dp.items()}\n            for (par, s, _), prods in dp.items():\n                if par == 0:\n                    nkey = (1, s + x, True)\n                else:\n                    nkey = (0, s - x, True)\n                newp = mul(prods, x)\n                if not newp:\n                    continue\n                if nkey in new_dp:\n                    new_dp[nkey] |= newp\n                else:\n                    new_dp[nkey] = newp\n            dp = new_dp\n\n        best = -1\n        for (par, s, nonempty), prods in dp.items():\n            if not nonempty or s != k:\n                continue\n            for p in prods:\n                if p != OVER and p <= limit and p > best:\n                    best = p\n        return best\n"}

