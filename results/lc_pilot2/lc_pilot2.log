TOOL submit_solution {"ticket_id": "T-5406", "code": "from typing import List\n\nclass Solution:\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\n        if not groups:\n            return []\n        limit = max(groups)\n        # best[v] = smallest index j such that elements[j] divides v, or -1\n        best = [-1] * (limit + 1)\n        seen = set()\n        for j, e in enumerate(elements):\n            if e > limit or e in seen:\n                # e > limit cannot divide any group; duplicates keep the earlier index\n                if e not in seen:\n                    seen.add(e)\n                continue\n            seen.add(e)\n            for m in range(e, limit + 1, e):\n                if best[m] == -1:\n                    best[m] = j\n        return [best[g] for g in groups]\n"}

