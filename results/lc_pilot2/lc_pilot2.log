TOOL submit_solution {"ticket_id": "T-6630", "code": "import heapq\nfrom typing import List\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        n = len(nums1)\n        order = sorted(range(n), key=lambda i: nums1[i])\n        ans = [0] * n\n        heap = []  # min-heap holding the largest up to k nums2 values seen so far\n        cur = 0\n        i = 0\n        while i < n:\n            j = i\n            # Process all indices with the same nums1 value together:\n            # they must not count toward each other (strictly less required).\n            while j < n and nums1[order[j]] == nums1[order[i]]:\n                ans[order[j]] = cur\n                j += 1\n            for t in range(i, j):\n                idx = order[t]\n                v = nums2[idx]\n                heapq.heappush(heap, v)\n                cur += v\n                if len(heap) > k:\n                    cur -= heapq.heappop(heap)\n            i = j\n        return ans\n"}

