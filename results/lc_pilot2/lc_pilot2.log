TOOL submit_solution {"ticket_id": "Q-2763", "code": "from typing import List\n\nclass Solution:\n    def minTime(self, skill: List[int], mana: List[int]) -> int:\n        n = len(skill)\n        m = len(mana)\n        # prefix sums of skill\n        S = [0] * (n + 1)\n        for i in range(n):\n            S[i + 1] = S[i] + skill[i]\n        # finish[i] = time wizard i finishes previous potion (absolute)\n        # Start time of potion 0 is 0; wizard i finishes potion 0 at S[i+1]*mana[0].\n        finish = [S[i + 1] * mana[0] for i in range(n)]\n        start = 0\n        for j in range(1, m):\n            # potion j starts at t such that for each wizard i:\n            # t + S[i]*mana[j] >= finish[i]  (wizard i free when potion j arrives)\n            t = max(finish[i] - S[i] * mana[j] for i in range(n))\n            start = max(start, t)\n            finish = [start + S[i + 1] * mana[j] for i in range(n)]\n        return finish[n - 1]\n"}

