TOOL submit_solution {"ticket_id": "Q-5409", "code": "from typing import List\n\nclass Solution:\n    def sortMatrix(self, grid: List[List[int]]) -> List[List[int]]:\n        n = len(grid)\n        # Diagonals starting at (i, 0) for each row i, and (0, j) for each column j >= 1.\n        starts = [(i, 0) for i in range(n)] + [(0, j) for j in range(1, n)]\n        for si, sj in starts:\n            cells = []\n            i, j = si, sj\n            while i < n and j < n:\n                cells.append((i, j))\n                i += 1\n                j += 1\n            vals = [grid[r][c] for r, c in cells]\n            if si >= sj:\n                # bottom-left triangle including main diagonal: non-increasing\n                vals.sort(reverse=True)\n            else:\n                # top-right triangle: non-decreasing\n                vals.sort()\n            for (r, c), v in zip(cells, vals):\n                grid[r][c] = v\n        return grid\n"}

