TOOL submit_solution {"ticket_id": "Q-8840", "code": "from typing import List\n\nclass Solution:\n    def countMentions(self, numberOfUsers: int, events: List[List[str]]) -> List[int]:\n        mentions = [0] * numberOfUsers\n        online_at = [0] * numberOfUsers\n        # OFFLINE (type 0) before MESSAGE (type 1) at same timestamp\n        ordered = sorted(\n            events,\n            key=lambda e: (int(e[1]), 0 if e[0] == \"OFFLINE\" else 1)\n        )\n        for e in ordered:\n            t = int(e[1])\n            if e[0] == \"OFFLINE\":\n                uid = int(e[2])\n                online_at[uid] = t + 60\n            else:\n                s = e[2]\n                if s == \"ALL\":\n                    for i in range(numberOfUsers):\n                        mentions[i] += 1\n                elif s == \"HERE\":\n                    for i in range(numberOfUsers):\n                        if online_at[i] <= t:\n                            mentions[i] += 1\n                else:\n                    for tok in s.split():\n                        if tok.startswith(\"id\"):\n                            mentions[int(tok[2:])] += 1\n        return mentions\n"}

