TOOL submit_solution {"ticket_id": "Q-5002", "code": "from collections import Counter\n\nclass Solution:\n    def maxDifference(self, s: str) -> int:\n        freq = Counter(s).values()\n        max_odd = max(f for f in freq if f % 2 == 1)\n        min_even = min(f for f in freq if f % 2 == 0)\n        return max_odd - min_even\n"}

