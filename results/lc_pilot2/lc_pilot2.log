TOOL submit_solution {"ticket_id": "T-7113", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        D = [0] * n                 # distance from root\n        savedL = [0] * n\n        savedLast = [-1] * n\n        last = {}                   # value -> index on current root path\n        path_D = []                 # distances of nodes on current path, by index\n        L = 0                       # earliest allowed start index on the path\n        best_len, best_nodes = 0, 1 # single-node paths always valid\n\n        stack = [(0, -1, True)]\n        while stack:\n            v, p, enter = stack.pop()\n            if enter:\n                cur = len(path_D)\n                path_D.append(D[v])\n                val = nums[v]\n                savedL[v] = L\n                savedLast[v] = last.get(val, -1)\n                if savedLast[v] + 1 > L:\n                    L = savedLast[v] + 1\n                last[val] = cur\n                length = D[v] - path_D[L]\n                nodes = cur - L + 1\n                if length > best_len:\n                    best_len, best_nodes = length, nodes\n                elif length == best_len and nodes < best_nodes:\n                    best_nodes = nodes\n                stack.append((v, p, False))\n                for u, w in adj[v]:\n                    if u != p:\n                        D[u] = D[v] + w\n                        stack.append((u, v, True))\n            else:\n                path_D.pop()\n                val = nums[v]\n                if savedLast[v] == -1:\n                    del last[val]\n                else:\n                    last[val] = savedLast[v]\n                L = savedL[v]\n\n        return [best_len, best_nodes]\n"}

