TOOL submit_solution {"ticket_id": "Q-7649", "code": "class Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        i1 = p.index('*')\n        i2 = p.index('*', i1 + 1)\n        A = p[:i1]\n        B = p[i1 + 1:i2]\n        C = p[i2 + 1:]\n\n        def occurrences(pat):\n            # returns sorted list of start indices where pat occurs in s\n            if pat == \"\":\n                return list(range(len(s) + 1))\n            res = []\n            # KMP prefix function\n            m = len(pat)\n            pi = [0] * m\n            k = 0\n            for q in range(1, m):\n                while k and pat[q] != pat[k]:\n                    k = pi[k - 1]\n                if pat[q] == pat[k]:\n                    k += 1\n                pi[q] = k\n            k = 0\n            for idx, ch in enumerate(s):\n                while k and ch != pat[k]:\n                    k = pi[k - 1]\n                if ch == pat[k]:\n                    k += 1\n                if k == m:\n                    res.append(idx - m + 1)\n                    k = pi[k - 1]\n            return res\n\n        occA = occurrences(A)\n        occB = occurrences(B)\n        occC = occurrences(C)\n        lenA, lenB, lenC = len(A), len(B), len(C)\n\n        import bisect\n        best = -1\n        for a in occA:\n            # B must start at >= a + lenA\n            jb = bisect.bisect_left(occB, a + lenA)\n            if jb == len(occB):\n                continue\n            b = occB[jb]\n            # C must start at >= b + lenB\n            jc = bisect.bisect_left(occC, b + lenB)\n            if jc == len(occC):\n                continue\n            c = occC[jc]\n            end = c + lenC\n            length = end - a\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

