TOOL submit_solution {"ticket_id": "Q-2347", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # State: (alternating sum, parity of length so far) -> set of achievable products <= limit,\n        # plus a flag for whether a zero has been included (product becomes 0 and stays 0).\n        # We track products exactly when <= limit; a zero-containing product is 0.\n        # Products exceeding limit can never come back under limit (all factors >= 1 except 0),\n        # so we drop them; zeros are tracked separately as product 0.\n        # state dict: key (alt, sign_parity) where sign_parity = len % 2 ; value: set of products\n        states = {}  # (alt, len_parity) -> set of products (ints in [0, limit])\n        for x in nums:\n            new_states = {}\n            # start a new subsequence with x\n            starts = [(x, 1, x)]  # (alt, len_parity, product)\n            def add(key, prod):\n                new_states.setdefault(key, set()).add(prod)\n            for x_alt, par, prod in starts:\n                if prod <= limit:\n                    add((x_alt, par), prod)\n            for (alt, par), prods in states.items():\n                # keep without x (carry over)\n                new_states.setdefault((alt, par), set()).update(prods)\n                # extend with x\n                if par == 0:\n                    # next element is at odd position? length so far even -> next index even -> plus\n                    nalt = alt + x\n                else:\n                    nalt = alt - x\n                npar = 1 - par\n                for p in prods:\n                    np_ = p * x\n                    if np_ <= limit:\n                        add((nalt, npar), np_)\n                    elif x == 0:\n                        add((nalt, npar), 0)\n            # zero handling: product 0 when x == 0 among extended items is covered above\n            states = new_states\n\n        best = -1\n        for (alt, par), prods in states.items():\n            if alt == k and par in (0, 1):\n                for p in prods:\n                    if p <= limit and p > best:\n                        best = p\n        return best\n"}

