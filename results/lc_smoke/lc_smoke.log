TOOL submit_solution {"ticket_id": "Q-3554", "code": "from typing import List\n\n\nclass Solution:\n    def maxDistance(self, side: int, points: List[List[int]], k: int) -> int:\n        P = 4 * side\n\n        def perim(x, y):\n            if y == 0:\n                t = x\n            elif x == side:\n                t = side + y\n            elif y == side:\n                t = 2 * side + (side - x)\n            else:\n                t = 3 * side + (side - y)\n            return t % P\n\n        pts = sorted({(x, y) for x, y in points}, key=lambda p: perim(p[0], p[1]))\n        n = len(pts)\n\n        def dist(a, b):\n            return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n        def feasible(d):\n            if d == 0:\n                return True\n            for s in range(n):\n                start = pts[s]\n                last = start\n                cnt = 1\n                for step in range(1, n):\n                    j = (s + step) % n\n                    q = pts[j]\n                    if dist(q, start) >= d and dist(q, last) >= d:\n                        last = q\n                        cnt += 1\n                        if cnt >= k:\n                            return True\n            return False\n\n        lo, hi = 0, 2 * side\n        while lo < hi:\n            mid = (lo + hi + 1) // 2\n            if feasible(mid):\n                lo = mid\n            else:\n                hi = mid - 1\n        return lo\n"}

