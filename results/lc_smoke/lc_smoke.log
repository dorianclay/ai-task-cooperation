TOOL submit_solution {"ticket_id": "Q-6801", "code": "from collections import defaultdict\n\n\nclass Solution:\n    def countSubstrings(self, s: str) -> int:\n        n = len(s)\n        dig = [int(c) for c in s]\n        total = 0\n\n        # Divisible by last digit 1, 2, 5: always true for these last digits.\n        for j in range(n):\n            if dig[j] in (1, 2, 5):\n                total += j + 1\n\n        # Divisible by 3, 7, 9 (coprime with 10): prefix trick with inverse of 10.\n        for d in (3, 7, 9):\n            inv = pow(10, -1, d)\n            W = [0] * (n + 1)\n            p = 1\n            for t in range(n):\n                W[t + 1] = (W[t] + dig[t] * p) % d\n                p = p * inv % d\n            cnt = defaultdict(int)\n            for j in range(n):\n                cnt[W[j]] += 1  # prefix indices 0..j\n                if dig[j] == d:\n                    total += cnt[W[j + 1]]\n\n        # Divisible by 6: even (last digit 6) and digit sum divisible by 3.\n        S = [0] * (n + 1)\n        for t in range(n):\n            S[t + 1] = (S[t] + dig[t]) % 3\n        cnt = defaultdict(int)\n        for j in range(n):\n            cnt[S[j]] += 1\n            if dig[j] == 6:\n                total += cnt[S[j + 1]]\n\n        # Divisible by 4 and 8: depends only on last K digits when length >= K.\n        for d, K in ((4, 2), (8, 3)):\n            for j in range(n):\n                if dig[j] != d:\n                    continue\n                for L in range(1, min(K - 1, j + 1) + 1):\n                    if int(s[j - L + 1:j + 1]) % d == 0:\n                        total += 1\n                if j - K + 1 >= 0:\n                    if int(s[j - K + 1:j + 1]) % d == 0:\n                        total += j - K + 2\n\n        return total\n"}

