TOOL submit_solution {"ticket_id": "Q-5583", "code": "from typing import List\n\n\nclass Solution:\n    def minimumCost(self, nums: List[int], cost: List[int], k: int) -> int:\n        n = len(nums)\n        Pp = [0] * (n + 1)\n        Cp = [0] * (n + 1)\n        for i in range(n):\n            Pp[i + 1] = Pp[i] + nums[i]\n            Cp[i + 1] = Cp[i] + cost[i]\n\n        INF = None\n        # g[a] = min cost to split prefix of length a into t-1 segments\n        g = [INF] * (n + 1)\n        g[0] = 0\n        best = INF\n\n        for t in range(1, n + 1):\n            new = [INF] * (n + 1)\n            hull_m = []\n            hull_c = []\n\n            def bad(m1, c1, m2, c2, m3, c3):\n                # slopes m1 > m2 > m3; True if line 2 is never strictly optimal\n                return (c3 - c1) * (m1 - m2) <= (c2 - c1) * (m1 - m3)\n\n            for b in range(1, n + 1):\n                a = b - 1\n                if g[a] is not None:\n                    m = -Cp[a]\n                    c = g[a]\n                    while len(hull_m) >= 2 and bad(hull_m[-2], hull_c[-2],\n                                                   hull_m[-1], hull_c[-1],\n                                                   m, c):\n                        hull_m.pop()\n                        hull_c.pop()\n                    hull_m.append(m)\n                    hull_c.append(c)\n                if not hull_m:\n                    continue\n                x = Pp[b] + k * t\n                lo, hi = 0, len(hull_m) - 1\n                while lo < hi:\n                    mid = (lo + hi) // 2\n                    v1 = hull_m[mid] * x + hull_c[mid]\n                    v2 = hull_m[mid + 1] * x + hull_c[mid + 1]\n                    if v1 >= v2:\n                        lo = mid + 1\n                    else:\n                        hi = mid\n                val = hull_m[lo] * x + hull_c[lo] + x * Cp[b]\n                new[b] = val\n\n            g = new\n            if g[n] is not None:\n