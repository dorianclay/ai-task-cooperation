TOOL submit_solution {"ticket_id": "Q-2347", "code": "from typing import List\nfrom collections import defaultdict\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # state: (parity, alt_sum) -> set of achievable products (<= limit)\n        # parity = number of chosen elements mod 2 (0 => next element is added, 1 => subtracted)\n        dp = defaultdict(set)\n        for x in nums:\n            new_items = []  # (key, prod) additions computed from the old dp\n            # start a new subsequence with x\n            if x == 0 or x <= limit:\n                new_items.append(((1, x), x))\n            for (p, s), prods in dp.items():\n                ns = s + x if p == 0 else s - x\n                key = (1 - p, ns)\n                for pr in prods:\n                    if x == 0 or pr == 0:\n                        np_ = 0\n                    else:\n                        np_ = pr * x\n                        if np_ > limit:\n                            continue\n                    new_items.append((key, np_))\n            for key, np_ in new_items:\n                dp[key].add(np_)\n        best = -1\n        for (p, s), prods in dp.items():\n            if s == k and prods:\n                m = max(prods)\n                if m > best:\n                    best = m\n        return best\n"}

