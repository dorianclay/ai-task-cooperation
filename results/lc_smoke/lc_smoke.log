TOOL submit_solution {"ticket_id": "Q-7649", "code": "from bisect import bisect_left\n\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n        i1 = p.index('*')\n        i2 = p.index('*', i1 + 1)\n        A = p[:i1]\n        B = p[i1 + 1:i2]\n        C = p[i2 + 1:]\n\n        def occurrences(q):\n            # All starting indices (overlapping allowed) where q occurs in s.\n            m = len(q)\n            if m == 0:\n                return list(range(n + 1))\n            # prefix function of q\n            pi = [0] * m\n            k = 0\n            for i in range(1, m):\n                while k > 0 and q[i] != q[k]:\n                    k = pi[k - 1]\n                if q[i] == q[k]:\n                    k += 1\n                pi[i] = k\n            res = []\n            k = 0\n            for i, ch in enumerate(s):\n                while k > 0 and (k == m or ch != q[k]):\n                    k = pi[k - 1]\n                if ch == q[k]:\n                    k += 1\n                if k == m:\n                    res.append(i - m + 1)\n            return res\n\n        occA = occurrences(A)\n        occB = occurrences(B)\n        occC = occurrences(C)\n        if not occA or not occB or not occC:\n            return -1\n\n        lenA, lenB, lenC = len(A), len(B), len(C)\n        best = -1\n        for a in occA:\n            pb = bisect_left(occB, a + lenA)\n            if pb == len(occB):\n                continue\n            j = occB[pb]\n            pc = bisect_left(occC, j + lenB)\n            if pc == len(occC):\n                continue\n            k = occC[pc]\n            length = k + lenC - a\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

