TOOL submit_solution {"ticket_id": "Q-2469", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        m = len(conflictingPairs)\n        buckets = [[] for _ in range(n + 1)]\n        for idx, (x, y) in enumerate(conflictingPairs):\n            a, b = min(x, y), max(x, y)\n            buckets[b].append((a, idx))\n        gain = [0] * m\n        base = 0\n        top1v, top1i, top2v = 0, -1, 0\n        for r in range(1, n + 1):\n            for a, idx in buckets[r]:\n                if a >= top1v and top1i != -1 and a == top1v:\n                    top2v = a\n                elif a > top1v:\n                    top2v = top1v\n                    top1v = a\n                    top1i = idx\n                elif a > top2v:\n                    top2v = a\n                # if a == top1v with top1i == -1 (impossible since a>=1), handled above\n            if top1i != -1:\n                gain[top1i] += top1v - top2v\n            base += r - top1v\n        best_gain = max(gain) if m > 0 else 0\n        return base + best_gain\n"}

