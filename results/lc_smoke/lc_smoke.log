TOOL submit_solution {"ticket_id": "T-2469", "code": "from typing import List\n\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # Normalize pairs as (a, b) with a < b; bucket a-values by b.\n        buckets = [[] for _ in range(n + 1)]\n        pairs = []\n        for x, y in conflictingPairs:\n            a, b = min(x, y), max(x, y)\n            buckets[b].append(a)\n            pairs.append((a, b))\n\n        # For each r: L1[r] = largest a with b <= r (0 if none),\n        # cnt1 = multiplicity of L1, sec = second largest a (multiset).\n        max1, cnt1, sec = 0, 1, 0  # sentinel 0 for \"no pair\"\n        L1 = [0] * (n + 1)\n        g = [0] * (n + 1)\n        for r in range(1, n + 1):\n            for v in buckets[r]:\n                if v > max1:\n                    sec = max1\n                    max1 = v\n                    cnt1 = 1\n                elif v == max1:\n                    cnt1 += 1\n                    sec = max1\n                else:\n                    if v > sec:\n                        sec = v\n            L1[r] = max1\n            g[r] = (max1 - sec) if cnt1 == 1 else 0\n\n        base = 0\n        for r in range(1, n + 1):\n            base += r - L1[r]\n\n        # Prefix sums of g.\n        P = [0] * (n + 1)\n        for r in range(1, n + 1):\n            P[r] = P[r - 1] + g[r]\n\n        # For each value a, the contiguous range of r where L1[r] == a.\n        first = {}\n        last = {}\n        for r in range(1, n + 1):\n            v = L1[r]\n            if v == 0:\n                continue\n            if v not in first:\n                first[v] = r\n            last[v] = r\n\n        best_gain = 0\n        for a, b in pairs:\n            if a not in first:\n                continue\n            lo = max(b, first[a])\n            hi = last[a]\n            if lo <= hi:\n                gain = P[hi] - P[lo - 1]\n                if gain > best_gain:\n                    best_gain = gain\n\n        return base + best_gain\n"}

