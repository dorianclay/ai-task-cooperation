TOOL submit_solution {"ticket_id": "Q-7113", "code": "class Solution:\n    def generateString(self, str1: str, str2: str) -> str:\n        n, m = len(str1), len(str2)\n        L = n + m - 1\n        word = [None] * L\n        forced = [False] * L\n        for i, c in enumerate(str1):\n            if c == 'T':\n                for k in range(m):\n                    p = i + k\n                    if forced[p]:\n                        if word[p] != str2[k]:\n                            return \"\"\n                    else:\n                        forced[p] = True\n                        word[p] = str2[k]\n        for p in range(L):\n            if not forced[p]:\n                word[p] = 'a'\n        for i, c in enumerate(str1):\n            if c == 'F':\n                cur = ''.join(word[i:i + m])\n                if cur == str2:\n                    # find rightmost free position in window\n                    j = None\n                    for p in range(i + m - 1, i - 1, -1):\n                        if not forced[p]:\n                            j = p\n                            break\n                    if j is None:\n                        return \"\"\n                    word[j] = 'b' if word[j] == 'a' else 'a'\n        res = ''.join(word)\n        for i, c in enumerate(str1):\n            sub = res[i:i + m]\n            if c == 'T' and sub != str2:\n                return \"\"\n            if c == 'F' and sub == str2:\n                return \"\"\n        return res\n"}

