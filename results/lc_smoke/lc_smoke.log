TOOL submit_solution {"ticket_id": "Q-2469", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # Normalize pairs so a < b, group by the larger endpoint b.\n        by_right = [[] for _ in range(n + 1)]\n        for x, y in conflictingPairs:\n            a, b = min(x, y), max(x, y)\n            by_right[b].append(a)\n\n        # For each right endpoint r, the valid subarrays ending at r have left index > lim(r),\n        # where lim(r) = max a over pairs with b <= r. We track the top two candidate\n        # bounds with their source pair index so that removing one pair is handled exactly.\n        # Pair identity: we use the index in conflictingPairs (count of pairs with the same b).\n        total_bad = 0\n        # best1 = (value, pair_id), best2 = second largest value from a different pair\n        best1 = (0, -1)\n        best2 = 0\n        # We need, for each removed pair p, bad(p) = sum over r of (lim_without_p(r)).\n        # Simpler exact approach: lim(r) changes only when a new max appears; we compute\n        # bad_total = sum_r lim(r), and for removing pair p, the bound at r becomes the\n        # max over other pairs, which equals the second-best if p was the unique max.\n        # Per-pair contribution: while p is the argmax for a stretch of r, the bound\n        # drops to second best. We accumulate loss[p] over those stretches.\n        loss = [0] * len(conflictingPairs)\n        # Map each pair to its index; group pairs by b with their indices.\n        idx_by_right = [[] for _ in range(n + 1)]\n        for i, (x, y) in enumerate(conflictingPairs):\n            a, b = min(x, y), max(x, y)\n            idx_by_right[b].append((a, i))\n\n        # Maintain top two (value, id) over all pairs with b <= r.\n        top1_v, top1_id = 0, -1\n        top2_v = 0\n        total_bad = 0\n        for r in range(1, n + 1):\n            for a, i in idx_by_right[r]:\n                if a > top1_v:\n                    top2_v = top1_v\n                    top1_v, top1_id = a, i\n                elif a > top2_v:\n                    top2_v = a\n            total_bad += top1_v\n            # removing top1's pair would lower bound at this r to top2_v\n            if top1_id != -1:\n                loss[top1_id] += top1_v - top2_v\n\n        total = n * (n + 1) // 2\n        # Removing pair i: bad = total_bad - loss[i]; answer = total - bad.\n        # Max over i of total - (total_bad - loss[i]) = total - total_bad + max(loss).\n        best_loss = max(loss) if loss else 0\n        return total - total_bad + best_loss\n"}

