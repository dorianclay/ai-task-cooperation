TOOL submit_solution {"ticket_id": "Q-7649", "code": "import bisect\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n        a, b = p.split('*')[0], p.split('*')[1]\n        c = p.split('*')[2]\n        # re-split properly: exactly two '*'\n        parts = p.split('*')\n        A, B, C = parts[0], parts[1], parts[2]\n\n        def occurrences(pat):\n            m = len(pat)\n            if m == 0:\n                return list(range(n + 1))\n            # KMP prefix function on pat + '#' + s\n            t = pat + '\\x00' + s\n            L = len(t)\n            pi = [0] * L\n            k = 0\n            for i in range(1, L):\n                while k > 0 and t[i] != t[k]:\n                    k = pi[k - 1]\n                if t[i] == t[k]:\n                    k += 1\n                pi[i] = k\n            res = []\n            for i in range(m + 1, L):\n                if pi[i] == m:\n                    res.append(i - 2 * m)  # start index in s\n            return res\n\n        occA = occurrences(A)\n        occB = occurrences(B)\n        occC = occurrences(C)\n        if not occA or not occB or not occC:\n            return -1\n        lenA, lenB, lenC = len(A), len(B), len(C)\n        best = None\n        for i in occA:\n            # first B occurrence at q >= i + lenA\n            qi = bisect.bisect_left(occB, i + lenA)\n            if qi == len(occB):\n                continue\n            q = occB[qi]\n            # first C occurrence at r >= q + lenB\n            ri = bisect.bisect_left(occC, q + lenB)\n            if ri == len(occC):\n                continue\n            r = occC[ri]\n            length = r + lenC - i\n            if best is None or length < best:\n                best = length\n        return -1 if best is None else best\n"}

