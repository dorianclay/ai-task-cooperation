TOOL submit_solution {"ticket_id": "T-7113", "code": "class Solution:\n    def generateString(self, str1: str, str2: str) -> str:\n        n, m = len(str1), len(str2)\n        L = n + m - 1\n        word = [''] * L\n        forced = [False] * L\n\n        # Apply all 'T' constraints, checking for conflicts.\n        for i, c in enumerate(str1):\n            if c == 'T':\n                for j in range(m):\n                    k = i + j\n                    if forced[k] and word[k] != str2[j]:\n                        return \"\"\n                    word[k] = str2[j]\n                    forced[k] = True\n\n        # Fill remaining free positions with 'a' (lexicographically smallest).\n        for k in range(L):\n            if not forced[k]:\n                word[k] = 'a'\n\n        # Enforce 'F' constraints: break any window equal to str2 using the\n        # rightmost free position in that window.\n        for i, c in enumerate(str1):\n            if c != 'F':\n                continue\n            if word[i:i + m] == list(str2):\n                j = -1\n                for k in range(i + m - 1, i - 1, -1):\n                    if not forced[k]:\n                        j = k\n                        break\n                if j == -1:\n                    return \"\"\n                off = j - i\n                word[j] = 'b' if str2[off] == 'a' else 'a'\n\n        result = ''.join(word)\n\n        # Verify all constraints.\n        for i, c in enumerate(str1):\n            sub = result[i:i + m]\n            if c == 'T' and sub != str2:\n                return \"\"\n            if c == 'F' and sub == str2:\n                return \"\"\n\n        return result\n"}

