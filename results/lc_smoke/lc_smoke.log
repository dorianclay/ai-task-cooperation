TOOL submit_solution {"ticket_id": "Q-8397", "code": "from functools import lru_cache\n\n\nclass Solution:\n    def beautifulNumbers(self, l: int, r: int) -> int:\n        def count(N: int) -> int:\n            # Count beautiful numbers x with 1 <= x <= N.\n            if N <= 0:\n                return 0\n            digits = [int(c) for c in str(N)]\n            n = len(digits)\n\n            @lru_cache(maxsize=None)\n            def dfs(pos, tight, started, s, p):\n                if pos == n:\n                    return 1 if (started and s > 0 and p % s == 0) else 0\n                limit = digits[pos] if tight else 9\n                total = 0\n                for d in range(limit + 1):\n                    nt = tight and d == limit\n                    if not started:\n                        if d == 0:\n                            total += dfs(pos + 1, nt, False, 0, 1)\n                        else:\n                            total += dfs(pos + 1, nt, True, d, d)\n                    else:\n                        total += dfs(pos + 1, nt, True, s + d, p * d)\n                return total\n\n            res = dfs(0, True, False, 0, 1)\n            dfs.cache_clear()\n            return res\n\n        return count(r) - count(l - 1)\n"}

