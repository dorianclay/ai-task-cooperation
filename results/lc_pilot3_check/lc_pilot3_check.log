TOOL submit_solution {"ticket_id": "Q-4021", "code": "from math import gcd\nfrom typing import List\n\nclass Solution:\n    def minimumIncrements(self, nums: List[int], target: List[int]) -> int:\n        t = len(target)\n        full = (1 << t) - 1\n        INF = float('inf')\n\n        # lcm of each nonempty subset of targets\n        lcm_of = [1] * (1 << t)\n        for sub in range(1, 1 << t):\n            low = sub & (-sub)\n            i = low.bit_length() - 1\n            prev = sub ^ low\n            base = lcm_of[prev]\n            v = target[i]\n            lcm_of[sub] = base * v // gcd(base, v)\n\n        dp = [INF] * (1 << t)\n        dp[0] = 0\n\n        for x in nums:\n            # cost for this number to cover each nonempty subset of targets\n            cost = [0] * (1 << t)\n            for sub in range(1, 1 << t):\n                L = lcm_of[sub]\n                v = ((x + L - 1) // L) * L\n                cost[sub] = v - x\n            new = dp[:]  # this number may remain unused\n            for mask in range(1 << t):\n                base = dp[mask]\n                if base == INF:\n                    continue\n                for sub in range(1, 1 << t):\n                    nm = mask | sub\n                    c = base + cost[sub]\n                    if c < new[nm]:\n                        new[nm] = c\n            dp = new\n\n        return int(dp[full])\n"}

