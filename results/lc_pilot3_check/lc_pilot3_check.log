TOOL submit_solution {"ticket_id": "Q-5023", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        OFF = 1900\n        W = 2 * OFF + 1\n        # state: (parity, alt_sum+OFF, product) -> reachable, parity = length % 2\n        # product tracked up to limit; product 0 tracked as value 0\n        # reach[parity] is a set of (sum, product) pairs\n        reach = [set(), set()]\n        best = -1\n        for x in nums:\n            new = [set(s) for s in reach]\n            # start new subsequence with x (length 0 -> length 1, sign +)\n            # Represent empty subsequence specially: parity 0 with sum 0, product 1 (empty)\n            starts = [(x, x)] if x <= limit else [(x, 0)] if x == 0 else []\n            for s, p in starts:\n                new[1].add((s, p))\n            # extend existing non-empty subsequences\n            for par in (0, 1):\n                for s, p in reach[par]:\n                    np_ = p * x\n                    if np_ > limit:\n                        # product exceeds limit; only zero could bring it back, but\n                        # zero is already tracked when included; skip\n                        continue\n                    # next position index is length == par; even index (par==0) adds, odd subtracts\n                    ns = s + x if par == 0 else s - x\n                    if -OFF <= ns <= OFF:\n                        new[1 - par].add((ns, np_))\n            reach = new\n        for par in (0, 1):\n            for s, p in reach[par]:\n                if s == k and p <= limit:\n                    if p > best:\n                        best = p\n        return best\n"}

