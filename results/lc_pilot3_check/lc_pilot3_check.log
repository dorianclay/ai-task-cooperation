Complexity: O(n + m) with the sweep, fine for the limits.
TOOL submit_solution {"ticket_id": "T-8664", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # Group pairs by their larger endpoint b; store (a, index).\n        by_b = [[] for _ in range(n + 1)]\n        for idx, (x, y) in enumerate(conflictingPairs):\n            a, b = min(x, y), max(x, y)\n            by_b[b].append((a, idx))\n\n        m = len(conflictingPairs)\n        # Track top-2 of a-values over pairs with b <= r, with the index of the top.\n        top1 = 0          # largest a\n        top1_idx = -1     # index of pair giving top1\n        top2 = 0          # second largest a (from a different pair)\n        base = 0\n        gain = [0] * m    # extra subarrays gained if pair idx is removed\n\n        for r in range(1, n + 1):\n            for a, idx in by_b[r]:\n                if a > top1:\n                    top2 = top1\n                    top1 = a\n                    top1_idx = idx\n                elif a > top2:\n                    top2 = a\n            # bound for r with all pairs: top1\n            base += r - top1\n            # if the top pair is removed, bound becomes top2\n            if top1_idx != -1:\n                gain[top1_idx] += top1 - top2\n\n        best = max(gain) if m > 0 else 0\n        return base + best\n"}

