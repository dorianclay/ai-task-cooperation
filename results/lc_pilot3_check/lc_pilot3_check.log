TOOL submit_solution {"ticket_id": "Q-1660", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        # Build a trie; cnt[x] = number of words passing through node x.\n        children = [dict()]\n        depth = [0]\n        cnt = [0]\n        paths = []\n        for w in words:\n            node = 0\n            cnt[0] += 1\n            path = [0]\n            for ch in w:\n                nxt = children[node].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children[node][ch] = nxt\n                    children.append(dict())\n                    depth.append(depth[node] + 1)\n                    cnt.append(0)\n                node = nxt\n                cnt[node] += 1\n                path.append(node)\n            paths.append(path)\n\n        N = len(children)\n        NEG = -1\n        # M[x] = deepest node in subtree(x) (including x) with cnt >= k, or NEG\n        M = [NEG] * N\n        t1v = [NEG] * N   # best child M value\n        t1c = [-1] * N    # child achieving best\n        t2v = [NEG] * N   # second best child M value\n        for x in range(N - 1, -1, -1):\n            # children have larger ids than parents, so they are already computed\n            for c in children[x].values():\n                mc = M[c]\n                if mc > t1v[x]:\n                    t2v[x] = t1v[x]\n                    t1v[x] = mc\n                    t1c[x] = c\n                elif mc > t2v[x]:\n                    t2v[x] = mc\n            own = depth[x] if cnt[x] >= k else NEG\n            M[x] = max(own, t1v[x])\n\n        res = []\n        for path in paths:\n            L = len(path) - 1\n            best = 0\n            # (a) deepest qualifying node in a subtree branching off the path\n            for j in range(L + 1):\n                excl = path[j + 1] if j < L else -1\n                if t1c[path[j]] != excl:\n                 