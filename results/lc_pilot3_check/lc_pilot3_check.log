TOOL submit_solution {"ticket_id": "Q-7857", "code": "from typing import List\n\nclass Solution:\n    def hasIncreasingSubarrays(self, nums: List[int], k: int) -> bool:\n        n = len(nums)\n\n        def increasing(start):\n            return all(nums[j] < nums[j + 1] for j in range(start, start + k - 1))\n\n        for a in range(n - 2 * k + 1):\n            b = a + k\n            if increasing(a) and increasing(b):\n                return True\n        return False\n"}

