TOOL submit_solution {"ticket_id": "Q-3567", "code": "from typing import List\n\nclass Solution:\n    def maxSubarraySum(self, nums: List[int]) -> int:\n        n = len(nums)\n        # Best without any removal\n        best = max_kadane = nums[0]\n        cur = nums[0]\n        for v in nums[1:]:\n            cur = max(v, cur + v)\n            best = max(best, cur)\n\n        # Candidate values to remove: distinct values present\n        distinct = set(nums)\n        for x in distinct:\n            # Removing x: elements equal to x are dropped (contribute nothing,\n            # and cannot be part of the subarray). Non-empty remainder must exist.\n            # Kadane over elements != x; a run breaks at x only if we treat it as\n            # removed from the sequence, which means adjacency is joined.\n            cur = None\n            run_best = None\n            remaining = 0\n            for v in nums:\n                if v == x:\n                    continue\n                remaining += 1\n                if cur is None:\n                    cur = v\n                else:\n                    cur = max(v, cur + v)\n                if run_best is None or cur > run_best:\n                    run_best = cur\n            if remaining == 0:\n                continue\n            if run_best is not None and run_best > best:\n                best = run_best\n        return best\n"}

