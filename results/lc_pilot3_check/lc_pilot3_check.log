TOOL submit_solution {"ticket_id": "Q-3727", "code": "from typing import List\n\nclass Solution:\n    def maxSubarraySum(self, nums: List[int], k: int) -> int:\n        # Subarray (i, j] has length divisible by k iff i % k == j % k.\n        # For each residue, track the minimum prefix sum seen so far.\n        INF = float('inf')\n        min_pref = [INF] * k\n        min_pref[0] = 0  # prefix P[0] = 0\n        ans = -INF\n        P = 0\n        for j in range(1, len(nums) + 1):\n            P += nums[j - 1]\n            r = j % k\n            if min_pref[r] != INF:\n                cand = P - min_pref[r]\n                if cand > ans:\n                    ans = cand\n            if P < min_pref[r]:\n                min_pref[r] = P\n        return int(ans)\n"}

