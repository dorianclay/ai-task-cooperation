So the algorithm is correct. I'll use a Counter and check membership with the multiplicity adjustment.
TOOL submit_solution {"ticket_id": "Q-5211", "code": "from typing import List\nfrom collections import Counter\n\nclass Solution:\n    def getLargestOutlier(self, nums: List[int]) -> int:\n        total = sum(nums)\n        cnt = Counter(nums)\n        best = None\n        for s, c in cnt.items():\n            # s is the sum element; outlier o = total - 2*s\n            o = total - 2 * s\n            if o == s:\n                need = 2\n            else:\n                need = 1\n            if cnt.get(o, 0) >= need:\n                if best is None or o > best:\n                    best = o\n        return best\n"}

