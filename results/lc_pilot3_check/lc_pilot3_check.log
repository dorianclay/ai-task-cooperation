TOOL submit_solution {"ticket_id": "Q-6088", "code": "from typing import List\n\nclass Solution:\n    def minOperations(self, nums: List[int], x: int, k: int) -> int:\n        n = len(nums)\n        vals = sorted(set(nums))\n        m = len(vals)\n        rank = {v: i + 1 for i, v in enumerate(vals)}\n        cntT = [0] * (m + 1)\n        sumT = [0] * (m + 1)\n\n        def upd(i, dc, ds):\n            while i <= m:\n                cntT[i] += dc\n                sumT[i] += ds\n                i += i & (-i)\n\n        def pref(i):\n            c = 0\n            s = 0\n            while i > 0:\n                c += cntT[i]\n                s += sumT[i]\n                i -= i & (-i)\n            return c, s\n\n        LOG = 1\n        while LOG * 2 <= m:\n            LOG *= 2\n\n        def kth(r):\n            # smallest 1-based index whose prefix count >= r\n            pos = 0\n            rem = r\n            step = LOG\n            while step:\n                if pos + step <= m and cntT[pos + step] < rem:\n                    pos += step\n                    rem -= cntT[pos]\n                step >>= 1\n            return pos + 1\n\n        med_rank = (x - 1) // 2 + 1  # lower median rank within the window\n        cost = [0] * (n - x + 1)\n        winsum = 0\n        for i in range(n):\n            upd(rank[nums[i]], 1, nums[i])\n            winsum += nums[i]\n            if i >= x:\n                upd(rank[nums[i - x]], -1, -nums[i - x])\n                winsum -= nums[i - x]\n            if i >= x - 1:\n                l = i - x + 1\n                idx = kth(med_rank)\n                med = vals[idx - 1]\n                cL, sL = pref(idx)\n                cR = x - cL\n                sR = winsum - sL\n                cost[l] = med * cL - sL + sR - med * cR\n\n        INF = float('inf')\n        prev = [0] * (n + 1)  # dp[0][i] = 0\n        for _ in range(k):\n            cur = [INF] * (n + 1)\n            for i in range(1, n + 1):\n                best =