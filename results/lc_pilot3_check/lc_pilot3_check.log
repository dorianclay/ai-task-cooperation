TOOL submit_solution {"ticket_id": "Q-5138", "code": "from typing import List\n\nclass Solution:\n    def minOperations(self, queries: List[List[int]]) -> int:\n        def g(x: int) -> int:\n            # sum of f(y) for y in [1, x], where f(y) = number of base-4 digits of y\n            total = 0\n            k = 1\n            lo = 1\n            while lo <= x:\n                hi = 4 * lo - 1\n                cnt = min(x, hi) - lo + 1\n                total += cnt * k\n                lo *= 4\n                k += 1\n            return total\n\n        def digits4(x: int) -> int:\n            k = 0\n            while x > 0:\n                x //= 4\n                k += 1\n            return k\n\n        ans = 0\n        for l, r in queries:\n            S = g(r) - g(l - 1)\n            # each operation reduces the total digit count by at most 2,\n            # and the largest element alone needs f(r) operations\n            cur = max(digits4(r), (S + 1) // 2)\n            ans += cur\n        return ans\n"}

