TOOL submit_solution {"ticket_id": "Q-4507", "code": "from typing import List\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int) -> int:\n        cnt_k = nums.count(k)\n        best_gain = 0\n        present = set(nums)\n        present.discard(k)\n        for v in present:\n            # Kadane: +1 for elements equal to v, -1 for elements equal to k, 0 otherwise\n            cur = 0\n            for x in nums:\n                if x == v:\n                    d = 1\n                elif x == k:\n                    d = -1\n                else:\n                    d = 0\n                cur = max(d, cur + d)\n                if cur > best_gain:\n                    best_gain = cur\n        return cnt_k + best_gain\n"}

