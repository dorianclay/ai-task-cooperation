TOOL submit_solution {"ticket_id": "Q-1940", "code": "from typing import List\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        INF = float('inf')\n        n = len(nums)\n\n        def half(x):\n            return (x + 1) // 2\n\n        # dp[a][b] = min sum using a op1s and b op2s so far\n        dp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            # options: (cost, used1, used2)\n            options = [(x, 0, 0)]\n            if op1 >= 1:\n                options.append((half(x), 1, 0))\n            if op2 >= 1 and x >= k:\n                options.append((x - k, 0, 1))\n            if op1 >= 1 and op2 >= 1:\n                # halve then subtract, if valid\n                h = half(x)\n                if h >= k:\n                    options.append((h - k, 1, 1))\n                # subtract then halve\n                if x >= k:\n                    options.append((half(x - k), 1, 1))\n            ndp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n            for a in range(op1 + 1):\n                for b in range(op2 + 1):\n                    cur = dp[a][b]\n                    if cur == INF:\n                        continue\n                    for cost, u1, u2 in options:\n                        na, nb = a + u1, b + u2\n                        if na <= op1 and nb <= op2:\n                            v = cur + cost\n                            if v < ndp[na][nb]:\n                                ndp[na][nb] = v\n            dp = ndp\n        return min(min(row) for row in dp)\n"}

