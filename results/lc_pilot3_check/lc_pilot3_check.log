TOOL submit_solution {"ticket_id": "Q-7111", "code": "class Solution:\n    def countWinningSequences(self, s: str) -> int:\n        MOD = 10**9 + 7\n        n = len(s)\n        # moves: F=0, W=1, E=2\n        idx = {'F': 0, 'W': 1, 'E': 2}\n        # beats[x] = the move that x beats\n        # F beats E, W beats F, E beats W\n        beats = {0: 2, 1: 0, 2: 1}\n        off = n\n        size = 2 * n + 1\n        # dp[last][diff+off]; last = 3 means no previous move\n        dp = [[0] * size for _ in range(4)]\n        dp[3][off] = 1\n        for ch in s:\n            a = idx[ch]\n            ndp = [[0] * size for _ in range(4)]\n            for last in range(4):\n                row = dp[last]\n                for d in range(size):\n                    v = row[d]\n                    if v == 0:\n                        continue\n                    for b in range(3):\n                        if b == last:\n                            continue\n                        nd = d\n                        if beats[b] == a:      # Bob scores\n                            nd = d + 1\n                        elif beats[a] == b:    # Alice scores\n                            nd = d - 1\n                        if 0 <= nd < size:\n                            ndp[b][nd] = (ndp[b][nd] + v) % MOD\n            dp = ndp\n        total = 0\n        for last in range(3):\n            for d in range(off + 1, size):\n                total = (total + dp[last][d]) % MOD\n        return total\n"}

