TOOL submit_solution {"ticket_id": "Q-5556", "code": "class Solution:\n    def minCostGoodCaption(self, caption: str) -> str:\n        n = len(caption)\n        if n < 3:\n            return \"\"\n        INF = float('inf')\n        s = [ord(ch) - 97 for ch in caption]\n        # pre[c][i] = sum of |s[k] - c| for k < i\n        pre = [[0] * (n + 1) for _ in range(26)]\n        for c in range(26):\n            row = pre[c]\n            for i in range(n):\n                row[i + 1] = row[i] + abs(s[i] - c)\n\n        def run_cost(j, i, c):\n            return pre[c][i] - pre[c][j]\n\n        # dp[i][c]: min cost to make prefix [0,i) good, ending with a run of letter c\n        # that ends exactly at i. Store (cost, string-as-tuple-of-letters-run-list) via\n        # back pointers for reconstruction; compare lexicographically via reconstructed strings.\n        dp_cost = [[INF] * 26 for _ in range(n + 1)]\n        back = [[None] * 26 for _ in range(n + 1)]\n        # best[i] = (cost, c) over all dp[i][*] ; and we need min over j<=i-3 with letter != c\n        # Keep for each prefix end j the best two (cost, letter) to allow letter != c.\n        best_end = [None] * (n + 1)  # list of up to two (cost, letter) pairs sorted\n\n        def top2_for(i):\n            cands = [(dp_cost[i][c], c) for c in range(26) if dp_cost[i][c] < INF]\n            cands.sort()\n            return cands[:2]\n\n        # base: prefix length 0 has a virtual \"no run\" state with cost 0, letter None\n        best_end[0] = [(0, -1)]\n        for i in range(3, n + 1):\n            # consider runs covering [j, i) for j in [0, i-3]\n            for c in range(26):\n                bestv = INF\n                bestj = None\n                bestp = None\n                for j in range(0, i - 2):\n                    if best_end[j] is None:\n                        continue\n                    rc = run_cost(j, i, c)\n                    for cost_prev, p in best_end[j]:\n                        if p == c:\n                            continue\n                        total = cost_prev + rc\n                        if total < bestv:\n                            bestv = total\n                            bestj = j\n                            bestp = p\n                        break\n                if bestj is not None:\n                    dp_cost[i][c] = bestv\n                    back[i][c] = (bestj, bestp)\n            best_end[i] = top2_for(i)\n        # Note: best_end[i] is only populated at i; for j not reached, stays None\n        if best_end[n] is None or not best_end[n]:\n            return \"\"\n        # Pick best final letter, tie-break lexicographically via reconstruction\n        cands = []\n        for c in range(26):\n            if dp_cost[n][c] < INF:\n                cands.append((dp_cost[n][c], c))\n        if not cands:\n            return \"\"\n        cands.sort()\n        bestcost = cands[0][0]\n        options = [c for cost, c in cands if cost == bestcost]\n\n        def build(c):\n            res = []\n            i = n\n            cur = c\n            while i > 0:\n                bj, bp = back[i][cur]\n                res.append(chr(97 + cur) * (i - bj))\n                i = bj\n                cur = bp\n            return \"\".join(reversed(res))\n\n        return min(build(c) for c in options)\n"}

