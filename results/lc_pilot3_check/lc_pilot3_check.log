TOOL submit_solution {"ticket_id": "Q-3567", "code": "from collections import defaultdict\n\nclass Solution:\n    def maxSubarraySum(self, nums: List[int]) -> int:\n        n = len(nums)\n        mx = max(nums)\n        if mx < 0:\n            # Removing anything cannot beat the largest single element.\n            return mx\n\n        # Plain Kadane (no removal)\n        best = cur = nums[0]\n        for v in nums[1:]:\n            cur = max(v, cur + v)\n            best = max(best, cur)\n        ans = best\n\n        # Prefix sums: subarray [j, i] has sum P[i+1] - P[j]\n        P = [0] * (n + 1)\n        for i, v in enumerate(nums):\n            P[i + 1] = P[i] + v\n\n        def build(arr, op):\n            table = [arr[:]]\n            length = 1\n            while 2 * length <= len(arr):\n                prev = table[-1]\n                row = [op(prev[i], prev[i + length]) for i in range(len(arr) - 2 * length + 1)]\n                table.append(row)\n                length *= 2\n            return table\n\n        mn_table = build(P, min)\n        mx_table = build(P, max)\n\n        def query(table, op, l, r):\n            # inclusive range [l, r]\n            length = r - l + 1\n            k = length.bit_length() - 1\n            return op(table[k][l], table[k][r - (1 << k) + 1])\n\n        def qmin(l, r):\n            return query(mn_table, min, l, r)\n\n        def qmax(l, r):\n            return query(mx_table, max, l, r)\n\n        pos = defaultdict(list)\n        for i, v in enumerate(nums):\n            pos[v].append(i)\n\n        NEG = float('-inf')\n        for x, ps in pos.items():\n            c = len(ps)\n            # ext[k] = k-th occurrence (1-indexed), ext[0] = -1, ext[c+1] = n\n            ext = [-1] + ps + [n]\n            best_a = NEG\n            for l in range(1, c + 1):\n                # start j in [ext[l-1]+1, ext[l]] ; contributes -P[j]\n                A = -qmin(ext[l - 1] + 1, ext[l])\n                best_a = max(best_a, A + x * l)\n                # end i in [ext[l], ext[l+1]-1] ; P index i+1 in [ext[l]+1, ext[l+1]]\n                B = qmax(ext[l] + 1, ext[l + 1])\n                cand = best_a + B - x * (l + 1)\n                if cand > ans:\n                    ans = cand\n        return ans\n"}

