TOOL submit_solution {"ticket_id": "Q-9307", "code": "class Solution:\n    def distanceSum(self, m: int, n: int, k: int) -> int:\n        MOD = 10 ** 9 + 7\n        N = m * n\n\n        # sum over unordered pairs of cells of |row diff| and |col diff|\n        R = sum(d * (m - d) for d in range(1, m))\n        C = sum(d * (n - d) for d in range(1, n))\n        pair_sum = (n * n * R + m * m * C) % MOD\n\n        # C(N-2, k-2): number of k-subsets that contain a given pair of cells\n        top, bot = N - 2, k - 2\n        if bot < 0 or bot > top:\n            return 0\n        num = 1\n        den = 1\n        for i in range(bot):\n            num = num * (top - i) % MOD\n            den = den * (i + 1) % MOD\n        comb = num * pow(den, MOD - 2, MOD) % MOD\n\n        return pair_sum * comb % MOD\n"}

