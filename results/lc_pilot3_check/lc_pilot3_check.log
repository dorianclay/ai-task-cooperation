TOOL submit_solution {"ticket_id": "Q-7700", "code": "from typing import List\n\nclass Solution:\n    def countMentions(self, numberOfUsers: int, events: List[List[str]]) -> List[int]:\n        mentions = [0] * numberOfUsers\n        offline_until = [0] * numberOfUsers  # user is online when offline_until <= t\n        ordered = sorted(\n            events,\n            key=lambda e: (int(e[1]), 0 if e[0] == \"OFFLINE\" else 1),\n        )\n        for etype, ts_str, payload in ordered:\n            t = int(ts_str)\n            if etype == \"OFFLINE\":\n                uid = int(payload)\n                offline_until[uid] = t + 60\n            else:\n                if payload == \"ALL\":\n                    for u in range(numberOfUsers):\n                        mentions[u] += 1\n                elif payload == \"HERE\":\n                    for u in range(numberOfUsers):\n                        if offline_until[u] <= t:\n                            mentions[u] += 1\n                else:\n                    for tok in payload.split():\n                        mentions[int(tok[2:])] += 1\n        return mentions\n"}

