TOOL submit_solution {"ticket_id": "Q-1660", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        n = len(words)\n        if n - 1 < k:\n            return [0] * n\n\n        # Build trie: node 0 is root (depth 0)\n        children = [dict()]\n        depth = [0]\n        cnt = [0]\n        paths = []  # node ids on the path of each word (excluding root)\n        for w in words:\n            cur = 0\n            cnt[0] += 1\n            path = []\n            for ch in w:\n                nxt = children[cur].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children[cur][ch] = nxt\n                    children.append(dict())\n                    depth.append(depth[cur] + 1)\n                    cnt.append(0)\n                cur = nxt\n                cnt[cur] += 1\n                path.append(cur)\n            paths.append(path)\n\n        maxd = max(depth)\n        ge = [0] * (maxd + 1)        # nodes at depth d with cnt >= k\n        node_at = [-1] * (maxd + 1)  # the node if exactly one at depth d\n        for v in range(len(cnt)):\n            if cnt[v] >= k:\n                d = depth[v]\n                ge[d] += 1\n                node_at[d] = v\n\n        base = 0\n        static = 0\n        cand = []  # nodes with cnt == k that are the sole qualifying node at their depth\n        for d in range(maxd + 1):\n            if ge[d] >= 2:\n                base = max(base, d)\n            elif ge[d] == 1:\n                v = node_at[d]\n                if cnt[v] >= k + 1:\n                    static = max(static, d)\n                else:\n                    cand.append(v)\n\n        # deepest candidates first\n        cand.sort(key=lambda v: -depth[v])\n\n        res = []\n        for i in range(n):\n            on_path = set(paths[i])\n            ans = max(base, static)\n            for v in cand:\n                if v not in on_path:\n                    ans = max(ans, depth[v])\n                    break\n            res.append(ans)\n        return res\n"}

