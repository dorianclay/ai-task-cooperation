TOOL submit_solution {"ticket_id": "Q-6153", "code": "from functools import lru_cache\n\nclass Solution:\n    def beautifulNumbers(self, l: int, r: int) -> int:\n\n        @lru_cache(maxsize=None)\n        def free(rem, s, p, started):\n            # number of ways to fill `rem` free digits so the full number is beautiful\n            if rem == 0:\n                return 1 if (started and s > 0 and p % s == 0) else 0\n            total = 0\n            for d in range(10):\n                if started or d > 0:\n                    ns = s + d\n                    np_ = p * d if started else d\n                    total += free(rem - 1, ns, np_, True)\n                else:\n                    total += free(rem - 1, 0, 1, False)\n            return total\n\n        def count(X):\n            if X <= 0:\n                return 0\n            digs = [int(c) for c in str(X)]\n            L = len(digs)\n            total = 0\n            s_pref, p_pref, started_pref = 0, 1, False\n            for i in range(L):\n                for d in range(digs[i]):\n                    if started_pref or d > 0:\n                        ns = s_pref + d\n                        np_ = p_pref * d if started_pref else d\n                        total += free(L - i - 1, ns, np_, True)\n                    else:\n                        total += free(L - i - 1, 0, 1, False)\n                # extend tight prefix with the actual digit\n                d = digs[i]\n                if started_pref or d > 0:\n                    s_pref = s_pref + d\n                    p_pref = p_pref * d if started_pref else d\n                    started_pref = True\n                else:\n                    s_pref, p_pref = 0, 1\n            # the number X itself\n            if started_pref and s_pref > 0 and p_pref % s_pref == 0:\n                total += 1\n            return total\n\n        return count(r) - count(l - 1)\n"}

