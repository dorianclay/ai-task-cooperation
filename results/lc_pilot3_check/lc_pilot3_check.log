TOOL submit_solution {"ticket_id": "Q-6088", "code": "from typing import List\n\nclass Solution:\n    def minOperations(self, nums: List[int], x: int, k: int) -> int:\n        n = len(nums)\n        vals = sorted(set(nums))\n        m = len(vals)\n        rank = {v: i + 1 for i, v in enumerate(vals)}  # 1-indexed\n\n        cnt = [0] * (m + 1)\n        sm = [0] * (m + 1)\n\n        def update(p, v, s):\n            while p <= m:\n                cnt[p] += s\n                sm[p] += s * v\n                p += p & (-p)\n\n        def prefix(p):\n            c = 0\n            t = 0\n            while p > 0:\n                c += cnt[p]\n                t += sm[p]\n                p -= p & (-p)\n            return c, t\n\n        LOG = 1\n        while LOG * 2 <= m:\n            LOG *= 2\n\n        def kth(kk):\n            # smallest 1-indexed position p with prefix count >= kk\n            pos = 0\n            rem = kk\n            step = LOG\n            while step:\n                nxt = pos + step\n                if nxt <= m and cnt[nxt] < rem:\n                    pos = nxt\n                    rem -= cnt[nxt]\n                step >>= 1\n            return pos + 1\n\n        r = (x + 1) // 2  # lower median rank\n        total_sum = 0\n\n        def window_cost():\n            p = kth(r)\n            mv = vals[p - 1]\n            cL, sL = prefix(p)\n            cR = x - cL\n            sR = total_sum - sL\n            return mv * cL - sL + sR - mv * cR\n\n        # initial window\n        for i in range(x):\n            update(rank[nums[i]], nums[i], 1)\n            total_sum += nums[i]\n        c = [0] * (n - x + 1)\n        c[0] = window_cost()\n\n        for l in range(1, n - x + 1):\n            old = nums[l - 1]\n            new = nums[l + x - 1]\n            update(rank[old], old, -1)\n            total_sum -= old\n            update(rank[new], new, 1)\n            total_sum += new\n            c[l] = window_cost()\n\n        INF = float('inf')\n        # dp_prev[i]: min cost choosing (j-1) windows within first i elements\n        dp_prev = [0] * (n + 1)  # j = 0\n        for j in range(1, k + 1):\n            dp_cur = [INF] * (n + 1)\n            for i in range(1, n + 1):\n                best = dp_cur[i - 1]\n                if i >= x and dp_prev[i - x] < INF:\n                    cand = dp_prev[i - x] + c[i - x]\n                    if cand < best:\n                        best = cand\n                dp_cur[i] = best\n            dp_prev = dp_cur\n        return int(dp_prev[n])\n"}

