TOOL submit_solution {"ticket_id": "Q-1223", "code": "from typing import List\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        NEG = float('-inf')\n        m = len(coins)\n        n = len(coins[0])\n        # dp[j][k]: best profit at current cell column j with k neutralizations used\n        prev = None\n        for i in range(m):\n            cur = [[NEG] * 3 for _ in range(n)]\n            for j in range(n):\n                v = coins[i][j]\n                if i == 0 and j == 0:\n                    cur[0][0] = v\n                    if v < 0:\n                        cur[0][1] = 0\n                        # using neutralization here: profit 0 instead of v\n                    continue\n                for k in range(3):\n                    best = NEG\n                    # arrive from above\n                    if prev is not None and prev[j][k] != NEG:\n                        best = max(best, prev[j][k])\n                    # arrive from left\n                    if j > 0 and cur[j - 1][k] != NEG:\n                        best = max(best, cur[j - 1][k])\n                    if best != NEG:\n                        cur[j][k] = max(cur[j][k], best + v)\n                # neutralize this cell if it's a robber, using one more\n                if v < 0:\n                    for k in range(2):\n                        best = NEG\n                        if prev is not None and prev[j][k] != NEG:\n                            best = max(best, prev[j][k])\n                        if j > 0 and cur[j - 1][k] != NEG:\n                            best = max(best, cur[j - 1][k])\n                        if best != NEG:\n                            cur[j][k + 1] = max(cur[j][k + 1], best)\n            prev = cur\n        return max(prev[n - 1])\n"}

