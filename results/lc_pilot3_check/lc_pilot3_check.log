TOOL submit_solution {"ticket_id": "Q-7380", "code": "from typing import List\nfrom collections import Counter\n\nclass Solution:\n    def findXSum(self, nums: List[int], k: int, x: int) -> List[int]:\n        n = len(nums)\n        answer = []\n        for i in range(n - k + 1):\n            window = nums[i:i + k]\n            counts = Counter(window)\n            ranked = sorted(counts.items(), key=lambda kv: (kv[1], kv[0]), reverse=True)\n            keep = {val for val, _ in ranked[:x]}\n            answer.append(sum(v for v in window if v in keep))\n        return answer\n"}

