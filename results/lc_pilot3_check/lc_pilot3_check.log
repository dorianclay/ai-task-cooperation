TOOL submit_solution {"ticket_id": "Q-3070", "code": "from typing import List\n\nclass Solution:\n    def stringSequence(self, target: str) -> List[str]:\n        result = []\n        prefix = \"\"\n        for ch in target:\n            target_val = ord(ch) - ord('a')\n            for c in range(target_val + 1):\n                result.append(prefix + chr(ord('a') + c))\n            prefix += ch\n        return result\n"}

