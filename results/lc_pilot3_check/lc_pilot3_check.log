TOOL submit_solution {"ticket_id": "Q-5023", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        BIG = limit + 1  # marker: nonzero product exceeding limit\n\n        def apply(p, x):\n            if x == 0:\n                return 0\n            if p == 0:\n                return 0\n            if p == BIG:\n                return BIG\n            q = p * x\n            return q if q <= limit else BIG\n\n        # states[(par, s)] = set of products of non-empty subsequences whose\n        # alternating sum is s and whose length parity is par (next element sign: par 0 -> +, 1 -> -)\n        states = {}\n        for x in nums:\n            new = {key: set(v) for key, v in states.items()}\n            # start a new subsequence with x\n            first_p = apply(1, x)\n            new.setdefault((1, x), set()).add(first_p)\n            # extend existing subsequences with x\n            for (par, s), ps in states.items():\n                ns = s + x if par == 0 else s - x\n                target = new.setdefault((1 - par, ns), set())\n                for p in ps:\n                    target.add(apply(p, x))\n            states = new\n\n        best = -1\n        for par in (0, 1):\n            for p in states.get((par, k), ()):\n                if p != BIG and p <= limit and p > best:\n                    best = p\n        return best\n"}

