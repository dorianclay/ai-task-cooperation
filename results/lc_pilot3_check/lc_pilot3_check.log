Since the robot can also pick any combination, the DP covers all paths and all neutralization choices.
TOOL submit_solution {"ticket_id": "Q-1223", "code": "from typing import List\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        NEG = float('-inf')\n        m = len(coins)\n        n = len(coins[0])\n        # prev[j][k] = best profit reaching cell (i-1, j) having used k neutralizations\n        prev = None\n        for i in range(m):\n            cur = [[NEG] * 3 for _ in range(n)]\n            for j in range(n):\n                v = coins[i][j]\n                if i == 0 and j == 0:\n                    if v >= 0:\n                        cur[0][0] = v\n                    else:\n                        cur[0][0] = v      # take the penalty\n                        cur[0][1] = 0      # neutralize\n                    continue\n                # gather predecessor states\n                cand = [NEG] * 3\n                if prev is not None:\n                    for k in range(3):\n                        if prev[j][k] > cand[k]:\n                            cand[k] = prev[j][k]\n                if j > 0:\n                    for k in range(3):\n                        if cur[j - 1][k] > cand[k]:\n                            cand[k] = cur[j - 1][k]\n                for k in range(3):\n                    if cand[k] == NEG:\n                        continue\n                    if v >= 0:\n                        val = cand[k] + v\n                        if val > cur[j][k]:\n                            cur[j][k] = val\n                    else:\n                        # take the penalty\n                        val = cand[k] + v\n                        if val > cur[j][k]:\n                            cur[j][k] = val\n                        # neutralize\n                        if k < 2:\n                            val2 = cand[k]\n                            if val2 > cur[j][k + 1]:\n                                cur[j][k + 1] = val2\n            prev = cur\n        return int(max(prev[n - 1]))\n"}

