TOOL submit_solution {"ticket_id": "Q-4808", "code": "from typing import List\nfrom itertools import combinations\n\nclass Solution:\n    def maxRectangleArea(self, points: List[List[int]]) -> int:\n        pts = [tuple(p) for p in points]\n        pset = set(pts)\n        best = -1\n        for a, b, c, d in combinations(pts, 4):\n            xs = sorted({a[0], b[0], c[0], d[0]})\n            ys = sorted({a[1], b[1], c[1], d[1]})\n            if len(xs) != 2 or len(ys) != 2:\n                continue\n            x1, x2 = xs\n            y1, y2 = ys\n            corners = [(x1, y1), (x1, y2), (x2, y1), (x2, y2)]\n            if not all(cn in pset for cn in corners):\n                continue\n            # no other point inside or on the border\n            ok = True\n            for p in pts:\n                if p in corners:\n                    continue\n                if x1 <= p[0] <= x2 and y1 <= p[1] <= y2:\n                    ok = False\n                    break\n            if not ok:\n                continue\n            area = (x2 - x1) * (y2 - y1)\n            if area > best:\n                best = area\n        return best\n"}

