TOOL submit_solution {"ticket_id": "Q-3417", "code": "from collections import deque\n\nclass Solution:\n    def minimumCost(self, nums: List[int], cost: List[int], k: int) -> int:\n        n = len(nums)\n        INF = float('inf')\n        # S[r] = nums[0] + ... + nums[r-1], C[r] = cost[0] + ... + cost[r-1]\n        S = [0] * (n + 1)\n        C = [0] * (n + 1)\n        for i in range(n):\n            S[i + 1] = S[i] + nums[i]\n            C[i + 1] = C[i] + cost[i]\n\n        # prev[l] = min cost to split the first l elements into j-1 segments\n        prev = [INF] * (n + 1)\n        prev[0] = 0\n        ans = INF\n\n        for j in range(1, n + 1):\n            new = [INF] * (n + 1)\n            # Lines: for each l with prev[l] finite, y = prev[l] - x * C[l]\n            # Query at x = S[r] + k*j, minimized over l < r.\n            # Slopes -C[l] strictly decreasing, queries x increasing -> monotone CHT.\n            dq = deque()  # entries (m, b)\n            for r in range(1, n + 1):\n                l = r - 1\n                if prev[l] < INF:\n                    m3 = -C[l]\n                    b3 = prev[l]\n                    while len(dq) >= 2:\n                        m1, b1 = dq[-2]\n                        m2, b2 = dq[-1]\n                        # remove l2 if it is never strictly needed\n                        if (b3 - b1) * (m1 - m2) <= (b2 - b1) * (m1 - m3):\n                            dq.pop()\n                        else:\n                            break\n                    dq.append((m3, b3))\n                if dq:\n                    x = S[r] + k * j\n                    while len(dq) >= 2 and dq[0][0] * x + dq[0][1] >= dq[1][0] * x + dq[1][1]:\n                        dq.popleft()\n                    m, b = dq[0]\n                    val = m * x + b + x * C[r]\n                    new[r] = val\n            prev = new\n            if prev[n] < ans:\n                ans = prev[n]\n\n        return int(ans)\n"}

