TOOL submit_solution {"ticket_id": "Q-4029", "code": "from typing import List\n\nclass Solution:\n    def lengthAfterTransformations(self, s: str, t: int) -> int:\n        MOD = 10**9 + 7\n        cnt = [0] * 26\n        for ch in s:\n            cnt[ord(ch) - ord('a')] += 1\n        for _ in range(t):\n            new = [0] * 26\n            for c in range(25):\n                new[c + 1] = cnt[c]\n            # 'z' becomes \"ab\": one 'a' and one 'b'\n            new[0] = (new[0] + cnt[25]) % MOD\n            new[1] = (new[1] + cnt[25]) % MOD\n            cnt = [x % MOD for x in new]\n        return sum(cnt) % MOD\n"}

