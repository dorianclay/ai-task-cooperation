TOOL submit_solution {"ticket_id": "Q-5138", "code": "from typing import List\n\nclass Solution:\n    def minOperations(self, queries: List[List[int]]) -> int:\n        def F(N):\n            # sum over x in [1, N] of the number of base-4 digits of x\n            # (equivalently, the number of divisions by 4 needed to reach 0)\n            total = 0\n            k = 1\n            lo = 1\n            while lo <= N:\n                hi = 4 * lo - 1\n                total += k * (min(N, hi) - lo + 1)\n                lo *= 4\n                k += 1\n            return total\n\n        def steps(x):\n            k = 0\n            while x > 0:\n                x //= 4\n                k += 1\n            return k\n\n        ans = 0\n        for l, r in queries:\n            S = F(r) - F(l - 1)\n            m = steps(r)  # the largest element needs the most steps\n            ans += max(m, (S + 1) // 2)\n        return ans\n"}

