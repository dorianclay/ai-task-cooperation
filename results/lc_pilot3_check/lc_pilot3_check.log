TOOL submit_solution {"ticket_id": "Q-2737", "code": "from typing import List\n\nclass Solution:\n    def maximizeSumOfWeights(self, edges: List[List[int]], k: int) -> int:\n        n = len(edges) + 1\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        parent = [-1] * n\n        pw = [0] * n\n        order = []\n        visited = [False] * n\n        stack = [0]\n        visited[0] = True\n        while stack:\n            u = stack.pop()\n            order.append(u)\n            for v, w in adj[u]:\n                if not visited[v]:\n                    visited[v] = True\n                    parent[v] = u\n                    pw[v] = w\n                    stack.append(v)\n\n        dp0 = [0] * n  # parent edge not kept\n        dp1 = [0] * n  # parent edge kept\n\n        for u in reversed(order):\n            base = 0\n            gains = []\n            for v, w in adj[u]:\n                if v == parent[u]:\n                    continue\n                base += dp0[v]\n                g = dp1[v] + w - dp0[v]\n                if g > 0:\n                    gains.append(g)\n            gains.sort(reverse=True)\n            # dp0: can keep up to k child edges\n            dp0[u] = base + sum(gains[:k])\n            # dp1: can keep up to k-1 child edges (parent edge uses one slot)\n            dp1[u] = base + sum(gains[:k - 1]) if k - 1 > 0 else base\n\n        return dp0[0]\n"}

