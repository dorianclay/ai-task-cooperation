TOOL submit_solution {"ticket_id": "Q-4808", "code": "from typing import List\n\nclass Solution:\n    def maxRectangleArea(self, points: List[List[int]]) -> int:\n        pts = [tuple(p) for p in points]\n        pset = set(pts)\n        n = len(pts)\n        best = -1\n        for a in range(n):\n            x1, y1 = pts[a]\n            for b in range(n):\n                if a == b:\n                    continue\n                x2, y2 = pts[b]\n                # (x1,y1) bottom-left, (x2,y2) top-right\n                if not (x1 < x2 and y1 < y2):\n                    continue\n                # other two corners must exist\n                if (x1, y2) not in pset or (x2, y1) not in pset:\n                    continue\n                # no other point inside or on border\n                valid = True\n                for (px, py) in pts:\n                    if x1 <= px <= x2 and y1 <= py <= y2:\n                        if (px, py) not in ((x1, y1), (x1, y2), (x2, y1), (x2, y2)):\n                            valid = False\n                            break\n                if valid:\n                    area = (x2 - x1) * (y2 - y1)\n                    if area > best:\n                        best = area\n        return best\n"}

