TOOL submit_solution {"ticket_id": "Q-4953", "code": "import heapq\nfrom typing import List\n\nclass Solution:\n    def minTimeToReach(self, moveTime: List[List[int]]) -> int:\n        n = len(moveTime)\n        m = len(moveTime[0])\n        INF = float('inf')\n        dist = [[INF] * m for _ in range(n)]\n        dist[0][0] = 0\n        heap = [(0, 0, 0)]\n        while heap:\n            t, i, j = heapq.heappop(heap)\n            if t > dist[i][j]:\n                continue\n            if i == n - 1 and j == m - 1:\n                return t\n            for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                ni, nj = i + di, j + dj\n                if 0 <= ni < n and 0 <= nj < m:\n                    # wait until the room opens, then spend one second moving in\n                    nt = max(t, moveTime[ni][nj]) + 1\n                    if nt < dist[ni][nj]:\n                        dist[ni][nj] = nt\n                        heapq.heappush(heap, (nt, ni, nj))\n        return dist[n - 1][m - 1]\n"}

