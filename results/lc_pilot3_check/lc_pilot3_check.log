TOOL submit_solution {"ticket_id": "Q-6967", "code": "from typing import List\n\nclass Solution:\n    def maxScore(self, points: List[int], m: int) -> int:\n        n = len(points)\n\n        def min_moves_for_end(c, f):\n            # E[k] = number of traversals of the edge left of node k (E[0] is the edge from -1 to 0).\n            # Walk starts at -1 and ends at f; edges left of f are traversed an odd number\n            # of times, edges at/after f an even number (>= 2). Node i needs at least c[i] visits.\n            E = [0] * (n + 1)\n            E[0] = 1\n            for i in range(n - 1):\n                d = 1 if i == f else 0\n                need = 2 * c[i] - d - E[i]\n                if i + 1 == n - 1:\n                    need = max(need, 2 * c[n - 1] - (1 if f == n - 1 else 0))\n                odd = i < f\n                x = max(need, 1 if odd else 2)\n                if odd and x % 2 == 0:\n                    x += 1\n                if (not odd) and x % 2 == 1:\n                    x += 1\n                E[i + 1] = x\n            total = 0\n            for i in range(n):\n                d = 1 if i == f else 0\n                total += (E[i] + E[i + 1] + d) // 2\n            return total\n\n        def feasible(T):\n            c = [(T + p - 1) // p for p in points]\n            for f in range(n):\n                if min_moves_for_end(c, f) <= m:\n                    return True\n            return False\n\n        lo, hi = 0, max(points) * m\n        while lo < hi:\n            mid = (lo + hi + 1) // 2\n            if feasible(mid):\n                lo = mid\n            else:\n                hi = mid - 1\n        return lo\n"}

