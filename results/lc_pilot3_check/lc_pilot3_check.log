TOOL submit_solution {"ticket_id": "Q-6184", "code": "from typing import List\n\nclass Solution:\n    def minMaxSubarraySum(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n\n        def contrib_counts(arr, is_max):\n            # left[i]: previous index with strictly-better-than-or-equal (tie-break)\n            # right[i]: next index with strictly better\n            left = [-1] * n\n            right = [n] * n\n            st = []\n            for i in range(n):\n                while st and ((arr[st[-1]] <= arr[i]) if is_max else (arr[st[-1]] >= arr[i])):\n                    st.pop()\n                left[i] = st[-1] if st else -1\n                st.append(i)\n            st = []\n            for i in range(n - 1, -1, -1):\n                while st and ((arr[st[-1]] < arr[i]) if is_max else (arr[st[-1]] > arr[i])):\n                    st.pop()\n                right[i] = st[-1] if st else n\n                st.append(i)\n            return left, right\n\n        def total_for(arr, is_max):\n            left, right = contrib_counts(arr, is_max)\n            total = 0\n            for i in range(n):\n                L, R = left[i], right[i]\n                lo = max(L + 1, i - k + 1)  # valid left endpoints\n                hi = i\n                cnt = 0\n                for_l_range = hi - lo + 1\n                if for_l_range <= 0:\n                    continue\n                # For each l in [lo, i], r ranges over [i, min(R-1, l+k-1)]\n                # count = min(R-1, l+k-1) - i + 1\n                # Split: l+k-1 <= R-1  <=> l <= R-k\n                split = min(i, R - k)  # l in [lo, split] uses l+k-1\n                a_end = min(split, i)\n                if a_end >= lo:\n                    # sum over l in [lo, a_end] of (l+k-1 - i + 1) = sum (l + k - i)\n                    cntl = a_end - lo + 1\n                    s_l = (lo + a_end) * cntl // 2\n                    cnt += s_l + cntl * (k - i)\n                b_start = max(lo, a_end + 1)\n                if b_start <= i:\n                    # count = R-1 - i + 1 = R - i\n                    cnt += (i - b_start + 1) * (R - i)\n                total += cnt * arr[i]\n            return total\n\n        return total_for(nums, True) + total_for(nums, False)\n"}

