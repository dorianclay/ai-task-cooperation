TOOL submit_solution {"ticket_id": "Q-9022", "code": "class Solution:\n    def countSubstrings(self, s: str) -> int:\n        n = len(s)\n        count = 0\n        for j in range(n):\n            d = ord(s[j]) - 48\n            if d == 0:\n                continue\n            # value of s[i..j] mod d, built from j leftward\n            rem = 0\n            p = 1  # 10^(j-i) mod d\n            for i in range(j, -1, -1):\n                rem = (rem + (ord(s[i]) - 48) * p) % d\n                p = (p * 10) % d\n                if rem == 0:\n                    count += 1\n        return count\n"}

