TOOL submit_solution {"ticket_id": "Q-2235", "code": "from typing import List\nimport bisect\n\nclass Solution:\n    def maximumWeight(self, intervals: List[List[int]]) -> List[int]:\n        n = len(intervals)\n        # sort by right endpoint, keep original indices\n        order = sorted(range(n), key=lambda i: (intervals[i][1], intervals[i][0], i))\n        rs = [intervals[i][1] for i in order]\n        K = 4\n\n        # prev[p] = number of sorted intervals (positions 0..) with r < l of order[p]\n        prev = [0] * n\n        for p in range(n):\n            l = intervals[order[p]][0]\n            # count of sorted positions with r < l\n            prev[p] = bisect.bisect_left(rs, l)\n\n        # dp[p][j] = best (weight, index_list) using intervals among sorted positions [0, p)\n        # with at most j picks. Represent best as (weight, tuple of original indices sorted).\n        NEG = (-1, ())\n        def better(a, b):\n            # return True if a is better than b\n            if a[0] != b[0]:\n                return a[0] > b[0]\n            # lexicographically smaller index list wins; empty tuple vs nonempty handled by compare\n            return a[1] < b[1]\n\n        # dp rows: dp[p] is list of length K+1\n        dp = [[(0, ())] * (K + 1) for _ in range(n + 1)]\n        for p in range(1, n + 1):\n            cur = list(dp[p - 1])\n            q = p - 1  # sorted position of interval being considered\n            oi = order[q]\n            w = intervals[oi][2]\n            pv = prev[q]\n            for j in range(1, K + 1):\n                base_w, base_idx = dp[pv][j - 1]\n                cand_w = base_w + w\n                cand_idx = tuple(sorted(base_idx + (oi,)))\n                cand = (cand_w, cand_idx)\n                if better(cand, cur[j]):\n                    cur[j] = cand\n            # ensure at-most monotonicity\n            for j in range(1, K + 1):\n                if better(cur[j - 1], cur[j]):\n                    cur[j] = cur[j - 1]\n            dp[p] = cur\n\n        best = dp[n][K]\n        return list(best[1])\n"}

