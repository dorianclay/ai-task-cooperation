TOOL submit_solution {"ticket_id": "Q-1660", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        n = len(words)\n        if n - 1 < k:\n            return [0] * n\n\n        # Build trie with counts and depth\n        children = [{}]\n        cnt = [0]\n        depth = [0]\n        paths = []  # node ids along each word's path (excluding root)\n        for w in words:\n            cur = 0\n            path = []\n            for ch in w:\n                nxt = children[cur].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children.append({})\n                    cnt.append(0)\n                    depth.append(depth[cur] + 1)\n                    children[cur][ch] = nxt\n                cur = nxt\n                cnt[cur] += 1\n                path.append(cur)\n            paths.append(path)\n\n        # Nodes eligible with full counts, sorted by depth descending\n        m = len(children)\n        order = sorted(range(1, m), key=lambda x: -depth[x])\n\n        res = [0] * n\n        for i in range(n):\n            # Remove word i: decrement counts along its path temporarily\n            path = paths[i]\n            for node in path:\n                cnt[node] -= 1\n            # find the deepest node with cnt >= k\n            ans = 0\n            # only need to consider nodes with depth on the path or any node;\n            # scan order (sorted by depth desc) and take first eligible\n            for node in order:\n                if cnt[node] >= k:\n                    ans = depth[node]\n                    break\n            res[i] = ans\n            for node in path:\n                cnt[node] += 1\n        return res\n"}

