TOOL submit_solution {"ticket_id": "Q-7473", "code": "from typing import List\nfrom itertools import permutations\n\nclass Solution:\n    def totalNumbers(self, digits: List[int]) -> int:\n        found = set()\n        n = len(digits)\n        for i, j, k in permutations(range(n), 3):\n            a, b, c = digits[i], digits[j], digits[k]\n            if a == 0:\n                continue\n            if c % 2 != 0:\n                continue\n            found.add(a * 100 + b * 10 + c)\n        return len(found)\n"}

