TOOL submit_solution {"ticket_id": "Q-1347", "code": "from typing import List\n\nclass Solution:\n    def countNonDecreasingSubarrays(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        # next strictly greater element index (n if none)\n        nge = [n] * (n + 1)\n        stack = []\n        for i in range(n - 1, -1, -1):\n            while stack and nums[stack[-1]] <= nums[i]:\n                stack.pop()\n            nge[i] = stack[-1] if stack else n\n            stack.append(i)\n\n        LOG = max(1, n.bit_length())\n        w = [0] * (n + 1)\n        for j in range(n):\n            w[j] = nums[j] * (nge[j] - j)\n\n        up = [nge[:]]\n        S = [w[:]]\n        for t in range(1, LOG):\n            pu = up[t - 1]\n            ps = S[t - 1]\n            nu = [pu[pu[j]] for j in range(n + 1)]\n            ns = [ps[j] + ps[pu[j]] for j in range(n + 1)]\n            up.append(nu)\n            S.append(ns)\n\n        P = [0] * (n + 1)\n        for i in range(n):\n            P[i + 1] = P[i] + nums[i]\n\n        def cost(l, r):\n            cur = l\n            tot = 0\n            for kk in range(LOG - 1, -1, -1):\n                nxt = up[kk][cur]\n                if nxt <= r:\n                    tot += S[kk][cur]\n                    cur = nxt\n            tot += nums[cur] * (r + 1 - cur)\n            return tot - (P[r + 1] - P[l])\n\n        count = 0\n        L = 0\n        for r in range(n):\n            while cost(L, r) > k:\n                L += 1\n            count += r - L + 1\n        return count\n"}

