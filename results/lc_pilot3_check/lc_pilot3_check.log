TOOL submit_solution {"ticket_id": "Q-1878", "code": "from typing import List\n\nclass Solution:\n    def countComponents(self, nums: List[int], threshold: int) -> int:\n        T = threshold\n        n = len(nums)\n        parent = list(range(n))\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a, b):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[ra] = rb\n\n        # Values > threshold can never share an edge (lcm >= value > threshold).\n        isolated = 0\n        idx = {}\n        for i, v in enumerate(nums):\n            if v > T:\n                isolated += 1\n            else:\n                idx[v] = i\n\n        # Two values a, b are adjacent iff lcm(a, b) <= T. If lcm(a,b) = L <= T,\n        # both divide L. So for every L <= T, all present values dividing L\n        # belong to one component. rep[L] stores one such value's index.\n        rep = [-1] * (T + 1)\n        for a in sorted(idx):\n            i = idx[a]\n            for L in range(a, T + 1, a):\n                if rep[L] == -1:\n                    rep[L] = i\n                else:\n                    union(i, rep[L])\n\n        roots = set()\n        for v, i in idx.items():\n            roots.add(find(i))\n        return isolated + len(roots)\n"}

