TOOL submit_solution {"ticket_id": "Q-2235", "code": "from typing import List\nfrom bisect import bisect_left\n\nclass Solution:\n    def maximumWeight(self, intervals: List[List[int]]) -> List[int]:\n        n = len(intervals)\n        # sort by right endpoint, keep original indices\n        order = sorted(range(n), key=lambda i: (intervals[i][1], i))\n        L = [intervals[i][0] for i in order]\n        R = [intervals[i][1] for i in order]\n        W = [intervals[i][2] for i in order]\n        orig = order\n        rs = R[:]  # sorted right endpoints\n        # prev[p] = number of intervals (in sorted order) whose right end < left end of p\n        prev = [bisect_left(rs, L[p]) for p in range(n)]\n\n        def better(a, b):\n            # a, b are (weight, sorted index list); prefer larger weight, then lex smaller list\n            if a[0] != b[0]:\n                return a if a[0] > b[0] else b\n            return a if a[1] <= b[1] else b\n\n        # F[c][i]: best (weight, indices) using at most c intervals among first i (sorted order)\n        prev_layer = [(0, [])] * (n + 1)  # c = 0\n        for c in range(1, 5):\n            cur = [(0, [])] * (n + 1)\n            for i in range(1, n + 1):\n                p = i - 1  # sorted position of the i-th interval\n                skip = cur[i - 1]\n                pl = prev[p]\n                pw, plist = prev_layer[pl]\n                take = (pw + W[p], sorted(plist + [orig[p]]))\n                cur[i] = better(skip, take)\n            prev_layer = cur\n        return prev_layer[n][1]\n"}

