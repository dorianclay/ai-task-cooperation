TOOL submit_solution {"ticket_id": "Q-1020", "code": "from typing import List\n\nclass Solution:\n    def maxDistance(self, side: int, points: List[List[int]], k: int) -> int:\n        def perim(x, y):\n            # map boundary point to position along perimeter, going around\n            if y == 0:\n                return x\n            if x == side:\n                return side + y\n            if y == side:\n                return 3 * side - x\n            return 4 * side - y  # x == 0\n\n        pts = sorted(points, key=lambda p: perim(p[0], p[1]))\n        m = len(pts)\n\n        def md(a, b):\n            return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n        def feasible(d):\n            # try each start point, greedily pick subsequent points in cyclic order\n            for s in range(m):\n                chosen = [pts[s]]\n                for step in range(1, m):\n                    p = pts[(s + step) % m]\n                    ok = True\n                    for q in chosen:\n                        if md(p, q) < d:\n                            ok = False\n                            break\n                    if ok:\n                        chosen.append(p)\n                        if len(chosen) >= k:\n                            return True\n            return False\n\n        lo, hi = 0, 2 * side\n        while lo < hi:\n            mid = (lo + hi + 1) // 2\n            if feasible(mid):\n                lo = mid\n            else:\n                hi = mid - 1\n        return lo\n"}

