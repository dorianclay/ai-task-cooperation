TOOL submit_solution {"ticket_id": "Q-1878", "code": "from typing import List\n\nclass Solution:\n    def countComponents(self, nums: List[int], threshold: int) -> int:\n        T = threshold\n        n = len(nums)\n        idx = {}\n        for i, v in enumerate(nums):\n            if v <= T:\n                idx[v] = i\n\n        parent = list(range(n))\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        merges = 0\n\n        def union(a, b):\n            nonlocal merges\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[ra] = rb\n                merges += 1\n\n        # Two values a, b are adjacent iff lcm(a, b) <= T. If both divide some L <= T,\n        # then lcm(a, b) divides L, so lcm <= T. Conversely any edge has both values dividing\n        # lcm(a, b) <= T. So the graph is the union of cliques over present divisors of each L <= T.\n        lists = [[] for _ in range(T + 1)]\n        for a in idx:\n            for L in range(a, T + 1, a):\n                lists[L].append(a)\n\n        for L in range(1, T + 1):\n            lst = lists[L]\n            if len(lst) >= 2:\n                first = idx[lst[0]]\n                for v in lst[1:]:\n                    union(first, idx[v])\n\n        return n - merges\n"}

