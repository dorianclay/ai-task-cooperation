TOOL submit_solution {"ticket_id": "Q-6088", "code": "from typing import List\nimport heapq\n\nclass Solution:\n    def minOperations(self, nums: List[int], x: int, k: int) -> int:\n        n = len(nums)\n        INF = float('inf')\n\n        # Compute cost[i] = min ops to make nums[i..i+x-1] all equal (median cost).\n        # Use sorted list of window values with bisect for simplicity and correctness.\n        import bisect\n        cost = [INF] * n\n        window = sorted(nums[:x])\n        prefix = [0] * (x + 1)\n        def window_cost(w):\n            m = len(w)\n            med = w[m // 2]\n            # sum |v - med|\n            idx = m // 2\n            left = med * idx - sum(w[:idx])\n            right = sum(w[idx + 1:]) - med * (m - idx - 1)\n            return left + right\n        cost[0] = window_cost(window)\n        for i in range(1, n - x + 1):\n            old = nums[i - 1]\n            new = nums[i + x - 1]\n            window.pop(bisect.bisect_left(window, old))\n            bisect.insort(window, new)\n            cost[i] = window_cost(window)\n\n        # dp over windows: dp[j][p] = min cost using j windows among first p elements\n        # dp[j][p] = min(dp[j][p-1], dp[j-1][p-x] + cost[p-x]) where window starts at p-x\n        dp_prev = [0] * (n + 1)  # j = 0\n        for j in range(1, k + 1):\n            dp_cur = [INF] * (n + 1)\n            for p in range(1, n + 1):\n                best = dp_cur[p - 1]\n                s = p - x\n                if s >= 0 and dp_prev[s] < INF and cost[s] < INF:\n                    cand = dp_prev[s] + cost[s]\n                    if cand < best:\n                        best = cand\n                dp_cur[p] = best\n            dp_prev = dp_cur\n        return dp_prev[n]\n"}

