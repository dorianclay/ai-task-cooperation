TOOL submit_solution {"ticket_id": "Q-9680", "code": "from typing import List\n\nclass Solution:\n    def maxRemovals(self, source: str, pattern: str, targetIndices: List[int]) -> int:\n        n = len(source)\n        m = len(pattern)\n        is_target = [False] * n\n        for t in targetIndices:\n            is_target[t] = True\n        # dp[j] = max removals so far such that pattern[:j] is matched using kept characters\n        # (-1 means unreachable)\n        dp = [-1] * (m + 1)\n        dp[0] = 0\n        for i in range(n):\n            c = source[i]\n            new = dp[:]  # keeping this character without matching it\n            if is_target[i]:\n                # remove it: state unchanged, one more removal\n                for j in range(m + 1):\n                    if dp[j] >= 0 and dp[j] + 1 > new[j]:\n                        new[j] = dp[j] + 1\n            # keep it and use it to match the next pattern character\n            for j in range(m):\n                if dp[j] >= 0 and pattern[j] == c and dp[j] > new[j + 1]:\n                    new[j + 1] = dp[j]\n            dp = new\n        return dp[m]\n"}

