TOOL submit_solution {"ticket_id": "Q-8357", "code": "from typing import List\nfrom collections import defaultdict\nfrom math import gcd\n\nclass Solution:\n    def numberOfSubsequences(self, nums: List[int]) -> int:\n        n = len(nums)\n        if n < 7:\n            return 0\n\n        def reduce(a, b):\n            g = gcd(a, b)\n            return (a // g, b // g)\n\n        total = 0\n        # For fixed q, prefix counts over p in [0, q-2] keyed by reduced nums[p]/nums[q].\n        for q in range(3, n - 3):\n            pref = defaultdict(int)\n            for p in range(0, q - 1):\n                pref[reduce(nums[p], nums[q])] += 1\n            # For fixed r in [q+2, n-3], suffix over s in [r+2, n-1] keyed by reduced nums[s]/nums[r].\n            # Build suffix counts incrementally from the right for this q.\n            # Since keys depend on r, we rebuild per r over the s-range; restrict to valid s.\n            for r in range(q + 2, n - 3):\n                suf = defaultdict(int)\n                for s in range(r + 2, n):\n                    suf[reduce(nums[s], nums[r])] += 1\n                for key, cnt in pref.items():\n                    # Match nums[p]/nums[q] == nums[s]/nums[r]\n                    if key in suf:\n                        total += cnt * suf[key]\n        return total\n"}

