TOOL submit_solution {"ticket_id": "Q-5556", "code": "class Solution:\n    def minCostGoodCaption(self, caption: str) -> str:\n        n = len(caption)\n        INF = float('inf')\n        vals = [ord(ch) - ord('a') for ch in caption]\n        # pre[c][i] = cost to turn caption[0:i] all into char c\n        pre = []\n        for c in range(26):\n            arr = [0] * (n + 1)\n            acc = 0\n            for i in range(n):\n                acc += abs(vals[i] - c)\n                arr[i + 1] = acc\n            pre.append(arr)\n\n        best_cost = [INF] * (n + 1)\n        best_str = [None] * (n + 1)\n        best_cost[n] = 0\n        best_str[n] = \"\"\n\n        for i in range(n - 1, -1, -1):\n            cands = []  # (total_cost, L, c)\n            for L in (3, 4, 5):\n                j = i + L\n                if j > n or best_cost[j] == INF:\n                    continue\n                bc_min = INF\n                bc_c = -1\n                for c in range(26):\n                    bc = pre[c][j] - pre[c][i]\n                    if bc < bc_min:\n                        bc_min = bc\n                        bc_c = c\n                cands.append((bc_min + best_cost[j], L, bc_c))\n            if not cands:\n                continue\n            mn = min(x[0] for x in cands)\n            chosen = None\n            for total, L, c in cands:\n                if total != mn:\n                    continue\n                s = chr(ord('a') + c) * L + best_str[i + L]\n                if chosen is None or s < chosen:\n                    chosen = s\n            best_cost[i] = mn\n            best_str[i] = chosen\n            # free memory no longer needed\n            if i + 6 <= n:\n                best_str[i + 6] = None\n\n        if best_cost[0] == INF:\n            return \"\"\n        return best_str[0]\n"}

