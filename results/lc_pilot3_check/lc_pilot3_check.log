TOOL submit_solution {"ticket_id": "Q-6153", "code": "from functools import lru_cache\n\nclass Solution:\n    def beautifulNumbers(self, l: int, r: int) -> int:\n        def count(N: int) -> int:\n            if N <= 0:\n                return 0\n            digits = list(map(int, str(N)))\n            L = len(digits)\n\n            @lru_cache(maxsize=None)\n            def dp(pos, s, prod, tight, started):\n                # s: digit sum so far; prod: product of digits so far (only meaningful if started)\n                if pos == L:\n                    if not started:\n                        return 0\n                    return 1 if prod % s == 0 else 0\n                limit = digits[pos] if tight else 9\n                total = 0\n                for d in range(0, limit + 1):\n                    nt = tight and d == limit\n                    if not started and d == 0:\n                        total += dp(pos + 1, 0, 1, nt, False)\n                    else:\n                        total += dp(pos + 1, s + d, prod * d, nt, True)\n                return total\n\n            res = dp(0, 0, 1, True, False)\n            dp.cache_clear()\n            return res\n\n        return count(r) - count(l - 1)\n"}

