TOOL submit_solution {"ticket_id": "Q-3070", "code": "from typing import List\n\nclass Solution:\n    def stringSequence(self, target: str) -> List[str]:\n        result = []\n        prefix = \"\"\n        for ch in target:\n            # Append 'a' then advance the last character until it matches ch\n            cur = 'a'\n            prefix_base = prefix\n            while True:\n                result.append(prefix_base + cur)\n                if cur == ch:\n                    break\n                cur = chr((ord(cur) - ord('a') + 1) % 26 + ord('a'))\n            prefix = prefix_base + ch\n        return result\n"}

