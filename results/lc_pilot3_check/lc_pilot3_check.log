TOOL submit_solution {"ticket_id": "Q-8444", "code": "from typing import List\n\nclass Solution:\n    def maxCollectedFruits(self, fruits: List[List[int]]) -> int:\n        n = len(fruits)\n        # Child 1 along main diagonal\n        total = sum(fruits[i][i] for i in range(n))\n        NEG = float('-inf')\n\n        # Child 2 from (0, n-1) in the upper-right triangle (j > i), ends at (n-1, n-1)\n        # Moves: (i+1, j-1), (i+1, j), (i+1, j+1). Restricted to j > i.\n        dp = [NEG] * n\n        dp[n - 1] = fruits[0][n - 1]\n        for i in range(1, n):\n            ndp = [NEG] * n\n            for j in range(n):\n                if j <= i:\n                    continue\n                best = NEG\n                for pj in (j - 1, j, j + 1):\n                    if 0 <= pj < n and dp[pj] > best:\n                        best = dp[pj]\n                if best > NEG:\n                    ndp[j] = best + fruits[i][j]\n            dp = ndp\n        total += dp[n - 1] if dp[n - 1] > NEG else 0\n\n        # Child 3 from (n-1, 0) in the lower-left triangle (i > j), ends at (n-1, n-1)\n        # Transpose: moves are symmetric to child 2 on the transposed grid.\n        dp = [NEG] * n\n        dp[n - 1] = fruits[n - 1][0]\n        for j in range(1, n):\n            ndp = [NEG] * n\n            for i in range(n):\n                if i <= j:\n                    continue\n                best = NEG\n                for pi in (i - 1, i, i + 1):\n                    if 0 <= pi < n and dp[pi] > best:\n                        best = dp[pi]\n                if best > NEG:\n                    ndp[i] = best + fruits[i][j]\n            dp = ndp\n        total += dp[n - 1] if dp[n - 1] > NEG else 0\n\n        return total\n"}

