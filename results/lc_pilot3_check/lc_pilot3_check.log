TOOL submit_solution {"ticket_id": "Q-5301", "code": "import bisect\nfrom typing import List\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n\n        def occurrences(pat: str) -> List[int]:\n            # All start positions where pat occurs in s (KMP). Empty pattern matches everywhere.\n            m = len(pat)\n            if m == 0:\n                return list(range(n + 1))\n            fail = [0] * m\n            k = 0\n            for i in range(1, m):\n                while k and pat[i] != pat[k]:\n                    k = fail[k - 1]\n                if pat[i] == pat[k]:\n                    k += 1\n                fail[i] = k\n            res = []\n            k = 0\n            for i, ch in enumerate(s):\n                while k and ch != pat[k]:\n                    k = fail[k - 1]\n                if ch == pat[k]:\n                    k += 1\n                if k == m:\n                    res.append(i - m + 1)\n                    k = fail[k - 1]\n            return res\n\n        A, B, C = p.split('*')\n        occA = occurrences(A)\n        occB = occurrences(B)\n        occC = occurrences(C)\n        lA, lB, lC = len(A), len(B), len(C)\n\n        best = -1\n        for i in occA:\n            # earliest B starting at or after the end of A\n            bi = bisect.bisect_left(occB, i + lA)\n            if bi == len(occB):\n                continue\n            jb = occB[bi]\n            # earliest C starting at or after the end of B\n            ci = bisect.bisect_left(occC, jb + lB)\n            if ci == len(occC):\n                continue\n            jc = occC[ci]\n            length = jc + lC - i\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

