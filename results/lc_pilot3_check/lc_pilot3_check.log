TOOL submit_solution {"ticket_id": "Q-6184", "code": "from typing import List\n\nclass Solution:\n    def minMaxSubarraySum(self, nums: List[int], k: int) -> int:\n        def sum_max(arr):\n            n = len(arr)\n            left = [0] * n\n            stack = []\n            for i in range(n):\n                while stack and arr[stack[-1]] < arr[i]:\n                    stack.pop()\n                left[i] = stack[-1] + 1 if stack else 0\n                stack.append(i)\n            right = [0] * n\n            stack = []\n            for i in range(n - 1, -1, -1):\n                while stack and arr[stack[-1]] <= arr[i]:\n                    stack.pop()\n                right[i] = stack[-1] - 1 if stack else n - 1\n                stack.append(i)\n\n            total = 0\n            for i in range(n):\n                a = left[i]\n                b = right[i]\n                L0 = max(a, i - k + 1)\n                if L0 > i:\n                    continue\n                cnt_pairs = 0\n                # part 1: l in [L0, m1], r in [i, l+k-1]  -> (l+k-i) choices\n                m1 = min(i, b - k + 1)\n                if m1 >= L0:\n                    c = m1 - L0 + 1\n                    sum_l = (L0 + m1) * c // 2\n                    cnt_pairs += sum_l + c * (k - i)\n                # part 2: l in [s2, i], r in [i, b] -> (b-i+1) choices\n                s2 = max(L0, b - k + 2)\n                if s2 <= i:\n                    c2 = i - s2 + 1\n                    cnt_pairs += c2 * (b - i + 1)\n                total += arr[i] * cnt_pairs\n            return total\n\n        neg = [-x for x in nums]\n        return sum_max(nums) - sum_max(neg)\n"}

