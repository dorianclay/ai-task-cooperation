TOOL submit_solution {"ticket_id": "Q-8664", "code": "import bisect\nfrom typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        by_b = [[] for _ in range(n + 1)]\n        pairs = []\n        for x, y in conflictingPairs:\n            a, b = min(x, y), max(x, y)\n            by_b[b].append(a)\n            pairs.append((a, b))\n\n        # t1[r], t2[r]: largest and second largest 'a' over pairs with b <= r (0 if none)\n        t1 = [-1] * (n + 1)   # index 0 is a sentinel for bisect\n        gain = [0] * (n + 1)\n        top1 = 0\n        top2 = 0\n        base = 0\n        for r in range(1, n + 1):\n            for x in by_b[r]:\n                if x >= top1:\n                    top2 = top1\n                    top1 = x\n                elif x > top2:\n                    top2 = x\n            t1[r] = top1\n            gain[r] = top1 - top2\n            base += r - top1\n\n        # prefix sums of gain\n        G = [0] * (n + 1)\n        for r in range(1, n + 1):\n            G[r] = G[r - 1] + gain[r]\n\n        best = 0\n        for a0, b0 in pairs:\n            extra = 0\n            # r-range where top1[r] == a0 (t1 is nondecreasing)\n            s = bisect.bisect_left(t1, a0)\n            e = bisect.bisect_right(t1, a0) - 1\n            if s <= e:\n                lo = max(s, b0)\n                if lo <= e:\n                    extra = G[e] - G[lo - 1]\n            best = max(best, base + extra)\n        return best\n"}

