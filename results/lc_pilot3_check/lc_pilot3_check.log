TOOL submit_solution {"ticket_id": "Q-3727", "code": "from typing import List\n\nclass Solution:\n    def maxSubarraySum(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        INF = float('inf')\n        # min_prefix[r] = minimum prefix sum P[i] with i % k == r among eligible i\n        min_prefix = [INF] * k\n        prefix = [0] * (n + 1)\n        for idx in range(n):\n            prefix[idx + 1] = prefix[idx] + nums[idx]\n\n        best = -INF\n        for j in range(k, n + 1):\n            # index i = j - k becomes eligible\n            i = j - k\n            r_i = i % k\n            if prefix[i] < min_prefix[r_i]:\n                min_prefix[r_i] = prefix[i]\n            r_j = j % k\n            if min_prefix[r_j] != INF:\n                cand = prefix[j] - min_prefix[r_j]\n                if cand > best:\n                    best = cand\n        return best\n"}

