TOOL submit_solution {"ticket_id": "Q-9680", "code": "from typing import List\n\nclass Solution:\n    def maxRemovals(self, source: str, pattern: str, targetIndices: List[int]) -> int:\n        n = len(source)\n        m = len(pattern)\n        NEG = -10**9\n        is_target = [False] * n\n        for t in targetIndices:\n            is_target[t] = True\n        # dp[j]: max removals so far, with pattern[:j] matched as a subsequence\n        dp = [NEG] * (m + 1)\n        dp[0] = 0\n        for i in range(n):\n            ndp = dp[:]  # default: we keep, but no match here (handled below)\n            c = source[i]\n            if is_target[i]:\n                # option to remove this character: keeps state, +1\n                for j in range(m + 1):\n                    if dp[j] != NEG:\n                        ndp[j] = max(ndp[j], dp[j] + 1)\n            # option to keep: matches pattern[j] if equal\n            for j in range(m):\n                if dp[j] != NEG and pattern[j] == c:\n                    ndp[j + 1] = max(ndp[j + 1], dp[j])\n            dp = ndp\n        return max(dp[m], 0)\n"}

