TOOL submit_solution {"ticket_id": "Q-8662", "code": "from typing import List\n\nclass Solution:\n    def minTime(self, skill: List[int], mana: List[int]) -> int:\n        n = len(skill)\n        m = len(mana)\n        S = [0] * n\n        acc = 0\n        for i, s in enumerate(skill):\n            acc += s\n            S[i] = acc\n\n        # Points P_i = (S[i], S[i-1]), S[-1] = 0.\n        pts = []\n        prev = 0\n        for i in range(n):\n            pts.append((S[i], prev))\n            prev = S[i]\n\n        # Lower convex hull (x strictly increasing).\n        hull = []\n        for p in pts:\n            while len(hull) >= 2:\n                x0, y0 = hull[-2]\n                x1, y1 = hull[-1]\n                x2, y2 = p\n                cross = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0)\n                if cross <= 0:\n                    hull.pop()\n                else:\n                    break\n            hull.append(p)\n\n        L = len(hull)\n\n        def best(a: int, b: int) -> int:\n            # maximize a*x - b*y over hull points; objective is unimodal along lower hull\n            lo, hi = 0, L - 1\n            while lo < hi:\n                mid = (lo + hi) // 2\n                x0, y0 = hull[mid]\n                x1, y1 = hull[mid + 1]\n                if a * (x1 - x0) - b * (y1 - y0) > 0:\n                    lo = mid + 1\n                else:\n                    hi = mid\n            x, y = hull[lo]\n            return a * x - b * y\n\n        total = 0\n        for j in range(1, m):\n            total += best(mana[j - 1], mana[j])\n        total += mana[m - 1] * S[n - 1]\n        return total\n"}

