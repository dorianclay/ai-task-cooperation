TOOL submit_solution {"ticket_id": "Q-9307", "code": "class Solution:\n    def distanceSum(self, m: int, n: int, k: int) -> int:\n        MOD = 10 ** 9 + 7\n        N = m * n\n\n        # Each unordered pair of cells appears together in C(N-2, k-2) arrangements.\n        # Sum of |row diff| over all unordered cell pairs = n^2 * C(m+1, 3),\n        # sum of |col diff| = m^2 * C(n+1, 3).\n        def c3(a):\n            # C(a, 3) exactly\n            return a * (a - 1) * (a - 2) // 6 if a >= 3 else 0\n\n        pair_sum = (n * n * c3(m + 1) + m * m * c3(n + 1)) % MOD\n\n        # C(N-2, k-2) mod p\n        r = k - 2\n        a = N - 2\n        if r < 0 or r > a:\n            return 0\n        num = 1\n        den = 1\n        for i in range(r):\n            num = num * (a - i) % MOD\n            den = den * (i + 1) % MOD\n        comb = num * pow(den, MOD - 2, MOD) % MOD\n\n        return pair_sum * comb % MOD\n"}

