TOOL submit_solution {"ticket_id": "T-6967", "code": "from typing import List\n\nclass Solution:\n    def maxScore(self, points: List[int], m: int) -> int:\n        n = len(points)\n\n        def min_moves_needed(T):\n            # c_i = required visits to index i so gameScore[i] >= T\n            c = [(T + p - 1) // p for p in points]\n            # Path from -1: go forward to index n-1 (n moves), with back-and-forth\n            # extra visits. Each extra visit to index i beyond the first pass costs\n            # 2 moves per pair of visits; a back-and-forth between i and i+1 adds\n            # coverage to both.\n            # Extra traversals needed for index i: max(0, c_i - 1).\n            # A back-and-forth step from i to i+1 and back gives 2 extra visits to i+1\n            # and 1 to i over the base; model: each unit of extra need at index i\n            # costs 2 moves, but a single back-and-forth at boundary (i, i+1) can\n            # cover one extra visit each for both sides at cost 2.\n            moves = n  # base forward path\n            # carry the extra need from right to left\n            need = [max(0, c[i] - 1) for i in range(n)]\n            # process from the last index backward, pairing extra needs of adjacent indices\n            i = n - 1\n            cost = 0\n            while i >= 0:\n                if need[i] > 0:\n                    # use back-and-forth ending at i (between i-1 and i if possible)\n                    k = need[i]\n                    cost += 2 * k\n                    need[i] = 0\n                    if i - 1 >= 0:\n                        need[i - 1] = max(0, need[i - 1] - k)\n                i -= 1\n            # moves includes base n forward moves, plus extra back-and-forths\n            return moves + cost\n\n        lo = 0\n        hi = min(points) * ((m + n) // 1 + 1)\n        best = 0\n        # binary search max T with feasibility\n        lo, hi = 0, 10**18\n        while lo < hi:\n            mid = (lo + hi