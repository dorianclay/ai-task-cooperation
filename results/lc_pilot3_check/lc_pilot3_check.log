TOOL submit_solution {"ticket_id": "Q-9008", "code": "import heapq\n\nclass Solution:\n    def minOperations(self, n: int, m: int) -> int:\n        LIMIT = 10000\n        is_prime = [True] * LIMIT\n        is_prime[0] = False\n        is_prime[1] = False\n        for i in range(2, int(LIMIT ** 0.5) + 1):\n            if is_prime[i]:\n                for j in range(i * i, LIMIT, i):\n                    is_prime[j] = False\n\n        if is_prime[n] or is_prime[m]:\n            return -1\n        if n == m:\n            return n\n\n        L = len(str(n))\n        pow10 = [10 ** (L - 1 - p) for p in range(L)]\n\n        def digits(x):\n            return [(x // pow10[p]) % 10 for p in range(L)]\n\n        def number(ds):\n            return sum(d * pow10[p] for p, d in enumerate(ds))\n\n        dist = {n: n}\n        heap = [(n, n)]\n        while heap:\n            cost, x = heapq.heappop(heap)\n            if cost > dist.get(x, float('inf')):\n                continue\n            if x == m:\n                return cost\n            ds = digits(x)\n            for p in range(L):\n                d = ds[p]\n                for nd in (d - 1, d + 1):\n                    if 0 <= nd <= 9:\n                        ds[p] = nd\n                        y = number(ds)\n                        ds[p] = d\n                        if is_prime[y]:\n                            continue\n                        nc = cost + y\n                        if nc < dist.get(y, float('inf')):\n                            dist[y] = nc\n                            heapq.heappush(heap, (nc, y))\n        return -1\n"}

