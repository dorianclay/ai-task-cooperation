mxv, a, b in sub:\n                        # blocks: running max of segment changes at each new max\n                        stack.append((mxv, a, b))\n                    # Re-normalize: blocks must have strictly decreasing maxval from\n                    # left to right; the sub-blocks here are increasing, so merge\n                    # them into one block with max = the last (largest) value.\n                    # Cost of [seg_s..be] with running max: compute directly.\n                    cur_max = None\n                    newblocks = []\n                    for j in range(seg_s, be + 1):\n                        if cur_max is None or nums[j] > cur_max:\n                            cur_max = nums[j]\n                            newblocks.append([cur_max, j, j])\n                        else:\n                            newblocks[-1][2] = j\n                    # Now the blocks are: each has maxval = nums[start], which is\n                    # increasing. Merge: a block with running max m covers until\n                    # next greater element; equivalent representation: one block\n                    # per running-max change; cost is sum over elements of\n                    # (runmax - nums[i]). Store as individual pieces in order.\n                    # To keep deque invariant (decreasing maxvals), we push in\n                    # reverse order is not valid; instead rebuild the whole\n                    # structure from scratch for the window [l+1..r].\n                    blocks.clear()\n                    cost = 0\n                    curm = None\n                    for j in range(l + 1, r + 1):\n                        v = nums[j]\n                        if not blocks or v > blocks[-1][0]:\n                            blocks.append((v, j, j))\n                        else:\n                            blocks[-1] = (blocks[-1][0], blocks[-1][1], j)\n                    # Actually compute cost correctly from running max\n                    cost = 0\n                    run = None\n                    for j in range(l + 1, r + 1):\n                        run = nums[j] if run is None or nums[j] > run else run\n                        cost += run - nums[j]\n                    # Rebuild block structure as a stack of (maxval, s, e) with\n                    # strictly decreasing maxval from left to right.\n                    blocks.clear()\n                    stk = []\n                    for j in range(l + 1, r + 1):\n                        v = nums[j]\n                        s = j\n                        while stk and stk[-1][0] <= v:\n                            s = stk[-1][1]\n                            stk.pop()\n                        stk.append((v, s, j))\n                    for item in stk:\n                        blocks.append(item)\n                    # block_cost requires correct per-block maxval; cost recomputed above\n                    # but blocks' costs are consistent with the running-max cost.\n                    # Recompute cost from blocks to be safe:\n                    cost = sum(block_cost(mx, bs, be2) for mx, bs, be2 in blocks)\n                else:\n                    cost = cost\n            else:\n                # window empty; r < l means l moves past r\n                r = l\n                blocks.clear()\n                cost = 0\n        return total\n"}

