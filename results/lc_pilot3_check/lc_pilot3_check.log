TOOL submit_solution {"ticket_id": "Q-1020", "code": "from typing import List\n\nclass Solution:\n    def maxDistance(self, side: int, points: List[List[int]], k: int) -> int:\n        S = side\n\n        def perim(x, y):\n            if y == 0:\n                return x\n            if x == S:\n                return S + y\n            if y == S:\n                return 2 * S + (S - x)\n            return 3 * S + (S - y)\n\n        pts = sorted(((perim(x, y), x, y) for x, y in points))\n        N = len(pts)\n        xs = [p[1] for p in pts]\n        ys = [p[2] for p in pts]\n\n        def man(i, j):\n            return abs(xs[i] - xs[j]) + abs(ys[i] - ys[j])\n\n        def feasible(d):\n            # greedy: from each start, walk the perimeter cyclically and take\n            # points that are at Manhattan distance >= d from all chosen so far.\n            # Every chosen set is verified pairwise, so a True result is sound.\n            for s in range(N):\n                chosen = [s]\n                for step in range(1, N):\n                    j = (s + step) % N\n                    ok = True\n                    for c in chosen:\n                        if man(j, c) < d:\n                            ok = False\n                            break\n                    if ok:\n                        chosen.append(j)\n                        if len(chosen) == k:\n                            return True\n            return False\n\n        lo, hi = 0, 2 * S\n        while lo < hi:\n            mid = (lo + hi + 1) // 2\n            if feasible(mid):\n                lo = mid\n            else:\n                hi = mid - 1\n        return lo\n"}

