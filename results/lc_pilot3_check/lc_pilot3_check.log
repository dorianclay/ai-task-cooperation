Checking example 1, window 2 [1,2,2,3,4,2]: counts are 2→3, 1→1, 3→1, 4→1. Top 2 are 2 (count 3) and then 4 (value wins the tie over 3 and 1). Sum = 2+2+2+4 = 10. ✓
TOOL submit_solution {"ticket_id": "Q-7380", "code": "from typing import List\nfrom collections import Counter\n\nclass Solution:\n    def findXSum(self, nums: List[int], k: int, x: int) -> List[int]:\n        n = len(nums)\n        answer = []\n        for i in range(n - k + 1):\n            window = nums[i:i + k]\n            counts = Counter(window)\n            ranked = sorted(counts.keys(), key=lambda v: (counts[v], v), reverse=True)\n            keep = set(ranked[:x])\n            total = sum(v for v in window if v in keep)\n            answer.append(total)\n        return answer\n"}

