TOOL submit_solution {"ticket_id": "T-7996", "code": "from typing import List\nfrom collections import Counter\nfrom itertools import combinations\n\nclass Solution:\n    def subsequencesWithMiddleMode(self, nums: List[int]) -> int:\n        MOD = 10**9 + 7\n        n = len(nums)\n        if n < 5:\n            return 0\n\n        total = 0\n        for p in range(2, n - 2):\n            v = nums[p]\n            left = nums[:p]\n            right = nums[p + 1:]\n            # Choose 2 from left and 2 from right. Enumerate the value multiset\n            # of the chosen left pair and right pair by value frequency.\n            # Left pair choices: group by value.\n            cl = Counter(left)\n            cr = Counter(right)\n\n            # Build counts of left-pair outcomes: map (value-tuple sorted) -> ways\n            def pair_outcomes(cnt):\n                res = Counter()\n                vals = list(cnt.keys())\n                # same value pairs\n                for x in vals:\n                    c = cnt[x]\n                    if c >= 2:\n                        res[((x, 2),)] += c * (c - 1) // 2\n                # distinct value pairs\n                for i in range(len(vals)):\n                    for j in range(i + 1, len(vals)):\n                        x, y = vals[i], vals[j]\n                        res[((x, 1), (y, 1))] += cnt[x] * cnt[y]\n                return res\n\n            lo = pair_outcomes(cl)\n            ro = pair_outcomes(cr)\n\n            for lk, lw in lo.items():\n                for rk, rw in ro.items():\n                    freq = Counter()\n                    for x, c in lk:\n                        freq[x] += c\n                    for x, c in rk:\n                        freq[x] += c\n                    # middle value v contributes 1\n                    freq[v] += 1\n                    fv = freq[v]\n                    other_max = 0\n                    for x, c in freq.items():\n                        if x != v and c > other_max:\n                            other_max = c\n                    if fv > other_max:\n                        total = (total + lw * rw) % MOD\n        return total % MOD\n"}

