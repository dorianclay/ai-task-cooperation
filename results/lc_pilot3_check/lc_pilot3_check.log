TOOL submit_solution {"ticket_id": "Q-1940", "code": "from typing import List\n\nINF = float('inf')\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        # dp[a][b] = min sum so far using a op1's and b op2's\n        dp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            # possible outcomes for this element: (ops1 used, ops2 used, resulting value)\n            half = (x + 1) // 2\n            outcomes = [(0, 0, x)]\n            if op1 >= 1:\n                outcomes.append((1, 0, half))\n            if op2 >= 1 and x >= k:\n                outcomes.append((0, 1, x - k))\n            if op1 >= 1 and op2 >= 1:\n                both = INF\n                if x >= k:\n                    # subtract k first, then halve\n                    both = min(both, (x - k + 1) // 2)\n                if half >= k:\n                    # halve first, then subtract k\n                    both = min(both, half - k)\n                if both < INF:\n                    outcomes.append((1, 1, both))\n            new = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n            for a in range(op1 + 1):\n                row = dp[a]\n                for b in range(op2 + 1):\n                    cur = row[b]\n                    if cur == INF:\n                        continue\n                    for da, db, val in outcomes:\n                        na = a + da\n                        nb = b + db\n                        if na <= op1 and nb <= op2:\n                            t = cur + val\n                            if t < new[na][nb]:\n                                new[na][nb] = t\n            dp = new\n        return int(min(min(row) for row in dp))\n"}

