TOOL submit_solution {"ticket_id": "Q-1940", "code": "from typing import List\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        INF = float('inf')\n        A = op1\n        B = op2\n        # dp[a][b] = minimum sum so far using exactly a op1's and b op2's\n        dp = [[INF] * (B + 1) for _ in range(A + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            h = (x + 1) // 2  # ceil(x / 2)\n            # Possible options for this element: (cost value, op1 used, op2 used)\n            options = [(x, 0, 0), (h, 1, 0)]\n            if x >= k:\n                options.append((x - k, 0, 1))\n                # apply op1 then op2\n                if h >= k:\n                    options.append((h - k, 1, 1))\n                # apply op2 then op1\n                options.append(((x - k + 1) // 2, 1, 1))\n            new = [[INF] * (B + 1) for _ in range(A + 1)]\n            for a in range(A + 1):\n                row = dp[a]\n                for b in range(B + 1):\n                    cur = row[b]\n                    if cur == INF:\n                        continue\n                    for val, da, db in options:\n                        na = a + da\n                        nb = b + db\n                        if na <= A and nb <= B:\n                            v = cur + val\n                            if v < new[na][nb]:\n                                new[na][nb] = v\n            dp = new\n        return min(min(row) for row in dp)\n"}

