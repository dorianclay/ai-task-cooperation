class Solution:
    def countWinningSequences(self, s: str) -> int:


=== MODEL ===
This is a DP: state = (position, Bob's previous move, score difference Bob−Alice). The score difference ranges over [-n, n], so it's O(n·3·(2n+1)) states with 2 transitions each — fine for n=1000.

Bob's move beats Alice's per the rules: Bob's move `b` gets a point against Alice's `a` if `b` beats `a` (F beats E, W beats F, E beats W). Bob's point is awarded when Bob beats Alice; Alice gets a point when Alice beats Bob.
TOOL submit_solution {"ticket_id": "T-7111", "code": "class Solution:\n    def countWinningSequences(self, s: str) -> int:\n        MOD = 10**9 + 7\n        n = len(s)\n        # Moves: F=0, W=1, E=2. X beats Y:\n        # F beats E, W beats F, E beats W.\n        beats = {0: 2, 1: 0, 2: 1}  # beats[x] = the move that x beats\n        idx = {'F': 0, 'W': 1, 'E': 2}\n        alice = [idx[c] for c in s]\n        OFF = n\n        size = 2 * n + 1\n        # dp[prev][diff+OFF], prev in 0..2 for Bob's previous move; prev=3 means none\n        dp = [[0] * size for _ in range(4)]\n        dp[3][OFF] = 1\n        for i in range(n):\n            a = alice[i]\n            ndp = [[0] * size for _ in range(4)]\n            for prev in range(4):\n                row = dp[prev]\n                for d in range(size):\n                    v = row[d]\n                    if not v:\n                        continue\n                    for b in range(3):\n                        if b == prev:\n                            continue\n                        nd = d\n                        if beats[b] == a:\n                            nd += 1  # Bob point\n                        elif beats[a] == b:\n                            nd -= 1  # Alice point\n                        ndp[b][nd] = (ndp[b][nd] + v) % MOD\n            dp = ndp\n        ans = 0\n        for prev in range(3):\n            for d in range(OFF + 1, size):\n                ans = (ans + dp[prev][d]) % MOD\n        return ans\n"}

