TOOL submit_solution {"ticket_id": "Q-6050", "code": "from typing import List\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        n = len(startTime)\n        # gaps[0..n]: free time before meeting 0, between meetings, and after the last meeting\n        gaps = []\n        prev_end = 0\n        for i in range(n):\n            gaps.append(startTime[i] - prev_end)\n            prev_end = endTime[i]\n        gaps.append(eventTime - prev_end)\n        # choose a window of k+1 consecutive gaps (the k meetings between them are moved away)\n        w = min(k + 1, len(gaps))\n        window = sum(gaps[:w])\n        best = window\n        for i in range(w, len(gaps)):\n            window += gaps[i] - gaps[i - w]\n            if window > best:\n                best = window\n        return best\n"}

