TOOL submit_solution {"ticket_id": "Q-2737", "code": "from typing import List\n\nclass Solution:\n    def maximizeSumOfWeights(self, edges: List[List[int]], k: int) -> int:\n        n = len(edges) + 1\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        # iterative DFS order from root 0\n        parent = [-1] * n\n        parent_w = [0] * n\n        order = []\n        visited = [False] * n\n        stack = [0]\n        visited[0] = True\n        while stack:\n            u = stack.pop()\n            order.append(u)\n            for v, w in adj[u]:\n                if not visited[v]:\n                    visited[v] = True\n                    parent[v] = u\n                    parent_w[v] = w\n                    stack.append(v)\n\n        # dp0[u]: best in subtree of u where u keeps at most k child edges\n        # dp1[u]: best in subtree of u where u keeps at most k-1 child edges (parent edge can be kept)\n        dp0 = [0] * n\n        dp1 = [0] * n\n        for u in reversed(order):\n            base = 0\n            gains = []\n            for v, w in adj[u]:\n                if v == parent[u]:\n                    continue\n                base += dp0[v]\n                g = dp1[v] + w - dp0[v]\n                if g > 0:\n                    gains.append(g)\n            gains.sort(reverse=True)\n            s0 = sum(gains[:k])\n            s1 = sum(gains[:k - 1]) if k - 1 > 0 else 0\n            dp0[u] = base + s0\n            dp1[u] = base + s1\n\n        return dp0[0]\n"}

