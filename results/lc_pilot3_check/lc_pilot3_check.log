TOOL submit_solution {"ticket_id": "T-6184", "code": "class Solution:\n    def minMaxSubarraySum(self, nums: List[int], k: int) -> int:\n        def G(N):\n            # number of (p, q) with p, q >= 0 and p + q <= N\n            if N < 0:\n                return 0\n            return (N + 1) * (N + 2) // 2\n\n        def max_sum(arr):\n            n = len(arr)\n            K = k - 1\n            left = [-1] * n\n            right = [n] * n\n            stack = []\n            # left: previous index with value >= arr[i]\n            for i in range(n):\n                while stack and arr[stack[-1]] < arr[i]:\n                    stack.pop()\n                left[i] = stack[-1] if stack else -1\n                stack.append(i)\n            stack = []\n            # right: next index with value > arr[i]\n            for i in range(n - 1, -1, -1):\n                while stack and arr[stack[-1]] <= arr[i]:\n                    stack.pop()\n                right[i] = stack[-1] if stack else n\n                stack.append(i)\n            total = 0\n            for i in range(n):\n                A = i - left[i]   # choices for left endpoint\n                B = right[i] - i  # choices for right endpoint\n                cnt = G(K) - G(K - A) - G(K - B) + G(K - A - B)\n                total += arr[i] * cnt\n            return total\n\n        # sum of max + sum of min = sum of max(nums) - sum of max(-nums)\n        return max_sum(nums) - max_sum([-x for x in nums])\n"}

