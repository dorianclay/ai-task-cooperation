se\n            return caseB(d) or caseA(d)\n\n        lo, hi = D0, 10 ** 9\n        while lo < hi:\n            mid = (lo + hi) // 2\n            if feasible(mid):\n                hi = mid\n            else:\n                lo = mid + 1\n        return lo\n"}

