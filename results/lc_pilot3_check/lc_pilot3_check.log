TOOL submit_solution {"ticket_id": "Q-2078", "code": "from typing import List\n\nclass Solution:\n    def sortMatrix(self, grid: List[List[int]]) -> List[List[int]]:\n        n = len(grid)\n        res = [row[:] for row in grid]\n        # Diagonal d = i - j. Positions on diagonal d, in order of increasing i.\n        for d in range(-(n - 1), n):\n            cells = []\n            i = max(d, 0)\n            j = i - d\n            while i < n and j < n:\n                cells.append((i, j))\n                i += 1\n                j += 1\n            vals = [grid[a][b] for a, b in cells]\n            if d >= 0:\n                # bottom-left triangle (including main diagonal): non-increasing\n                vals.sort(reverse=True)\n            else:\n                # top-right triangle: non-decreasing\n                vals.sort()\n            for (a, b), v in zip(cells, vals):\n                res[a][b] = v\n        return res\n"}

