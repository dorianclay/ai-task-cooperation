TOOL submit_solution {"ticket_id": "Q-3627", "code": "from typing import List\n\nclass Solution:\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\n        seq = []\n        for i, row in enumerate(grid):\n            if i % 2 == 0:\n                seq.extend(row)\n            else:\n                seq.extend(reversed(row))\n        return seq[::2]\n"}

