TOOL submit_solution {"ticket_id": "T-2469", "code": "from typing import List\n\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # Normalize pairs as (a, b) with a < b, grouped by b.\n        by_b = [[] for _ in range(n + 1)]\n        for idx, (x, y) in enumerate(conflictingPairs):\n            a, b = min(x, y), max(x, y)\n            by_b[b].append((a, idx))\n\n        m = len(conflictingPairs)\n        add = [0] * m  # gain in count when pair idx is removed\n\n        # top two (value, id) among pairs with right endpoint <= r\n        v1, id1 = 0, -1\n        v2, id2 = 0, -1\n        base = 0\n        for r in range(1, n + 1):\n            for a, idx in by_b[r]:\n                if a > v1:\n                    v2, id2 = v1, id1\n                    v1, id1 = a, idx\n                elif a > v2:\n                    v2, id2 = a, idx\n            # subarrays ending at r with no conflicting pair, given all pairs\n            base += r - v1\n            if id1 != -1:\n                add[id1] += v1 - v2\n\n        return base + max(add)\n"}

