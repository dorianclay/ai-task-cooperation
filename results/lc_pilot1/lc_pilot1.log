TOOL submit_solution {"ticket_id": "Q-5431", "code": "from typing import List\n\nMOD = 10**9 + 7\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        nums = sorted(nums)\n\n        # factorials for binomial coefficients\n        fact = [1] * (n + 1)\n        for i in range(1, n + 1):\n            fact[i] = fact[i - 1] * i % MOD\n        inv_fact = [1] * (n + 1)\n        inv_fact[n] = pow(fact[n], MOD - 2, MOD)\n        for i in range(n, 0, -1):\n            inv_fact[i - 1] = inv_fact[i] * i % MOD\n\n        def C(a, b):\n            if b < 0 or b > a:\n                return 0\n            return fact[a] * inv_fact[b] % MOD * inv_fact[a - b] % MOD\n\n        # f(m) = sum_{t=0}^{k-1} C(m, t): number of ways to pick up to k-1 extra\n        # elements from m available elements\n        def f(m):\n            return sum(C(m, t) for t in range(k)) % MOD\n\n        total = 0\n        for i in range(n):\n            # nums[i] as maximum: extra elements come from indices < i\n            # nums[i] as minimum: extra elements come from indices > i\n            total = (total + nums[i] * (f(i) + f(n - 1 - i))) % MOD\n        return total % MOD\n"}

