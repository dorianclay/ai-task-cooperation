TOOL submit_solution {"ticket_id": "Q-4894", "code": "from typing import List\nfrom fractions import Fraction\nfrom collections import defaultdict\n\nclass Solution:\n    def separateSquares(self, squares: List[List[int]]) -> float:\n        # Sweep over y: width of union-by-sum (overlaps counted) changes only at square edges.\n        delta = defaultdict(int)\n        for x, y, l in squares:\n            delta[y] += l\n            delta[y + l] -= l\n        keys = sorted(delta)\n\n        # Build segments: (y1, y2, width)\n        segments = []\n        w = 0\n        for i in range(len(keys) - 1):\n            w += delta[keys[i]]\n            segments.append((keys[i], keys[i + 1], w))\n\n        total = sum(w * (y2 - y1) for y1, y2, w in segments)\n\n        # Find smallest y where area below equals total/2.\n        A = 0  # area below y1\n        for y1, y2, w in segments:\n            seg_area = w * (y2 - y1)\n            if 2 * (A + seg_area) >= total:\n                # w > 0 here, since we haven't reached half yet and this segment reaches it\n                ans = Fraction(y1) + Fraction(total - 2 * A, 2 * w)\n                return float(ans)\n            A += seg_area\n        return float(keys[-1])\n"}

