TOOL submit_solution {"ticket_id": "Q-7649", "code": "from bisect import bisect_left\n\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n        A, B, C = p.split('*')\n\n        def occurrences(pat):\n            # Returns sorted list of start positions of pat in s (pat non-empty).\n            res = []\n            i = s.find(pat)\n            while i != -1:\n                res.append(i)\n                i = s.find(pat, i + 1)\n            return res\n\n        occB = occurrences(B) if B else None\n        occC = occurrences(C) if C else None\n\n        def first_at_or_after(pat, occ, x):\n            if not pat:\n                return x if x <= n else None\n            i = bisect_left(occ, x)\n            return occ[i] if i < len(occ) else None\n\n        if A:\n            starts = occurrences(A)\n        else:\n            starts = range(n + 1)\n\n        best = -1\n        for i in starts:\n            q = first_at_or_after(B, occB, i + len(A))\n            if q is None:\n                continue\n            r = first_at_or_after(C, occC, q + len(B))\n            if r is None:\n                continue\n            length = r + len(C) - i\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

