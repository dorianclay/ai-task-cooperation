TOOL submit_solution {"ticket_id": "Q-6630", "code": "from typing import List\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        # From each row, the best possible picks are its largest values, up to its limit.\n        candidates = []\n        for row, lim in zip(grid, limits):\n            if lim <= 0:\n                continue\n            top = sorted(row, reverse=True)[:lim]\n            candidates.extend(top)\n        # Values are non-negative, so picking the k largest overall is optimal.\n        candidates.sort(reverse=True)\n        return sum(candidates[:k])\n"}

