TOOL submit_solution {"ticket_id": "Q-7131", "code": "from typing import List\nfrom collections import Counter\n\nclass Solution:\n    def totalNumbers(self, digits: List[int]) -> int:\n        cnt = Counter(digits)\n        result = 0\n        for h in range(1, 10):\n            if cnt[h] == 0:\n                continue\n            cnt[h] -= 1\n            for t in range(10):\n                if cnt[t] == 0:\n                    continue\n                cnt[t] -= 1\n                for u in range(0, 10, 2):\n                    if cnt[u] > 0:\n                        result += 1\n                cnt[t] += 1\n            cnt[h] += 1\n        return result\n"}

