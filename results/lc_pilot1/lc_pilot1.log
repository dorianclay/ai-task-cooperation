class Solution:
    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:


=== MODEL ===
Approach: sort indices by nums1, process groups of equal nums1 values in ascending order. Before handling a group, answer its members using the structure containing all strictly smaller values. The structure maintains the top-k sum of a growing multiset, using a min-heap of size k plus a running sum.
TOOL submit_solution {"ticket_id": "T-2407", "code": "from typing import List\nimport heapq\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        n = len(nums1)\n        order = sorted(range(n), key=lambda i: nums1[i])\n        ans = [0] * n\n        heap = []  # min-heap of the top-k nums2 values seen so far\n        total = 0\n        i = 0\n        while i < n:\n            j = i\n            # group of equal nums1 values\n            while j < n and nums1[order[j]] == nums1[order[i]]:\n                j += 1\n            # answer for group using only strictly smaller values inserted so far\n            for t in range(i, j):\n                ans[order[t]] = total\n            # insert group's values\n            for t in range(i, j):\n                v = nums2[order[t]]\n                if len(heap) < k:\n                    heapq.heappush(heap, v)\n                    total += v\n                elif v > heap[0]:\n                    total += v - heapq.heappushpop(heap, v)\n            i = j\n        return ans\n"}

