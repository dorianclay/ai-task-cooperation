TOOL submit_solution {"ticket_id": "Q-2469", "code": "from typing import List\n\nclass Solution:\n    def maxSubarrays(self, n: int, conflictingPairs: List[List[int]]) -> int:\n        # normalize pairs\n        pairs = [(min(a, b), max(a, b)) for a, b in conflictingPairs]\n\n        # for each right endpoint b, track the largest and second largest 'a' values\n        # (with the index of the largest) among pairs whose larger element is b\n        top1 = [0] * (n + 1)   # largest a for pairs ending at b\n        top1_idx = [-1] * (n + 1)\n        top2 = [0] * (n + 1)   # second largest a for pairs ending at b\n\n        for idx, (a, b) in enumerate(pairs):\n            if a > top1[b]:\n                top2[b] = top1[b]\n                top1[b] = a\n                top1_idx[b] = idx\n            elif a > top2[b]:\n                top2[b] = a\n\n        # base: for each r, best[r] = max over b<=r of top1[b] (prefix max of 'a' with b<=r)\n        # gain[idx] accumulates how many subarrays are freed if pair idx is removed\n        base = 0\n        gain = [0] * len(pairs)\n        cur_best = 0      # best left bound so far\n        cur_idx = -1      # index of the pair achieving cur_best\n        cur_second = 0    # second best left bound among pairs with b<=r (from different pair)\n\n        for r in range(1, n + 1):\n            # update with pairs whose larger element is r\n            if top1[r] > cur_best:\n                # new best comes from pair ending at r\n                cur_second = max(cur_best, top2[r])\n                cur_best = top1[r]\n                cur_idx = top1_idx[r]\n            else:\n                cur_second = max(cur_second, top1[r])\n            base += r - cur_best\n            # if the unique maximizer is pair cur_idx, removing it lets the bound fall to cur_second\n            if cur_idx >= 0:\n                gain[cur_idx] += cur_best - cur_second\n\n        return base + max(gain) if pairs else base + 0\n"}

