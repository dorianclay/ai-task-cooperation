TOOL submit_solution {"ticket_id": "Q-7649", "code": "from bisect import bisect_left\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        i = p.index('*')\n        j = p.index('*', i + 1)\n        a = p[:i]\n        b = p[i + 1:j]\n        c = p[j + 1:]\n        n = len(s)\n\n        def find_all(pat):\n            # returns sorted start positions of all occurrences of pat in s (overlapping)\n            m = len(pat)\n            if m == 0:\n                return list(range(n + 1))\n            fail = [0] * m\n            k = 0\n            for q in range(1, m):\n                while k and pat[q] != pat[k]:\n                    k = fail[k - 1]\n                if pat[q] == pat[k]:\n                    k += 1\n                fail[q] = k\n            res = []\n            k = 0\n            for idx, ch in enumerate(s):\n                while k and ch != pat[k]:\n                    k = fail[k - 1]\n                if ch == pat[k]:\n                    k += 1\n                if k == m:\n                    res.append(idx - m + 1)\n                    k = fail[k - 1]\n            return res\n\n        A = find_all(a)\n        B = find_all(b)\n        C = find_all(c)\n        if not A or not B or not C:\n            return -1\n        la, lb, lc = len(a), len(b), len(c)\n        best = -1\n        for x in A:\n            yi = bisect_left(B, x + la)\n            if yi >= len(B):\n                continue\n            y = B[yi]\n            zi = bisect_left(C, y + lb)\n            if zi >= len(C):\n                continue\n            z = C[zi]\n            length = z + lc - x\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

