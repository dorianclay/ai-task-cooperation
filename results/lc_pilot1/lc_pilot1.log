TOOL submit_solution {"ticket_id": "Q-3554", "code": "from typing import List\n\n\nclass Solution:\n    def maxDistance(self, side: int, points: List[List[int]], k: int) -> int:\n        def perim(x, y):\n            if y == 0:\n                return x\n            if x == side:\n                return side + y\n            if y == side:\n                return 3 * side - x\n            return 4 * side - y\n\n        pts = sorted((perim(x, y), x, y) for x, y in points)\n        pts = [(x, y) for _, x, y in pts]\n        n = len(pts)\n\n        def man(a, b):\n            return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n        def check(d):\n            # Try every start point; greedily pick points in cyclic perimeter\n            # order that are at Manhattan distance >= d from all chosen ones.\n            for s in range(n):\n                first = pts[s]\n                chosen = [first]\n                for step in range(1, n):\n                    if len(chosen) == k:\n                        break\n                    idx = (s + step) % n\n                    p = pts[idx]\n                    ok = True\n                    for q in chosen:\n                        if man(p, q) < d:\n                            ok = False\n                            break\n                    if ok:\n                        chosen.append(p)\n                if len(chosen) == k:\n                    return True\n            return False\n\n        lo, hi = 0, 2 * side\n        while lo < hi:\n            mid = (lo + hi + 1) // 2\n            if check(mid):\n                lo = mid\n            else:\n                hi = mid - 1\n        return lo\n"}

