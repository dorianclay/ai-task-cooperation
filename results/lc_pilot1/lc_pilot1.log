TOOL submit_solution {"ticket_id": "Q-2347", "code": "from collections import defaultdict\nfrom typing import List\n\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # dp[(parity, altsum)] = set of achievable products (<= limit) for\n        # non-empty subsequences. parity 0 means the next picked element\n        # is added (even index), parity 1 means it is subtracted (odd index).\n        dp = defaultdict(set)\n        for x in nums:\n            snapshot = [(key, list(vals)) for key, vals in dp.items()]\n            new_dp = defaultdict(set)\n            for key, vals in dp.items():\n                for k2 in ():\n                    pass\n            # carry over states where x is skipped\n            for key, vals in snapshot:\n                new_dp[key] |= set(vals)\n            # extend existing subsequences with x\n            for (p, s), vals in snapshot:\n                ns = s + x if p == 0 else s - x\n                np_ = 1 - p\n                for q in vals:\n                    nq = q * x\n                    if nq <= limit:\n                        new_dp[(np_, ns)].add(nq)\n            # start a new subsequence with x at index 0\n            if x <= limit:\n                new_dp[(1, x)].add(x)\n            dp = new_dp\n\n        best = -1\n        for (p, s), vals in dp.items():\n            if s == k:\n                for q in vals:\n                    if q <= limit and q > best:\n                        best = q\n        return best\n"}

