TOOL submit_solution {"ticket_id": "Q-5431", "code": "from typing import List\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        MOD = 10**9 + 7\n        a = sorted(nums)\n        n = len(a)\n        # Singletons: min == max == a[i]\n        total = 2 * sum(a) % MOD\n        if k < 2 or n < 2:\n            return total % MOD\n\n        # Factorials for binomials\n        fact = [1] * (n + 1)\n        for i in range(1, n + 1):\n            fact[i] = fact[i - 1] * i % MOD\n        ifact = [1] * (n + 1)\n        ifact[n] = pow(fact[n], MOD - 2, MOD)\n        for i in range(n, 0, -1):\n            ifact[i - 1] = ifact[i] * i % MOD\n\n        def C(m, r):\n            if r < 0 or r > m:\n                return 0\n            return fact[m] * ifact[r] % MOD * ifact[m - r] % MOD\n\n        # For a pair (j < i) with min a[j], max a[i], and t extra elements chosen\n        # from the d = i-j-1 indices strictly between them (t in 0..k-2), the\n        # contribution is (a[i] + a[j]) * C(d, t).\n        # sum_{j<i} C(i-j-1, t) = C(i, t+1)  (hockey stick)\n        # P[t] tracks sum_{j<i} a[j] * C(i-1-j, t), updated per i.\n        T = k - 1  # t in 0..k-2\n        P = [0] * T\n        for i in range(n):\n            ai = a[i] % MOD\n            acc = 0\n            for t in range(T):\n                acc += ai * C(i, t + 1) + P[t]\n            total = (total + acc) % MOD\n            # update P to P_t(i+1) = P_t(i) + P_{t-1}(i) + a[i]*[t==0]\n            for t in range(T - 1, -1, -1):\n                v = P[t]\n                if t > 0:\n                    v += P[t - 1]\n                else:\n                    v += ai\n                P[t] = v % MOD\n        return total % MOD\n"}

