TOOL submit_solution {"ticket_id": "Q-3850", "code": "from typing import List\n\nclass Solution:\n    def minimumPairRemoval(self, nums: List[int]) -> int:\n        arr = list(nums)\n        ops = 0\n\n        def is_sorted(a):\n            return all(a[i] <= a[i + 1] for i in range(len(a) - 1))\n\n        while not is_sorted(arr):\n            best_idx = 0\n            best_sum = arr[0] + arr[1]\n            for i in range(1, len(arr) - 1):\n                s = arr[i] + arr[i + 1]\n                if s < best_sum:\n                    best_sum = s\n                    best_idx = i\n            arr[best_idx:best_idx + 2] = [best_sum]\n            ops += 1\n        return ops\n"}

