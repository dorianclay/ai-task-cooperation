TOOL submit_solution {"ticket_id": "T-1232", "code": "from typing import List\n\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        dist = [0] * n\n        pathDist = [0] * (n + 1)  # distance from root of ancestor at each depth\n        last = {}  # value -> depth of most recent node with this value on path\n        saved_L = [0] * n\n        saved_old = [-1] * n\n\n        best_len, best_nodes = 0, 1\n        L = 0  # smallest allowed start depth for current node's window\n\n        # stack entries: (node, parent, depth, is_exit)\n        stack = [(0, -1, 0, False)]\n        while stack:\n            u, p, d, is_exit = stack.pop()\n            if is_exit:\n                v = nums[u]\n                old = saved_old[u]\n                if old == -1:\n                    del last[v]\n                else:\n                    last[v] = old\n                L = saved_L[u]\n                continue\n\n            # enter u at depth d\n            pathDist[d] = dist[u]\n            v = nums[u]\n            old = last.get(v, -1)\n            saved_L[u] = L\n            saved_old[u] = old\n            last[v] = d\n            if old + 1 > L:\n                L = old + 1\n\n            length = dist[u] - pathDist[L]\n            nodes = d - L + 1\n            if length > best_len or (length == best_len and nodes < best_nodes):\n                best_len, best_nodes = length, nodes\n\n            stack.append((u, p, d, True))\n            for c, w in adj[u]:\n                if c != p:\n                    dist[c] = dist[u] + w\n                    stack.append((c, u, d + 1, False))\n\n        return [best_len, best_nodes]\n"}

