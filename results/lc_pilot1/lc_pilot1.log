TOOL submit_solution {"ticket_id": "Q-6341", "code": "from typing import List\n\nclass Solution:\n    def minCost(self, n: int, cost: List[List[int]]) -> int:\n        INF = float(\"inf\")\n        half = n // 2\n        # Pair house i (left) with house n-1-i (right). Each pair gets colors (a, b), a != b\n        # (they are equidistant from the ends so must differ).\n        pairs = [(a, b) for a in range(3) for b in range(3) if a != b]\n        dp = {}\n        for a, b in pairs:\n            dp[(a, b)] = cost[0][a] + cost[n - 1][b]\n        for i in range(1, half):\n            new = {}\n            for a, b in pairs:\n                best = INF\n                for pa, pb in pairs:\n                    # adjacent left houses (i-1, i) and right houses (n-i, n-1-i) must differ\n                    if pa != a and pb != b:\n                        v = dp[(pa, pb)]\n                        if v < best:\n                            best = v\n                new[(a, b)] = best + cost[i][a] + cost[n - 1 - i][b]\n            dp = new\n        return int(min(dp.values()))\n"}

