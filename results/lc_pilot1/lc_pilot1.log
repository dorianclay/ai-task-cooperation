TOOL submit_solution {"ticket_id": "T-1023", "code": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        x = y = 0\n        best = 0\n        for i, c in enumerate(s):\n            if c == 'N':\n                y += 1\n            elif c == 'S':\n                y -= 1\n            elif c == 'E':\n                x += 1\n            elif c == 'W':\n                x -= 1\n            dist = abs(x) + abs(y)\n            best = max(best, min(dist + 2 * k, i + 1))\n        return best\n"}

