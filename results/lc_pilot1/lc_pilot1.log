TOOL submit_solution {"ticket_id": "T-3523", "code": "from typing import List\n\nclass Solution:\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\n        INF = float(\"inf\")\n        max_g = max(groups)\n\n        # For each distinct element value, keep the smallest index where it occurs.\n        first_idx = {}\n        for j, e in enumerate(elements):\n            if e not in first_idx:\n                first_idx[e] = j\n\n        # best[v] = smallest index j such that elements[j] divides v\n        best = [INF] * (max_g + 1)\n        for d, idx in first_idx.items():\n            if d > max_g:\n                continue\n            for m in range(d, max_g + 1, d):\n                if idx < best[m]:\n                    best[m] = idx\n\n        return [best[g] if best[g] != INF else -1 for g in groups]\n"}

