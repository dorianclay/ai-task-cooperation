TOOL submit_solution {"ticket_id": "Q-5556", "code": "class Solution:\n    def minCostGoodCaption(self, caption: str) -> str:\n        n = len(caption)\n        if n < 3:\n            return \"\"\n        INF = float('inf')\n        s = [ord(ch) - 97 for ch in caption]\n\n        # dp[i] = (cost, string) for prefix of length i ending at a run boundary\n        # Transition: append a run of length L>=3 of letter c covering positions [i, i+L)\n        # Cost = sum |s[j]-c|. Use prefix sums per letter for run cost.\n        pref = [[0] * (n + 1) for _ in range(26)]\n        for c in range(26):\n            p = pref[c]\n            for j in range(n):\n                p[j + 1] = p[j] + abs(s[j] - c)\n\n        dp_cost = [INF] * (n + 1)\n        dp_str = [None] * (n + 1)\n        dp_cost[0] = 0\n        dp_str[0] = \"\"\n\n        for i in range(n):\n            if dp_cost[i] == INF:\n                continue\n            for c in range(26):\n                p = pref[c]\n                ch = chr(97 + c)\n                for L in range(3, n - i + 1):\n                    end = i + L\n                    cost = dp_cost[i] + p[end] - p[i]\n                    if cost < dp_cost[end]:\n                        dp_cost[end] = cost\n                        dp_str[end] = dp_str[i] + ch * L\n                    elif cost == dp_cost[end]:\n                        cand = dp_str[i] + ch * L\n                        if cand < dp_str[end]:\n                            dp_str[end] = cand\n                # Note: large L transitions are needed; tiebreak handled above.\n\n        if dp_cost[n] == INF:\n            return \"\"\n        return dp_str[n]\n"}

