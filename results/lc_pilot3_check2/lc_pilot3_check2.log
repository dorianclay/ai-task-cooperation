TOOL submit_solution {"ticket_id": "Q-1885", "code": "from typing import List\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int, numOperations: int) -> int:\n        M = max(nums)\n        cnt = [0] * (M + 2)\n        for v in nums:\n            cnt[v] += 1\n        # prefix sums: P[x] = number of elements with value <= x\n        P = [0] * (M + 2)\n        for x in range(1, M + 1):\n            P[x] = P[x - 1] + cnt[x]\n\n        best = 0\n        # A target value t (optimal t can always be taken within [min, max] of nums).\n        for t in range(1, M + 1):\n            lo = max(1, t - k)\n            hi = min(M, t + k)\n            in_range = P[hi] - P[lo - 1]\n            eq = cnt[t]\n            # elements equal to t need no operation; others in range need one each\n            freq = eq + min(numOperations, in_range - eq)\n            if freq > best:\n                best = freq\n        return best\n"}

