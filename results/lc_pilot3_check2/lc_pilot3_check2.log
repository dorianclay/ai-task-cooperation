TOOL submit_solution {"ticket_id": "Q-9008", "code": "import heapq\n\nclass Solution:\n    def minOperations(self, n: int, m: int) -> int:\n        s = str(n)\n        k = len(s)\n        limit = 10 ** k\n        # sieve\n        is_prime = [True] * limit\n        is_prime[0] = False\n        if limit > 1:\n            is_prime[1] = False\n        i = 2\n        while i * i < limit:\n            if is_prime[i]:\n                for j in range(i * i, limit, i):\n                    is_prime[j] = False\n            i += 1\n\n        if is_prime[n] or is_prime[m]:\n            return -1\n        if n == m:\n            return n\n\n        def digits(x):\n            return [(x // (10 ** p)) % 10 for p in range(k - 1, -1, -1)]\n\n        def num(d):\n            v = 0\n            for x in d:\n                v = v * 10 + x\n            return v\n\n        dist = {n: n}\n        heap = [(n, n)]\n        while heap:\n            cost, u = heapq.heappop(heap)\n            if cost > dist.get(u, float('inf')):\n                continue\n            if u == m:\n                return cost\n            d = digits(u)\n            for p in range(k):\n                place = 10 ** (k - 1 - p)\n                for delta in (1, -1):\n                    nd = d[p] + delta\n                    if 0 <= nd <= 9:\n                        v = u + delta * place\n                        if is_prime[v]:\n                            continue\n                        nc = cost + v\n                        if nc < dist.get(v, float('inf')):\n                            dist[v] = nc\n                            heapq.heappush(heap, (nc, v))\n        return -1\n"}

