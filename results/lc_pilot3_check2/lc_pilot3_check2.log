TOOL submit_solution {"ticket_id": "Q-9008", "code": "import heapq\n\nclass Solution:\n    def minOperations(self, n: int, m: int) -> int:\n        LIMIT = 10000\n        is_prime = [True] * LIMIT\n        is_prime[0] = is_prime[1] = False\n        for i in range(2, int(LIMIT ** 0.5) + 1):\n            if is_prime[i]:\n                for j in range(i * i, LIMIT, i):\n                    is_prime[j] = False\n\n        if is_prime[n] or is_prime[m]:\n            return -1\n        if n == m:\n            return n\n\n        L = len(str(n))\n        # Dijkstra; cost of a path = sum of values of all visited states (including start)\n        dist = {n: n}\n        heap = [(n, n)]\n        while heap:\n            d, cur = heapq.heappop(heap)\n            if cur == m:\n                return d\n            if dist.get(cur, float('inf')) < d:\n                continue\n            digits = [(cur // 10 ** (L - 1 - p)) % 10 for p in range(L)]\n            for p in range(L):\n                place = 10 ** (L - 1 - p)\n                for delta in (1, -1):\n                    nd = digits[p] + delta\n                    if 0 <= nd <= 9:\n                        nxt = cur + delta * place\n                        if is_prime[nxt]:\n                            continue\n                        nd_cost = d + nxt\n                        if nd_cost < dist.get(nxt, float('inf')):\n                            dist[nxt] = nd_cost\n                            heapq.heappush(heap, (nd_cost, nxt))\n        return -1\n"}

