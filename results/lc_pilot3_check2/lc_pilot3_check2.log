TOOL submit_solution {"ticket_id": "T-9200", "code": "from typing import List\n\nclass Solution:\n    def longestSpecialPath(self, edges: List[List[int]], nums: List[int]) -> List[int]:\n        n = len(nums)\n        adj = [[] for _ in range(n)]\n        for u, v, w in edges:\n            adj[u].append((v, w))\n            adj[v].append((u, w))\n\n        best_len = 0\n        best_cnt = 1\n\n        # path stack of (node, prefix_distance) along root-to-current path\n        path_nodes = []\n        path_dist = []\n        last_idx = {}  # value -> index in path of latest occurrence on current path\n        left = 0  # leftmost valid index in the path for a special path ending at current node\n\n        # iterative DFS with enter/exit markers\n        # stack items: (node, parent, edge_weight_to_parent, state, saved_left, saved_prev_idx)\n        stack = [(0, -1, 0, 0)]\n        saved = {}\n        while stack:\n            item = stack.pop()\n            if item[0] == 'exit':\n                _, node, val, prev_idx, prev_left = item\n                path_nodes.pop()\n                path_dist.pop()\n                if prev_idx is None:\n                    del last_idx[val]\n                else:\n                    last_idx[val] = prev_idx\n                left = prev_left\n                continue\n\n            node, parent, w = item\n            c = nums[node]\n            depth = len(path_nodes)\n            base = path_dist[-1] if path_dist else 0\n            dist = base + (w if parent != -1 else 0)\n\n            prev_idx = last_idx.get(c)\n            prev_left = left\n            if prev_idx is not None and prev_idx + 1 > left:\n                left = prev_idx + 1\n\n            path_nodes.append(node)\n            path_dist.append(dist)\n            last_idx[c] = depth\n\n            length = dist - path_dist[left]\n            cnt = depth - left + 1\n            if length > best_len or (length == best_len and cnt < best_cnt):\n                best_len