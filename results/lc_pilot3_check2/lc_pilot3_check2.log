TOOL submit_solution {"ticket_id": "Q-6905", "code": "from typing import List\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        # copy[i] = copy[0] + (original[i] - original[0]); constrain copy[0] per index\n        lo = -float('inf')\n        hi = float('inf')\n        base = original[0]\n        for i, (u, v) in enumerate(bounds):\n            d = original[i] - base\n            lo = max(lo, u - d)\n            hi = min(hi, v - d)\n        if hi < lo:\n            return 0\n        return int(hi - lo + 1)\n"}

