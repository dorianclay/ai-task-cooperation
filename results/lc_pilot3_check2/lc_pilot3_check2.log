TOOL submit_solution {"ticket_id": "Q-2078", "code": "from typing import List\n\nclass Solution:\n    def sortMatrix(self, grid: List[List[int]]) -> List[List[int]]:\n        n = len(grid)\n        # group cells by diagonal d = i - j\n        diags = {}\n        for i in range(n):\n            for j in range(n):\n                diags.setdefault(i - j, []).append((i, j))\n        for d, cells in diags.items():\n            vals = [grid[i][j] for i, j in cells]\n            if d >= 0:\n                # bottom-left triangle including the main diagonal: non-increasing\n                vals.sort(reverse=True)\n            else:\n                # top-right triangle: non-decreasing\n                vals.sort()\n            for (i, j), v in zip(cells, vals):\n                grid[i][j] = v\n        return grid\n"}

