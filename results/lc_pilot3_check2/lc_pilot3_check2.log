TOOL submit_solution {"ticket_id": "T-5023", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # states: (parity of next position, alternating sum) -> set of achievable products <= limit\n        # Start empty subsequence handled specially.\n        # dp[(parity, sum)] = set of products (<= limit) for non-empty subsequences\n        # where parity = length % 2 (0 => next element is added with +, 1 => with -)\n        from collections import defaultdict\n        dp = defaultdict(set)\n        for x in nums:\n            new = defaultdict(set)\n            for (par, s), prods in dp.items():\n                sign = 1 if par == 0 else -1\n                ns = s + sign * x\n                for p in prods:\n                    np_ = p * x\n                    if np_ <= limit:\n                        new[(1 - par, ns)].add(np_)\n            # start a new subsequence with x\n            if x <= limit:\n                new[(1, x)].add(x)\n            for key, vals in new.items():\n                dp[key] |= vals\n        best = -1\n        for (par, s), prods in dp.items():\n            if s == k and prods:\n                best = max(best, max(prods))\n        return best\n"}

