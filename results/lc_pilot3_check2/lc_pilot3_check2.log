TOOL submit_solution {"ticket_id": "Q-1347", "code": "from typing import List\n\nclass Solution:\n    def countNonDecreasingSubarrays(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        a = nums\n        P = [0] * (n + 1)\n        for i in range(n):\n            P[i + 1] = P[i] + a[i]\n        # nx[i]: next strictly greater index, or n\n        nx = [n] * n\n        stack = []\n        for i in range(n):\n            while stack and a[stack[-1]] < a[i]:\n                nx[stack.pop()] = i\n            stack.append(i)\n        # W[i] = cost of segment [i, nx[i]-1] plus W[nx[i]]\n        W = [0] * (n + 1)\n        for i in range(n - 1, -1, -1):\n            j = nx[i]\n            D = (j - i) * a[i] - (P[j] - P[i])\n            W[i] = D + W[j]\n        LOG = max(1, n.bit_length())\n        up = [nx + [n]]\n        for _ in range(1, LOG):\n            prev = up[-1]\n            up.append([prev[prev[i]] for i in range(n + 1)])\n        total = 0\n        for l in range(n):\n            target = W[l] - k\n            cur = l\n            for j in range(LOG - 1, -1, -1):\n                nxt = up[j][cur]\n                if nxt < n and W[nxt] >= target:\n                    cur = nxt\n            rem = k - (W[l] - W[cur])\n            lo, hi_lim = cur, (nx[cur] - 1)\n            # largest r in [lo, hi_lim] with cost(cur..r) <= rem\n            lo_b, hi_b = cur, hi_lim\n            base = a[cur]\n            while lo_b < hi_b:\n                mid = (lo_b + hi_b + 1) // 2\n                cost = (mid - cur + 1) * base - (P[mid + 1] - P[cur])\n                if cost <= rem:\n                    lo_b = mid\n                else:\n                    hi_b = mid - 1\n            total += lo_b - l + 1\n        return total\n"}

