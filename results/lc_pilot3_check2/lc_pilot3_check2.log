TOOL submit_solution {"ticket_id": "Q-1052", "code": "from typing import List\nfrom functools import lru_cache\nfrom itertools import combinations\n\nclass Solution:\n    def minCost(self, nums: List[int]) -> int:\n        n = len(nums)\n\n        @lru_cache(maxsize=None)\n        def dp(start, carry):\n            # carry: tuple of up to two held-back elements from the first positions\n            # remaining = carry + nums[start:]\n            remaining = carry + tuple(nums[start:])\n            if len(remaining) == 0:\n                return 0\n            if len(remaining) < 3:\n                return max(remaining)\n            best = float('inf')\n            first3 = remaining[:3]\n            rest = remaining[3:]\n            for a, b in combinations(range(3), 2):\n                cost = max(first3[a], first3[b])\n                left = tuple(first3[k] for k in range(3) if k not in (a, b))\n                # left is up to one element; continue with it as carry plus rest\n                new_carry = left\n                # rebuild as (carry, start) where rest = nums[newstart:]\n                # rest is a suffix of the original array, so track its start index\n                # index of rest start in nums:\n                best = min(best, cost + dp_rest(new_carry, rest))\n            return best\n\n        # Simpler exact formulation: state = (index into nums, sorted leftover tuple)\n        @lru_cache(maxsize=None)\n        def solve(i, left):\n            # left: tuple of remaining elements carried over (length <= 2), nums[i:] remain after them\n            total_len = len(left) + (n - i)\n            if total_len == 0:\n                return 0\n            if total_len < 3:\n                elems = list(left) + nums[i:]\n                return max(elems)\n            elems = list(left) + nums[i:i + (3 - len(left))]\n            # first three of remaining\n            first3 = elems[:3]\n            new_i = i + max(0, 3 - len(left))\n            best = float('inf')\n            for a, b in combinations(range(3), 2):\n                cost = max(first3[a], first3[b])\n                rem = tuple(first3[k] for k in range(3) if k not in (a, b))\n                best = min(best, cost + solve(new_i, rem))\n            return best\n\n        return solve(0, ())\n"}

