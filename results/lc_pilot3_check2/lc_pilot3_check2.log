TOOL submit_solution {"ticket_id": "Q-1878", "code": "from typing import List\n\nclass Solution:\n    def countComponents(self, nums: List[int], threshold: int) -> int:\n        t = threshold\n        present = [False] * (t + 1)\n        isolated = 0\n        for v in nums:\n            if v <= t:\n                present[v] = True\n            else:\n                isolated += 1  # any value above threshold has no edges\n\n        parent = list(range(t + 1))\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a, b):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[ra] = rb\n                return True\n            return False\n\n        # two values a, b are adjacent iff both divide some L <= t (then lcm(a,b) | L <= t).\n        # For each L <= t, union all present divisors of L.\n        rep = [0] * (t + 1)  # first present divisor seen for each L (0 = none)\n        for d in range(1, t + 1):\n            if not present[d]:\n                continue\n            for L in range(d, t + 1, d):\n                if rep[L] == 0:\n                    rep[L] = d\n                else:\n                    union(rep[L], d)\n\n        roots = set()\n        for d in range(1, t + 1):\n            if present[d]:\n                roots.add(find(d))\n        return isolated + len(roots)\n"}

