TOOL submit_solution {"ticket_id": "Q-4168", "code": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        x = y = 0\n        best = 0\n        for i, c in enumerate(s):\n            if c == 'N':\n                y += 1\n            elif c == 'S':\n                y -= 1\n            elif c == 'E':\n                x += 1\n            else:\n                x -= 1\n            # Each allowed change can add at most 2 to the distance, and never beyond i+1 moves\n            d = abs(x) + abs(y)\n            cand = min(d + 2 * k, i + 1)\n            if cand > best:\n                best = cand\n        return best\n"}

