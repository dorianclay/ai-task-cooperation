TOOL submit_solution {"ticket_id": "T-1940", "code": "from typing import List\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        INF = float('inf')\n        # dp[a][b] = min sum so far using a op1s and b op2s\n        dp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            ndp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n            h = (x + 1) // 2  # ceil(x/2)\n            # options: (cost value, uses op1, uses op2)\n            options = [(x, 0, 0), (h, 1, 0)]\n            if x >= k:\n                options.append((x - k, 0, 1))\n                # both orders\n                if h >= k:\n                    options.append((h - k, 1, 1))\n                # op2 then op1\n                options.append(((x - k + 1) // 2, 1, 1))\n            for a in range(op1 + 1):\n                for b in range(op2 + 1):\n                    cur = dp[a][b]\n                    if cur == INF:\n                        continue\n                    for val, da, db in options:\n                        na, nb = a + da, b + db\n                        if na <= op1 and nb <= op2:\n                            if cur + val < ndp[na][nb]:\n                                ndp[na][nb] = cur + val\n            dp = ndp\n        return min(min(row) for row in dp)\n"}

