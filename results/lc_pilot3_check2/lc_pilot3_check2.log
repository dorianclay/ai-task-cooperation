TOOL submit_solution {"ticket_id": "Q-5436", "code": "from typing import List\n\nclass Solution:\n    def shiftDistance(self, s: str, t: str, nextCost: List[int], previousCost: List[int]) -> int:\n        # Doubled arrays for wrap-around range sums\n        n26 = 26\n        nxt2 = nextCost + nextCost\n        prv2 = previousCost + previousCost\n        # pn[k] = sum of nextCost over doubled indices [0, k)\n        pn = [0] * (2 * n26 + 1)\n        pp = [0] * (2 * n26 + 1)\n        for k in range(2 * n26):\n            pn[k + 1] = pn[k] + nxt2[k]\n            pp[k + 1] = pp[k] + prv2[k]\n\n        total = 0\n        for a, b in zip(s, t):\n            c = ord(a) - 97\n            d = ord(b) - 97\n            if c == d:\n                continue\n            # Forward: letters c, c+1, ..., d-1 (mod 26) using nextCost\n            fd = (d - c) % n26\n            fwd = pn[c + fd] - pn[c]\n            # Backward: letters c, c-1, ..., d+1 (mod 26) using previousCost\n            # Equivalent to going down from c to d: number of steps = (c - d) % 26\n            # Indices c, c-1, ..., d+1 in doubled array: shift by 26 to keep positive\n            bd = (c - d) % n26\n            start = c + n26 - bd + 1  # covers indices d+1+26 .. c+26\n            bwd = pp[c + n26 + 1] - pp[start]\n            total += min(fwd, bwd)\n        return total\n"}

