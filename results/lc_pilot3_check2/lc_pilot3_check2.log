TOOL submit_solution {"ticket_id": "Q-4808", "code": "from typing import List\nfrom itertools import combinations\n\nclass Solution:\n    def maxRectangleArea(self, points: List[List[int]]) -> int:\n        pts = [tuple(p) for p in points]\n        pset = set(pts)\n        best = -1\n        for combo in combinations(pts, 4):\n            xs = sorted(set(p[0] for p in combo))\n            ys = sorted(set(p[1] for p in combo))\n            if len(xs) != 2 or len(ys) != 2:\n                continue\n            x1, x2 = xs\n            y1, y2 = ys\n            corners = {(x1, y1), (x1, y2), (x2, y1), (x2, y2)}\n            if not corners.issubset(pset):\n                continue\n            # no other point inside or on the border\n            valid = True\n            for (px, py) in pts:\n                if x1 <= px <= x2 and y1 <= py <= y2 and (px, py) not in corners:\n                    valid = False\n                    break\n            if not valid:\n                continue\n            area = (x2 - x1) * (y2 - y1)\n            if area > 0 and area > best:\n                best = area\n        return best\n"}

