TOOL submit_solution {"ticket_id": "Q-7996", "code": "from typing import List\nfrom collections import Counter\nfrom math import comb\n\nMOD = 10**9 + 7\n\nclass Solution:\n    def subsequencesWithMiddleMode(self, nums: List[int]) -> int:\n        n = len(nums)\n        total_cnt = Counter(nums)\n        left = Counter()\n        right = Counter(total_cnt)\n        ans = 0\n\n        for j in range(n):\n            v = nums[j]\n            right[v] -= 1  # right = indices > j\n            if right[v] == 0:\n                del right[v]\n            Lv = left[v]\n            Rv = right[v]\n            Ln = j - Lv\n            Rn = (n - j - 1) - Rv\n\n            # sum of squares over non-v counts\n            S2L = 0\n            for x, c in left.items():\n                if x != v:\n                    S2L += c * c\n            S2R = 0\n            for x, c in right.items():\n                if x != v:\n                    S2R += c * c\n\n            def e2_excl(total, s2, cx):\n                # sum over pairs of distinct values among multiset, excluding one value with count cx\n                s1 = total - cx\n                q = s2 - cx * cx\n                return (s1 * s1 - q) // 2\n\n            cur = 0\n            cur += comb(Lv, 2) * comb(Rv, 2)\n            cur += comb(Lv, 2) * Rv * Rn + Lv * Ln * comb(Rv, 2)\n            cur += comb(Lv, 2) * comb(Rn, 2) + comb(Ln, 2) * comb(Rv, 2)\n            cur += Lv * Rv * Ln * Rn\n\n            # t = 1, case (a,b) = (1,0): one v and one non-v on left, two distinct non-v on right\n            if Lv:\n                s = 0\n                for x, c in left.items():\n                    if x != v:\n                        s += c * e2_excl(Rn, S2R, right.get(x, 0))\n                cur += Lv * s\n            # case (a,b) = (0,1): two distinct non-v on left, one v and one non-v on right\n            if Rv:\n                s = 0\n                for x, c in right.items():\n                    if x != v:\n                 