TOOL submit_solution {"ticket_id": "Q-1660", "code": "from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, words: List[str], k: int) -> List[int]:\n        # Build trie; cnt[node] = number of words passing through node\n        children = [{}]\n        depth = [0]\n        cnt = [0]\n        paths = []  # paths[i][d] = trie node at depth d on word i's path\n        for w in words:\n            cur = 0\n            path = [0]\n            cnt[0] += 1\n            for ch in w:\n                nxt = children[cur].get(ch)\n                if nxt is None:\n                    nxt = len(children)\n                    children.append({})\n                    depth.append(depth[cur] + 1)\n                    cnt.append(0)\n                    children[cur][ch] = nxt\n                cnt[nxt] += 1\n                cur = nxt\n                path.append(cur)\n            paths.append(path)\n\n        # good nodes: prefixes shared by at least k words, depth >= 1\n        good = [u for u in range(1, len(children)) if cnt[u] >= k]\n        good.sort(key=lambda u: -depth[u])\n\n        res = []\n        for i, w in enumerate(words):\n            lw = len(w)\n            path = paths[i]\n            ans = 0\n            for g in good:\n                d = depth[g]\n                # g is on word i's path and would drop to k-1 after removal -> invalid\n                if d <= lw and path[d] == g and cnt[g] == k:\n                    continue\n                ans = d\n                break\n            res.append(ans)\n        return res\n"}

