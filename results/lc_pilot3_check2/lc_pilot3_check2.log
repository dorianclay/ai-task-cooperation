TOOL submit_solution {"ticket_id": "T-6088", "code": "from typing import List\n\n\nclass Solution:\n    def minOperations(self, nums: List[int], x: int, k: int) -> int:\n        n = len(nums)\n        vals = sorted(set(nums))\n        m = len(vals)\n        pos_of = {v: i for i, v in enumerate(vals)}\n        cnt = [0] * (m + 1)\n        sm = [0] * (m + 1)\n\n        def add(p, c, v):\n            i = p + 1\n            while i <= m:\n                cnt[i] += c\n                sm[i] += c * v\n                i += i & -i\n\n        def prefix(p):\n            # aggregate over first p compressed indices (0..p-1)\n            c = 0\n            s = 0\n            i = p\n            while i > 0:\n                c += cnt[i]\n                s += sm[i]\n                i -= i & -i\n            return c, s\n\n        LOG = 1\n        while LOG * 2 <= m:\n            LOG *= 2\n\n        def kth(kk):\n            # returns 0-based compressed index of kk-th smallest element\n            p = 0\n            rem = kk\n            step = LOG\n            while step > 0:\n                if p + step <= m and cnt[p + step] < rem:\n                    p += step\n                    rem -= cnt[p]\n                step >>= 1\n            return p  # 0-based index of answer\n\n        # cost[l] = min ops to make window nums[l..l+x-1] all equal\n        cost = [0] * (n - x + 1)\n        win_sum = 0\n        for i in range(x):\n            add(pos_of[nums[i]], 1, nums[i])\n            win_sum += nums[i]\n        target_rank = (x + 1) // 2\n        for l in range(n - x + 1):\n            if l > 0:\n                out = nums[l - 1]\n                inn = nums[l + x - 1]\n                add(pos_of[out], -1, out)\n                add(pos_of[inn], 1, inn)\n                win_sum += inn - out\n            p = kth(target_rank)\n            med = vals[p]\n            cL, sL = prefix(p + 1)\n            cost[l] = med * cL - sL + (win_sum - sL) - med * (x - cL)\n\n        INF = float('inf')\n        prev = [0] * (n + 1)  # f_0[i] = 0\n        for j in range(1, k + 1):\n            cur = [INF] * (n + 1)\n            for i in range(x, n + 1):\n                best = cur[i - 1]\n                pv = prev[i - x]\n                if pv != INF:\n                    cand = pv + cost[i - x]\n                    if cand < best:\n                        best = cand\n                cur[i] = best\n            prev = cur\n        return int(prev[n])\n"}

