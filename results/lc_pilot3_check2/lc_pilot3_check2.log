TOOL submit_solution {"ticket_id": "Q-6050", "code": "from typing import List\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        n = len(startTime)\n        # gaps[i]: free time immediately before meeting i (gaps[n]: after the last meeting)\n        gaps = [0] * (n + 1)\n        gaps[0] = startTime[0]\n        for i in range(1, n):\n            gaps[i] = startTime[i] - endTime[i - 1]\n        gaps[n] = eventTime - endTime[n - 1]\n        # Moving k consecutive meetings merges the k+1 gaps around them\n        window = sum(gaps[:k + 1])\n        best = window\n        for l in range(1, n - k + 1):\n            window += gaps[l + k] - gaps[l - 1]\n            if window > best:\n                best = window\n        return best\n"}

