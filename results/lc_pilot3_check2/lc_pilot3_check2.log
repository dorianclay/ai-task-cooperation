TOOL submit_solution {"ticket_id": "T-4168", "code": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        x = y = 0\n        best = 0\n        for i, c in enumerate(s):\n            if c == 'N':\n                y += 1\n            elif c == 'S':\n                y -= 1\n            elif c == 'E':\n                x += 1\n            else:\n                x -= 1\n            dist = abs(x) + abs(y)\n            steps = i + 1\n            opp = steps - dist\n            val = min(dist + 2 * min(k, opp), steps)\n            if val > best:\n                best = val\n        return best\n"}

