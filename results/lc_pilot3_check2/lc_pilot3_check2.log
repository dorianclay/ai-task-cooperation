TOOL submit_solution {"ticket_id": "Q-9008", "code": "import heapq\n\nclass Solution:\n    def minOperations(self, n: int, m: int) -> int:\n        L = len(str(n))\n        size = 10 ** L\n        # sieve: is_prime[x] for 0 <= x < size\n        is_prime = [True] * size\n        is_prime[0] = False\n        if size > 1:\n            is_prime[1] = False\n        for i in range(2, int(size ** 0.5) + 1):\n            if is_prime[i]:\n                for j in range(i * i, size, i):\n                    is_prime[j] = False\n\n        if is_prime[n] or is_prime[m]:\n            return -1\n        if n == m:\n            return n\n\n        INF = float('inf')\n        dist = [INF] * size\n        dist[n] = n\n        pq = [(n, n)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if d != dist[u]:\n                continue\n            if u == m:\n                return d\n            # digits of u with exactly L digits (leading zeros allowed)\n            digits = []\n            x = u\n            for _ in range(L):\n                digits.append(x % 10)\n                x //= 10\n            digits.reverse()\n            for pos in range(L):\n                base = 10 ** (L - 1 - pos)\n                dg = digits[pos]\n                for delta in (1, -1):\n                    nd = dg + delta\n                    if 0 <= nd <= 9:\n                        v = u + delta * base\n                        if is_prime[v]:\n                            continue\n                        nd_cost = d + v\n                        if nd_cost < dist[v]:\n                            dist[v] = nd_cost\n                            heapq.heappush(pq, (nd_cost, v))\n        return -1 if dist[m] == INF else dist[m]\n"}

