TOOL submit_solution {"ticket_id": "Q-9246", "code": "from typing import List\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        candidates = []\n        for row, lim in zip(grid, limits):\n            # from each row, only its largest 'lim' values can ever be useful\n            best = sorted(row, reverse=True)[:lim]\n            candidates.extend(best)\n        candidates.sort(reverse=True)\n        return sum(candidates[:k])\n"}

