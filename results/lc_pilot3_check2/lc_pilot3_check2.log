TOOL submit_solution {"ticket_id": "Q-3727", "code": "from typing import List\n\nclass Solution:\n    def maxSubarraySum(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        INF = float('inf')\n        min_pref = [INF] * k\n        # prefix index 0\n        min_pref[0] = 0\n        pref = 0\n        best = -INF\n        for j in range(1, n + 1):\n            pref += nums[j - 1]\n            r = j % k\n            if min_pref[r] != INF:\n                cand = pref - min_pref[r]\n                if cand > best:\n                    best = cand\n            if pref < min_pref[r]:\n                min_pref[r] = pref\n            # store prefix at index j for future use\n        return best\n"}

