TOOL submit_solution {"ticket_id": "Q-6184", "code": "from typing import List\n\nclass Solution:\n    def minMaxSubarraySum(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n\n        def sum_max(arr):\n            # left[i]: index of previous element >= arr[i] (or -1)\n            left = [-1] * n\n            st = []\n            for i in range(n):\n                while st and arr[st[-1]] < arr[i]:\n                    st.pop()\n                left[i] = st[-1] if st else -1\n                st.append(i)\n            # right[i]: index of next element > arr[i] (or n)\n            right = [n] * n\n            st = []\n            for i in range(n - 1, -1, -1):\n                while st and arr[st[-1]] <= arr[i]:\n                    st.pop()\n                right[i] = st[-1] if st else n\n                st.append(i)\n\n            total = 0\n            for i in range(n):\n                a = left[i] + 1\n                R = right[i] - 1\n                lo = max(a, i - k + 1)\n                if lo > i:\n                    continue\n                m = i - lo + 1\n                t = R - k + 1\n                # sum over l in [lo, i] of min(R, l + k - 1)\n                sumf = 0\n                up1 = min(i, t)\n                if up1 >= lo:\n                    cnt1 = up1 - lo + 1\n                    sumf += (lo + up1) * cnt1 // 2 + (k - 1) * cnt1\n                start2 = max(lo, t + 1)\n                if start2 <= i:\n                    cnt2 = i - start2 + 1\n                    sumf += cnt2 * R\n                count = sumf - (i - 1) * m\n                total += arr[i] * count\n            return total\n\n        return sum_max(nums) - sum_max([-x for x in nums])\n"}

