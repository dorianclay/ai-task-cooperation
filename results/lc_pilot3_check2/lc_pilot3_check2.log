TOOL submit_solution {"ticket_id": "T-6905", "code": "from typing import List\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        lo = -float('inf')\n        hi = float('inf')\n        base = original[0]\n        for i in range(len(original)):\n            d = original[i] - base\n            u, v = bounds[i]\n            lo = max(lo, u - d)\n            hi = min(hi, v - d)\n        if hi < lo:\n            return 0\n        return int(hi - lo + 1)\n"}

