TOOL submit_solution {"ticket_id": "Q-2078", "code": "from typing import List\n\nclass Solution:\n    def sortMatrix(self, grid: List[List[int]]) -> List[List[int]]:\n        n = len(grid)\n        # group cells by diagonal, d = i - j\n        diagonals = {}\n        for i in range(n):\n            for j in range(n):\n                diagonals.setdefault(i - j, []).append(grid[i][j])\n\n        for d, vals in diagonals.items():\n            if d >= 0:\n                # bottom-left triangle (including middle): non-increasing\n                vals.sort(reverse=True)\n            else:\n                # top-right triangle: non-decreasing\n                vals.sort()\n\n        # write back in traversal order along each diagonal\n        pos = {d: 0 for d in diagonals}\n        result = [[0] * n for _ in range(n)]\n        for i in range(n):\n            for j in range(n):\n                d = i - j\n                result[i][j] = diagonals[d][pos[d]]\n                pos[d] += 1\n        return result\n"}

