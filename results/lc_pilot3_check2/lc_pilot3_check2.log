TOOL submit_solution {"ticket_id": "Q-5023", "code": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int], k: int, limit: int) -> int:\n        # state key: (q, s) where q = length of subsequence mod 2, s = alternating sum so far\n        # value: [set of products <= limit (0 included if a zero was taken), flag: any nonempty subsequence reaches this state]\n        states = {}\n        for x in nums:\n            updates = []  # list of (key, products_set, flag)\n            # sources: existing nonempty states, plus the empty subsequence (q=0, s=0, product 1)\n            sources = [(key, val[0], True) for key, val in states.items()]\n            sources.append(((0, 0), {1}, False))\n            for (q, s), prods, _ in sources:\n                ns = s + x if q == 0 else s - x\n                nq = 1 - q\n                if abs(ns) > 2000:\n                    continue\n                if x == 0:\n                    newp = {0}\n                else:\n                    newp = set()\n                    for P in prods:\n                        v = P * x\n                        if v <= limit:\n                            newp.add(v)\n                updates.append(((nq, ns), newp))\n            for key, newp in updates:\n                if key in states:\n                    states[key][0] |= newp\n                else:\n                    states[key] = [set(newp), True]\n            # mark flags for states reached (any nonempty subsequence)\n            for key, _ in updates:\n                states[key][1] = True\n\n        best = -1\n        for q in (0, 1):\n            val = states.get((q, k))\n            if val is not None and val[0]:\n                cand = max(val[0])\n                if cand > best:\n                    best = cand\n        return best\n"}

