TOOL submit_solution {"ticket_id": "Q-1552", "code": "from typing import List\n\nclass Solution:\n    def maxWeight(self, pizzas: List[int]) -> int:\n        p = sorted(pizzas)\n        n = len(p)\n        days = n // 4\n        odd_days = (days + 1) // 2   # days where we gain the largest of the group\n        even_days = days // 2        # days where we gain the second largest of the group\n        # Odd days take the largest pizzas outright.\n        total = sum(p[n - odd_days:]) if odd_days > 0 else 0\n        # Even days waste the next largest and gain the one below it.\n        idx = n - odd_days - 2\n        for _ in range(even_days):\n            total += p[idx]\n            idx -= 2\n        return total\n"}

