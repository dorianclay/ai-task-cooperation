TOOL submit_solution {"ticket_id": "Q-8357", "code": "from typing import List\nfrom math import gcd\nfrom collections import defaultdict\n\nclass Solution:\n    def numberOfSubsequences(self, nums: List[int]) -> int:\n        n = len(nums)\n\n        def frac(a, b):\n            g = gcd(a, b)\n            return (a // g, b // g)\n\n        # right[r] = counts of nums[s]/nums[r] for s >= r+2\n        # Precompute suffix dictionaries lazily as we sweep r downward.\n        # We'll store for each r a dict of ratios for s in [r+2, n-1].\n        right_dicts = [None] * n\n        cur = defaultdict(int)\n        for r in range(n - 1, -1, -1):\n            # cur currently holds s in [r+2, n-1] keyed by nums[s]/nums[r]? Ratio depends on r,\n            # so we store raw values and convert per r below.\n            right_dicts[r] = None\n        # Build per-r dictionaries directly from the raw suffix counts of values.\n        suffix_vals = defaultdict(int)  # value -> count for s in [r+2, n-1]\n        for r in range(n - 1, -1, -1):\n            # suffix_vals holds indices >= r+2\n            d = defaultdict(int)\n            for v, c in suffix_vals.items():\n                d[frac(v, nums[r])] += c\n            right_dicts[r] = d\n            # add index r+1 into suffix_vals for the next iteration (r-1 needs >= r+1)\n            if r + 1 < n:\n                suffix_vals[nums[r + 1]] += 1\n\n        total = 0\n        left_vals = defaultdict(int)  # value -> count for p in [0, q-2]\n        for q in range(n):\n            # left_vals holds p <= q-2\n            if q - 2 >= 0:\n                left_vals[nums[q - 2]] += 1\n            if not left_vals:\n                continue\n            # left ratios nums[p]/nums[q]\n            left_d = defaultdict(int)\n            for v, c in left_vals.items():\n                left_d[frac(v, nums[q])] += c\n            for r in range(q + 2, n):\n                rd = right_dicts[r]\n                for key, c in left_d.items():\n                    if key in rd:\n                        total += c * rd[key]\n        return total\n"}

