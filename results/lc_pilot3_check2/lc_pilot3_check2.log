TOOL submit_solution {"ticket_id": "T-5301", "code": "from typing import List\nfrom bisect import bisect_left\n\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n        parts = p.split('*')\n        A, B, C = parts[0], parts[1], parts[2]\n\n        def occurrences(x: str) -> List[int]:\n            if x == \"\":\n                return list(range(n + 1))\n            t = x + '\\x00' + s\n            m = len(t)\n            z = [0] * m\n            l = r = 0\n            for i in range(1, m):\n                if i < r:\n                    z[i] = min(r - i, z[i - l])\n                while i + z[i] < m and t[z[i]] == t[i + z[i]]:\n                    z[i] += 1\n                if i + z[i] > r:\n                    l, r = i, i + z[i]\n            lx = len(x)\n            res = []\n            for i in range(lx + 1, m):\n                if z[i] >= lx:\n                    res.append(i - lx - 1)\n            return res\n\n        occA = occurrences(A)\n        occB = occurrences(B)\n        occC = occurrences(C)\n        la, lb, lc = len(A), len(B), len(C)\n\n        best = -1\n        for i in occA:\n            qi = bisect_left(occB, i + la)\n            if qi == len(occB):\n                continue\n            q = occB[qi]\n            ri = bisect_left(occC, q + lb)\n            if ri == len(occC):\n                continue\n            r = occC[ri]\n            cand = r + lc - i\n            if best == -1 or cand < best:\n                best = cand\n        return best\n"}

