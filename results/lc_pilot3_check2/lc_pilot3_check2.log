TOOL submit_solution {"ticket_id": "Q-9022", "code": "class Solution:\n    def countSubstrings(self, s: str) -> int:\n        n = len(s)\n        digits = [ord(c) - 48 for c in s]\n        # prefix stats\n        # digit sum mod 3 and mod 9 (divisibility by 3 / 9 depends only on digit sum)\n        cnt3 = [0, 0, 0]\n        cnt9 = [0] * 9\n        cnt3[0] = 1\n        cnt9[0] = 1\n        S3 = 0\n        S9 = 0\n        # W mod 7: W[k] = sum_{t<k} s_t * 5^t mod 7  (5 = 10^{-1} mod 7)\n        cnt7 = [0] * 7\n        cnt7[0] = 1\n        W7 = 0\n        pow5 = 1  # 5^t mod 7\n        ans = 0\n        for j in range(n):\n            d = digits[j]\n            # update prefix stats including digit j (prefix index j+1)\n            S3 = (S3 + d) % 3\n            S9 = (S9 + d) % 9\n            W7 = (W7 + d * pow5) % 7\n            pow5 = pow5 * 5 % 7\n            if d == 0:\n                # last digit zero is never used as divisor; still keep prefix counts updated\n                cnt3[S3] += 1\n                cnt9[S9] += 1\n                cnt7[W7] += 1\n                continue\n            # counts of starts i in [0..j] with the required property\n            if d in (1, 2, 5):\n                ans += j + 1\n            elif d == 3:\n                ans += cnt3[S3]\n            elif d == 6:\n                ans += cnt3[S3]\n            elif d == 9:\n                ans += cnt9[S9]\n            elif d == 7:\n                ans += cnt7[W7]\n            elif d in (4, 8):\n                m = 2 if d == 4 else 3\n                if j - m + 1 >= 0 and int(s[j - m + 1:j + 1]) % d == 0:\n                    ans += j - m + 2\n                for i in range(max(0, j - m + 2), j + 1):\n                    if int(s[i:j + 1]) % d == 0:\n                        ans += 1\n            # register prefix index j+1 for future queries\n            cnt3[S3] += 1\n            cnt9[S9] += 1\n            cnt7[W7] += 1\n        return ans\n"}

