TOOL submit_solution {"ticket_id": "Q-7111", "code": "class Solution:\n    def countWinningSequences(self, s: str) -> int:\n        MOD = 10 ** 9 + 7\n        n = len(s)\n        off = n\n        size = 2 * n + 1\n        # Moves: F=0, W=1, E=2. Bob's move b beats Alice's a iff (b - a) % 3 == 1.\n        idx = {'F': 0, 'W': 1, 'E': 2}\n        # dp[p] : counts indexed by score diff (Bob - Alice) + off, where p is Bob's last move\n        # (index 3 = no previous move).\n        dp = [[0] * size for _ in range(4)]\n        dp[3][off] = 1\n        for ch in s:\n            a = idx[ch]\n            new = [[0] * size for _ in range(3)]\n            for p in range(4):\n                row = dp[p]\n                for b in range(3):\n                    if b == p:\n                        continue\n                    target = new[b]\n                    if b == a:\n                        for j in range(size):\n                            if row[j]:\n                                target[j] += row[j]\n                    elif (b - a) % 3 == 1:\n                        # Bob wins the round: diff +1\n                        for j in range(size - 1):\n                            if row[j]:\n                                target[j + 1] += row[j]\n                    else:\n                        # Alice wins the round: diff -1\n                        for j in range(1, size):\n                            if row[j]:\n                                target[j - 1] += row[j]\n            for b in range(3):\n                new[b] = [v % MOD for v in new[b]]\n            dp = new + [[0] * size]\n        total = 0\n        for b in range(3):\n            for j in range(off + 1, size):\n                total += dp[b][j]\n        return total % MOD\n"}

