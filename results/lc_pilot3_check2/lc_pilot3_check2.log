TOOL submit_solution {"ticket_id": "T-1878", "code": "from typing import List\n\n\nclass Solution:\n    def countComponents(self, nums: List[int], threshold: int) -> int:\n        T = threshold\n        present = [False] * (T + 1)\n        big = 0\n        for v in nums:\n            if v > T:\n                big += 1\n            else:\n                present[v] = True\n\n        parent = list(range(T + 1))\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a, b):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[ra] = rb\n\n        # For each L <= threshold, all present divisors of L are pairwise connected,\n        # since lcm of any two divisors of L divides L and hence is <= threshold.\n        divs = [[] for _ in range(T + 1)]\n        for d in range(1, T + 1):\n            if present[d]:\n                for L in range(d, T + 1, d):\n                    divs[L].append(d)\n\n        for L in range(1, T + 1):\n            dl = divs[L]\n            for i in range(1, len(dl)):\n                union(dl[0], dl[i])\n\n        roots = set()\n        for v in range(1, T + 1):\n            if present[v]:\n                roots.add(find(v))\n\n        return big + len(roots)\n"}

