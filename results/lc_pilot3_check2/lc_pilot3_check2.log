TOOL submit_solution {"ticket_id": "T-5301", "code": "import bisect\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n        first, second = [i for i, ch in enumerate(p) if ch == '*'][:2]\n        A = p[:first]\n        B = p[first + 1:second]\n        C = p[second + 1:]\n\n        def occurrences(pat):\n            if pat == \"\":\n                return list(range(n + 1))\n            res = []\n            start = 0\n            while True:\n                idx = s.find(pat, start)\n                if idx == -1:\n                    break\n                res.append(idx)\n                start = idx + 1\n            return res\n\n        occA = occurrences(A)\n        occB = occurrences(B)\n        occC = occurrences(C)\n        if not occA or not occB or not occC:\n            return -1\n\n        best = None\n        lb, lc = len(B), len(C)\n        for x in occA:\n            # earliest B starting at or after the end of A\n            i = bisect.bisect_left(occB, x + len(A))\n            if i == len(occB):\n                continue\n            bpos = occB[i]\n            # earliest C starting at or after the end of B\n            j = bisect.bisect_left(occC, bpos + lb)\n            if j == len(occC):\n                continue\n            cpos = occC[j]\n            end = cpos + lc\n            length = end - x\n            if best is None or length < best:\n                best = length\n        return best if best is not None else -1\n"}

