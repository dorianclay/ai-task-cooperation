TOOL submit_solution {"ticket_id": "Q-1251", "code": "from typing import List\n\nclass Solution:\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\n        n = len(baskets)\n        size = 1\n        while size < n:\n            size *= 2\n        tree = [0] * (2 * size)\n        for i, c in enumerate(baskets):\n            tree[size + i] = c\n        for i in range(size - 1, 0, -1):\n            tree[i] = max(tree[2 * i], tree[2 * i + 1])\n\n        unplaced = 0\n        for f in fruits:\n            if tree[1] < f:\n                unplaced += 1\n                continue\n            # descend to leftmost leaf with capacity >= f\n            node = 1\n            while node < size:\n                if tree[2 * node] >= f:\n                    node = 2 * node\n                else:\n                    node = 2 * node + 1\n            tree[node] = 0\n            node //= 2\n            while node >= 1:\n                tree[node] = max(tree[2 * node], tree[2 * node + 1])\n                node //= 2\n        return unplaced\n"}

