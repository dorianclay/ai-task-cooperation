TOOL submit_solution {"ticket_id": "Q-5211", "code": "from typing import List\nfrom collections import Counter\n\nclass Solution:\n    def getLargestOutlier(self, nums: List[int]) -> int:\n        cnt = Counter(nums)\n        total = sum(nums)\n        best = None\n        for S, c in cnt.items():\n            O = total - 2 * S\n            if O == S:\n                # outlier and sum element must be distinct indices\n                if cnt[O] >= 2:\n                    best = O if best is None else max(best, O)\n            elif O in cnt:\n                best = O if best is None else max(best, O)\n        return best\n"}

