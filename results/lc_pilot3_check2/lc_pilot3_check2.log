TOOL submit_solution {"ticket_id": "T-1878", "code": "from typing import List\n\nclass Solution:\n    def countComponents(self, nums: List[int], threshold: int) -> int:\n        parent = {}\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a, b):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[ra] = rb\n\n        present = set(nums)\n        isolated = 0\n        small = []\n        for v in nums:\n            if v > threshold:\n                isolated += 1\n            else:\n                small.append(v)\n                parent[v] = v\n\n        # for each multiple m <= threshold, union all present small values that are divisors of m\n        owner = {}  # multiple m -> some present value dividing m\n        for v in small:\n            m = v\n            while m <= threshold:\n                if m in owner:\n                    union(v, owner[m])\n                else:\n                    owner[m] = v\n                m += v\n\n        roots = set(find(v) for v in small)\n        return isolated + len(roots)\n"}

