TOOL submit_solution {"ticket_id": "Q-7700", "code": "from typing import List\n\nclass Solution:\n    def countMentions(self, numberOfUsers: int, events: List[List[str]]) -> List[int]:\n        mentions = [0] * numberOfUsers\n        offline_until = [0] * numberOfUsers  # user is online at time t iff offline_until[u] <= t\n        # Sort by timestamp; OFFLINE events are processed before MESSAGE at the same timestamp\n        order = sorted(events, key=lambda e: (int(e[1]), 0 if e[0] == \"OFFLINE\" else 1))\n        for kind, ts, data in order:\n            t = int(ts)\n            if kind == \"OFFLINE\":\n                uid = int(data)\n                offline_until[uid] = t + 60\n            else:\n                if data == \"ALL\":\n                    for u in range(numberOfUsers):\n                        mentions[u] += 1\n                elif data == \"HERE\":\n                    for u in range(numberOfUsers):\n                        if offline_until[u] <= t:\n                            mentions[u] += 1\n                else:\n                    for token in data.split():\n                        if token.startswith(\"id\"):\n                            mentions[int(token[2:])] += 1\n        return mentions\n"}

