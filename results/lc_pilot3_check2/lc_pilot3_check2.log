TOOL submit_solution {"ticket_id": "T-5886", "code": "from typing import List\n\nclass Solution:\n    def isZeroArray(self, nums: List[int], queries: List[List[int]]) -> bool:\n        n = len(nums)\n        diff = [0] * (n + 1)\n        for l, r in queries:\n            diff[l] += 1\n            diff[r + 1] -= 1\n        cover = 0\n        for i in range(n):\n            cover += diff[i]\n            if cover < nums[i]:\n                return False\n        return True\n"}

