TOOL submit_solution {"ticket_id": "Q-1885", "code": "from typing import List\nfrom collections import Counter\nfrom bisect import bisect_left, bisect_right\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int, numOperations: int) -> int:\n        cnt = Counter(nums)\n        arr = sorted(nums)\n        # candidate targets: all values in nums, and values within k of some nums value\n        candidates = set()\n        for x in cnt:\n            for t in (x - k, x, x + k):\n                candidates.add(t)\n        best = 0\n        for t in candidates:\n            lo = bisect_left(arr, t - k)\n            hi = bisect_right(arr, t + k)\n            window = hi - lo\n            eq = cnt.get(t, 0)\n            non_eq = window - eq\n            total = eq + min(numOperations, non_eq)\n            if total > best:\n                best = total\n        return best\n"}

