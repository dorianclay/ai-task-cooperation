TOOL submit_solution {"ticket_id": "Q-8357", "code": "from typing import List\nfrom math import gcd\nfrom collections import Counter, defaultdict\n\nclass Solution:\n    def numberOfSubsequences(self, nums: List[int]) -> int:\n        n = len(nums)\n        # suffix[r]: counter of reduced ratios nums[s]/nums[r] for s >= r+2, precomputed once per r\n        suffix = [None] * n\n        for r in range(n):\n            c = Counter()\n            for s in range(r + 2, n):\n                g = gcd(nums[s], nums[r])\n                c[(nums[s] // g, nums[r] // g)] += 1\n            suffix[r] = c\n\n        total = 0\n        # left: counter of reduced ratios nums[p]/nums[q] for p <= q-2, maintained as q advances\n        for q in range(2, n):\n            # add p = q-2 to left, for the current q\n            left = Counter()\n            for p in range(q - 1):\n                g = gcd(nums[p], nums[q])\n                left[(nums[p] // g, nums[q] // g)] += 1\n            for r in range(q + 2, n):\n                for key, cnt in left.items():\n                    total += cnt * suffix[r].get(key, 0)\n        return total\n"}

