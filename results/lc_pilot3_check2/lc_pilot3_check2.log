TOOL submit_solution {"ticket_id": "Q-8777", "code": "from typing import List\nimport heapq\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        n = len(nums1)\n        order = sorted(range(n), key=lambda i: nums1[i])\n        ans = [0] * n\n        heap = []  # min-heap holding the top-k nums2 values seen so far\n        total = 0\n        i = 0\n        while i < n:\n            j = i\n            # group of equal nums1 values: answers use only strictly smaller values\n            while j < n and nums1[order[j]] == nums1[order[i]]:\n                j += 1\n            for t in range(i, j):\n                ans[order[t]] = total\n            for t in range(i, j):\n                idx = order[t]\n                v = nums2[idx]\n                if len(heap) < k:\n                    heapq.heappush(heap, v)\n                    total += v\n                elif v > heap[0]:\n                    total += v - heapq.heappushpop(heap, v)\n            i = j\n        return ans\n"}

