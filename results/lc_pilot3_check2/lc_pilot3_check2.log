TOOL submit_solution {"ticket_id": "Q-1940", "code": "from typing import List\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        INF = float('inf')\n        n = len(nums)\n        A = min(op1, n)\n        B = min(op2, n)\n        # dp[a][b] = minimum sum so far using a op1's and b op2's\n        dp = [[INF] * (B + 1) for _ in range(A + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            half = (x + 1) // 2  # ceil(x / 2)\n            # each option: (uses of op1, uses of op2, resulting value)\n            options = [(0, 0, x), (1, 0, half)]\n            if x >= k:\n                options.append((0, 1, x - k))\n                options.append((1, 1, min(\n                    half - k if half >= k else INF,       # halve then subtract\n                    (x - k + 1) // 2                      # subtract then halve\n                )))\n            new = [[INF] * (B + 1) for _ in range(A + 1)]\n            for a in range(A + 1):\n                row = dp[a]\n                for b in range(B + 1):\n                    cur = row[b]\n                    if cur == INF:\n                        continue\n                    for da, db, val in options:\n                        if val == INF:\n                            continue\n                        na, nb = a + da, b + db\n                        if na <= A and nb <= B:\n                            v = cur + val\n                            if v < new[na][nb]:\n                                new[na][nb] = v\n            dp = new\n        return min(min(row) for row in dp)\n"}

