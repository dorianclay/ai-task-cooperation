TOOL submit_solution {"ticket_id": "Q-3727", "code": "from typing import List\n\nclass Solution:\n    def maxSubarraySum(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        INF = float('inf')\n        min_prefix = [INF] * k\n        prefix = 0\n        # prefix index 0 has sum 0, residue 0\n        min_prefix[0] = 0\n        best = -INF\n        for j in range(1, n + 1):\n            prefix += nums[j - 1]\n            r = j % k\n            if min_prefix[r] != INF:\n                cand = prefix - min_prefix[r]\n                if cand > best:\n                    best = cand\n            if prefix < min_prefix[r]:\n                min_prefix[r] = prefix\n        return best\n"}

