TOOL submit_solution {"ticket_id": "T-1052", "code": "from typing import List\nfrom functools import lru_cache\n\nclass Solution:\n    def minCost(self, nums: List[int]) -> int:\n        n = len(nums)\n\n        @lru_cache(maxsize=None)\n        def solve(i, carry):\n            # carry: index of a carried-over element that is still at the front (or -1)\n            # elements remaining: (carry if carry != -1) plus nums[i:]\n            rem = []\n            if carry != -1:\n                rem.append(nums[carry])\n            rem.extend(nums[i:])\n            if len(rem) == 0:\n                return 0\n            if len(rem) < 3:\n                return max(rem)\n            # the first three remaining values\n            a = rem[0]\n            b = rem[1]\n            c = rem[2]\n            best = float('inf')\n            # Represent options in terms of the global indices.\n            # Build the list of global indices for the first three remaining elements.\n            idxs = []\n            if carry != -1:\n                idxs.append(carry)\n            j = i\n            while len(idxs) < 3 and j < n:\n                idxs.append(j)\n                j += 1\n            # idxs holds global indices of first three elements (carry may be first)\n            p, q, r = idxs[0], idxs[1], idxs[2]\n            # Next state after removing pair; the leftover element (if any) is carried.\n            # Remaining global elements after position r are nums[r+1:], starting at index r+1.\n            # Option 1: remove p,q; leftover r becomes carry\n            best = min(best, max(nums[p], nums[q]) + solve(r + 1, r))\n            # Option 2: remove p,r; leftover q becomes carry\n            best = min(best, max(nums[p], nums[r]) + solve(r + 1, q))\n            # Option 3: remove q,r; leftover p becomes carry\n            best = min(best, max(nums[q], nums[r]) + solve(r + 1, p))\n            return best\n\n        return solve(0, -1)\n"}

