TOOL submit_solution {"ticket_id": "Q-8662", "code": "from typing import List\n\nclass Solution:\n    def minTime(self, skill: List[int], mana: List[int]) -> int:\n        n, m = len(skill), len(mana)\n        P = [0] * (n + 1)\n        for i in range(n):\n            P[i + 1] = P[i] + skill[i]\n        t = 0\n        for j in range(1, m):\n            a, b = mana[j - 1], mana[j]\n            gap = max(P[i + 1] * a - P[i] * b for i in range(n))\n            t += gap\n        return t + P[n] * mana[m - 1]\n"}

