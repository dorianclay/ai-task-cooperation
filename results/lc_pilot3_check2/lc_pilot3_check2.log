TOOL submit_solution {"ticket_id": "T-9307", "code": "class Solution:\n    def distanceSum(self, m: int, n: int, k: int) -> int:\n        MOD = 10 ** 9 + 7\n        N = m * n\n\n        # Sum of Manhattan distances over all unordered pairs of cells.\n        row_part = sum(d * (m - d) for d in range(1, m)) * n * n\n        col_part = sum(d * (n - d) for d in range(1, n)) * m * m\n        total_pairs_dist = (row_part + col_part) % MOD\n\n        # Each pair of cells appears together in C(N-2, k-2) arrangements.\n        r = N - 2\n        t = k - 2\n        if t < 0 or t > r:\n            return 0\n        num = 1\n        den = 1\n        for i in range(t):\n            num = num * ((r - i) % MOD) % MOD\n            den = den * ((i + 1) % MOD) % MOD\n        comb = num * pow(den, MOD - 2, MOD) % MOD\n\n        return total_pairs_dist * comb % MOD\n"}

