TOOL submit_solution {"ticket_id": "T-8444", "code": "from typing import List\n\nclass Solution:\n    def maxCollectedFruits(self, fruits: List[List[int]]) -> int:\n        n = len(fruits)\n        # Child 1 takes the main diagonal.\n        total = sum(fruits[i][i] for i in range(n))\n        NEG = float('-inf')\n\n        def upper(grid):\n            # Child starting at (0, n-1) moving down, staying in region j > i.\n            # Work in terms of cells (i, j) with j > i; child moves to (i+1, j-1), (i+1, j), (i+1, j+1).\n            # Use DP from row 0 down to row n-2 over cells with j > i.\n            dp = [NEG] * n\n            dp[n - 1] = grid[0][n - 1]\n            for i in range(1, n - 1):\n                ndp = [NEG] * n\n                for j in range(i + 1, n):\n                    best = NEG\n                    for pj in (j - 1, j, j + 1):\n                        if 0 <= pj < n and dp[pj] > best:\n                            best = dp[pj]\n                    if best > NEG:\n                        ndp[j] = best + grid[i][j]\n                dp = ndp\n            # Final row handled by the total DP; end at (n-1, n-1) collected elsewhere.\n            best = NEG\n            for j in range(0, n):\n                pass\n            return dp\n\n        def triangle_best(grid):\n            # Child from (0, n-1): ends at (n-1, n-1). Collect cells with j > i, plus the final cell counted once.\n            dp = [NEG] * n\n            dp[n - 1] = grid[0][n - 1]\n            for i in range(1, n - 1):\n                ndp = [NEG] * n\n                for j in range(i + 1, n):\n                    best = NEG\n                    for pj in (j - 1, j, j + 1):\n                        if 0 <= pj < n and dp[pj] > best:\n                            best = dp[pj]\n                    if best > NEG:\n                        ndp[j] = best + grid[i][j]\n                dp = ndp\n            # Move to the last row: from row n-2 cell j to (n-1, n-1) via j in {n-2, n-1, n}\n            res = NEG\n            for j in range(0, n):\n                if dp[j] == NEG:\n                    continue\n                if abs(j - (n - 1)) <= 1:\n                    res = max(res, dp[j])\n            if res == NEG:\n                return 0\n            return res + grid[n - 1][n - 1]\n\n        # Child 2 (from (0, n-1)) over upper triangle j > i.\n        upper_best = triangle_best(fruits)\n\n        # Child 3 (from (n-1, 0)) over lower triangle i > j: transpose.\n        transposed = [[fruits[j][i] for j in range(n)] for i in range(n)]\n        lower_best = triangle_best(transposed)\n\n        return total + upper_best + lower_best\n"}

