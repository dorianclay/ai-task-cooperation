TOOL submit_solution {"ticket_id": "Q-5138", "code": "from typing import List\n\nclass Solution:\n    def minOperations(self, queries: List[List[int]]) -> int:\n        def F(n):\n            # sum over x in [1, n] of the number of base-4 digits of x\n            if n <= 0:\n                return 0\n            total = 0\n            d = 1\n            lo = 1\n            while lo <= n:\n                hi = min(n, 4 * lo - 1)\n                total += d * (hi - lo + 1)\n                lo *= 4\n                d += 1\n            return total\n\n        def digits4(x):\n            d = 0\n            while x > 0:\n                d += 1\n                x //= 4\n            return d\n\n        ans = 0\n        for l, r in queries:\n            S = F(r) - F(l - 1)\n            maxf = digits4(r)\n            ans += max(maxf, (S + 1) // 2)\n        return ans\n"}

