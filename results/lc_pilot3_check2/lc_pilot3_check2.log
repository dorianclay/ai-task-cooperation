TOOL submit_solution {"ticket_id": "Q-7700", "code": "from typing import List\n\nclass Solution:\n    def countMentions(self, numberOfUsers: int, events: List[List[str]]) -> List[int]:\n        n = numberOfUsers\n        mentions = [0] * n\n        offline_until = [0] * n  # user is online at time t iff t >= offline_until[u]\n        # OFFLINE processed before MESSAGE at the same timestamp\n        ordered = sorted(events, key=lambda e: (int(e[1]), 0 if e[0] == \"OFFLINE\" else 1))\n        for ev in ordered:\n            kind, ts, payload = ev[0], int(ev[1]), ev[2]\n            if kind == \"OFFLINE\":\n                uid = int(payload)\n                offline_until[uid] = ts + 60\n            else:\n                if payload == \"ALL\":\n                    for u in range(n):\n                        mentions[u] += 1\n                elif payload == \"HERE\":\n                    for u in range(n):\n                        if ts >= offline_until[u]:\n                            mentions[u] += 1\n                else:\n                    for tok in payload.split():\n                        if tok.startswith(\"id\"):\n                            mentions[int(tok[2:])] += 1\n        return mentions\n"}

