TOOL submit_solution {"ticket_id": "Q-4808", "code": "from typing import List\n\nclass Solution:\n    def maxRectangleArea(self, points: List[List[int]]) -> int:\n        pts = set(map(tuple, points))\n        n = len(points)\n        best = -1\n        for i in range(n):\n            x1, y1 = points[i]\n            for j in range(n):\n                x2, y2 = points[j]\n                # (x1,y1) bottom-left, (x2,y2) top-right\n                if not (x1 < x2 and y1 < y2):\n                    continue\n                if (x1, y2) not in pts or (x2, y1) not in pts:\n                    continue\n                corners = {(x1, y1), (x2, y2), (x1, y2), (x2, y1)}\n                valid = True\n                for px, py in points:\n                    if (px, py) in corners:\n                        continue\n                    if x1 <= px <= x2 and y1 <= py <= y2:\n                        valid = False\n                        break\n                if valid:\n                    area = (x2 - x1) * (y2 - y1)\n                    if area > best:\n                        best = area\n        return best\n"}

