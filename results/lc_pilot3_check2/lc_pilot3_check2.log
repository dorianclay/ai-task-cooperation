TOOL submit_solution {"ticket_id": "T-4021", "code": "from typing import List\nfrom math import gcd\nimport heapq\n\n\nclass Solution:\n    def minimumIncrements(self, nums: List[int], target: List[int]) -> int:\n        m = len(target)\n        full = (1 << m) - 1\n        n = len(nums)\n\n        # lcm for each nonempty subset of targets\n        L = [1] * (full + 1)\n        for g in range(1, full + 1):\n            l = 1\n            for j in range(m):\n                if g >> j & 1:\n                    l = l * target[j] // gcd(l, target[j])\n            L[g] = l\n\n        # Each element is used for at most one group. An optimal solution uses at most\n        # m elements, so for each group only the m cheapest elements need be considered.\n        cands = set()\n        for g in range(1, full + 1):\n            lg = L[g]\n            best = heapq.nsmallest(m, range(n), key=lambda i: (-nums[i]) % lg)\n            cands.update(best)\n\n        INF = float('inf')\n        dp = [INF] * (full + 1)\n        dp[0] = 0\n        for i in cands:\n            a = nums[i]\n            new = dp[:]\n            for mask in range(full + 1):\n                if dp[mask] == INF:\n                    continue\n                for g in range(1, full + 1):\n                    c = (-a) % L[g]\n                    nm = mask | g\n                    v = dp[mask] + c\n                    if v < new[nm]:\n                        new[nm] = v\n            dp = new\n        return int(dp[full])\n"}

