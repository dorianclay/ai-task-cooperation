TOOL submit_solution {"ticket_id": "Q-6050", "code": "from typing import List\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        n = len(startTime)\n        # gaps: gap[0] before meeting 0, gap[i] between meeting i-1 and i, gap[n] after last\n        gap = [0] * (n + 1)\n        gap[0] = startTime[0]\n        for i in range(1, n):\n            gap[i] = startTime[i] - endTime[i - 1]\n        gap[n] = eventTime - endTime[n - 1]\n        # window of k consecutive meetings spans gaps [l, l+k] (k+1 gaps)\n        w = min(k, n)\n        cur = sum(gap[0:w + 1])\n        best = cur\n        for l in range(1, n - w + 1):\n            cur += gap[l + w] - gap[l - 1]\n            if cur > best:\n                best = cur\n        return best\n"}

