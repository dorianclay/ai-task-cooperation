            if cur_max is None or v > cur_max:\n                    cur_max = v\n                sum_pm += cur_max\n                sum_v += v\n            # extend right while valid\n            while right < n:\n                v = nums[right]\n                nm = v if cur_max is None or v > cur_max else cur_max\n                c = (sum_pm + nm) - (sum_v + v) - 0\n                # total cost for [left..right] = sum over window of (pm - v)\n                c = (sum_pm + nm) - (sum_v + v)\n                if c <= k:\n                    sum_pm += nm\n                    sum_v += v\n                    cur_max = nm\n                    right += 1\n                else:\n                    break\n            ans += right - left\n            # advance left: recompute window state for next left\n            left += 1\n            if left >= right:\n                right = left\n        return ans\n"}

