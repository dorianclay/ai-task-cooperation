TOOL submit_solution {"ticket_id": "Q-4021", "code": "from typing import List\nfrom math import gcd\n\nINF = float('inf')\n\nclass Solution:\n    def minimumIncrements(self, nums: List[int], target: List[int]) -> int:\n        t = len(target)\n        full = (1 << t) - 1\n        # lcm for each nonempty subset of targets\n        lcm_of = [1] * (1 << t)\n        for mask in range(1, 1 << t):\n            low = mask & -mask\n            idx = low.bit_length() - 1\n            prev = mask ^ low\n            a = lcm_of[prev] if prev else 1\n            b = target[idx]\n            lcm_of[mask] = a * b // gcd(a, b)\n        subsets = list(range(1, 1 << t))\n        dp = [INF] * (1 << t)\n        dp[0] = 0\n        for num in nums:\n            # cost to raise num to a multiple of lcm for each subset\n            trans = []\n            for T in subsets:\n                L = lcm_of[T]\n                m = ((num + L - 1) // L) * L\n                trans.append((T, m - num))\n            new = dp[:]\n            for mask in range(1 << t):\n                cur = dp[mask]\n                if cur == INF:\n                    continue\n                for T, c in trans:\n                    nm = mask | T\n                    v = cur + c\n                    if v < new[nm]:\n                        new[nm] = v\n            dp = new\n        return int(dp[full])\n"}

