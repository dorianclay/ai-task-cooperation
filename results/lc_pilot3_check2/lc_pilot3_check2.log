TOOL submit_solution {"ticket_id": "T-8604", "code": "from typing import List\n\nclass Solution:\n    def minDifference(self, nums: List[int]) -> int:\n        n = len(nums)\n        base = 0\n        lo = None\n        hi = None\n        for i in range(n - 1):\n            a, b = nums[i], nums[i + 1]\n            if a != -1 and b != -1:\n                base = max(base, abs(a - b))\n        for i in range(n):\n            if nums[i] == -1:\n                for j in (i - 1, i + 1):\n                    if 0 <= j < n and nums[j] != -1:\n                        v = nums[j]\n                        lo = v if lo is None else min(lo, v)\n                        hi = v if hi is None else max(hi, v)\n        if lo is None:\n            return 0\n        bound = (hi - lo + 1) // 2\n        return max(base, bound)\n"}

