TOOL submit_solution {"ticket_id": "T-8777", "code": "from typing import List\nimport heapq\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        n = len(nums1)\n        order = sorted(range(n), key=lambda i: nums1[i])\n        answer = [0] * n\n        heap = []  # min-heap holding the top-k nums2 values seen so far\n        heap_sum = 0\n        i = 0\n        while i < n:\n            j = i\n            # group of equal nums1 values\n            while j < n and nums1[order[j]] == nums1[order[i]]:\n                j += 1\n            # answer queries for this group using only strictly smaller values\n            for t in range(i, j):\n                idx = order[t]\n                answer[idx] = heap_sum\n            # insert this group's values into the heap\n            for t in range(i, j):\n                v = nums2[order[t]]\n                if len(heap) < k:\n                    heapq.heappush(heap, v)\n                    heap_sum += v\n                elif v > heap[0]:\n                    heap_sum += v - heapq.heapreplace(heap, v)\n            i = j\n        return answer\n"}

