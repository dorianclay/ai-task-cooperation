TOOL submit_solution {"ticket_id": "Q-4507", "code": "from typing import List\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int) -> int:\n        cnt_k = sum(1 for v in nums if v == k)\n        best_gain = 0\n        for w in set(nums):\n            if w == k:\n                continue\n            # Choose subarray and shift it by k - w: positions with value w\n            # become k (gain +1), positions with value k inside it are lost (-1).\n            cur = 0\n            for v in nums:\n                if v == w:\n                    val = 1\n                elif v == k:\n                    val = -1\n                else:\n                    val = 0\n                cur = max(val, cur + val)\n                if cur > best_gain:\n                    best_gain = cur\n        return cnt_k + best_gain\n"}

