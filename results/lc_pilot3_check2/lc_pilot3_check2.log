TOOL submit_solution {"ticket_id": "Q-1940", "code": "from typing import List\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        INF = float('inf')\n        n = len(nums)\n        # dp[a][b] = min sum with a op1 used and b op2 used so far\n        dp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            new = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n            for a in range(op1 + 1):\n                for b in range(op2 + 1):\n                    cur = dp[a][b]\n                    if cur == INF:\n                        continue\n                    # no operation\n                    if cur + x < new[a][b]:\n                        new[a][b] = cur + x\n                    h = (x + 1) // 2  # op1 applied\n                    # op1 only\n                    if a + 1 <= op1 and cur + h < new[a + 1][b]:\n                        new[a + 1][b] = cur + h\n                    # op2 only\n                    if b + 1 <= op2 and x >= k:\n                        val = x - k\n                        if cur + val < new[a][b + 1]:\n                            new[a][b + 1] = cur + val\n                    # both: op1 then op2, or op2 then op1\n                    if a + 1 <= op1 and b + 1 <= op2:\n                        best_both = INF\n                        if h >= k:\n                            best_both = min(best_both, h - k)\n                        if x >= k:\n                            best_both = min(best_both, (x - k + 1) // 2)\n                        if cur + best_both < new[a + 1][b + 1]:\n                            new[a + 1][b + 1] = cur + best_both\n            dp = new\n        return min(min(row) for row in dp)\n"}

