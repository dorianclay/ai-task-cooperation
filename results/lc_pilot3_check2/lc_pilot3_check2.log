TOOL submit_solution {"ticket_id": "Q-5556", "code": "import random\n\nclass Solution:\n    def minCostGoodCaption(self, caption: str) -> str:\n        s = caption\n        n = len(s)\n        if n < 3:\n            return \"\"\n        x = [ord(ch) - 97 for ch in s]\n        INF = float('inf')\n        # prefix costs: pre[c][i] = sum_{t<i} |x_t - c|\n        pre = []\n        for c in range(26):\n            arr = [0] * (n + 1)\n            acc = 0\n            for t in range(n):\n                acc += abs(x[t] - c)\n                arr[t + 1] = acc\n            pre.append(arr)\n\n        P = (1 << 61) - 1\n        B = random.randrange(1000, P - 1)\n        Bp = [1] * (n + 2)\n        for t in range(1, n + 2):\n            Bp[t] = Bp[t - 1] * B % P\n        Rp = [0] * (n + 2)\n        for t in range(n + 1):\n            Rp[t + 1] = (Rp[t] + Bp[t]) % P\n\n        LOG = max(1, (n + 1).bit_length())\n        up = [[n] * (n + 1) for _ in range(LOG)]\n        H = [0] * (n + 1)\n        chv = [0] * (n + 1)\n        dp = [INF] * (n + 1)\n        dp[n] = 0\n        chL = [0] * (n + 1)\n        chC = [0] * (n + 1)\n\n        def lift(nxt, lim):\n            cur = nxt\n            for k in range(LOG - 1, -1, -1):\n                nj = up[k][cur]\n                if nj <= lim:\n                    cur = nj\n            return cur\n\n        def ph(i, L, v, nxt, m):\n            if m <= L:\n                return v * Rp[m] % P\n            cur = lift(nxt, i + m)\n            d = cur - i\n            r = m - d\n            part1 = (H[nxt] - Bp[cur - nxt] * H[cur]) % P\n            return (v * Rp[L] + Bp[L] * part1 + Bp[d] * (chv[cur] * Rp[r] % P)) % P\n\n        def char_at(i, L, v, nxt, m):\n            if m < L:\n                return v\n            return chv[lift(nxt, i + m)]\n\n        def lex_less(i, A, B_):\n            # A, B_ = (L, v, nxt); both candidates start at i, same length\n            LA, vA, nA = A\n            LB, vB, nB = B_\n            length = n - i\n            lo, hi = 0, length\n            while lo < hi:\n                mid = (lo + hi + 1) // 2\n                if ph(i, LA, vA, nA, mid) == ph(i, LB, vB, nB, mid):\n                    lo = mid\n                else:\n                    hi = mid - 1\n            if lo == length:\n                return False\n            return char_at(i, LA, vA, nA, lo) < char_at(i, LB, vB, nB, lo)\n\n        for i in range(n - 1, -1, -1):\n            best = None  # (total, L, c)\n            for L in (3, 4, 5):\n                if i + L > n or dp[i + L] == INF:\n                    continue\n                bc = -1\n                bcost = INF\n                for c in range(26):\n                    cst = pre[c][i + L] - pre[c][i]\n                    if cst < bcost:\n                        bcost = cst\n                        bc = c\n                total = bcost + dp[i + L]\n                if best is None or total < best[0]:\n                    best = (total, L, bc)\n                elif total == best[0]:\n                    candA = (L, bc + 1, i + L)\n                    candB = (best[1], best[2] + 1, i + best[1])\n                    if lex_less(i, candA, candB):\n                        best = (total, L, bc)\n            if best is None:\n                continue\n            total, L, c = best\n            nxt = i + L\n            dp[i] = total\n            chL[i] = L\n            chC[i] = c\n            v = c + 1\n            chv[i] = v\n            up[0][i] = nxt\n            for k in range(1, LOG):\n                up[k][i] = up[k - 1][up[k - 1][i]]\n            H[i] = (v * Rp[L] + Bp[L] * H[nxt]) % P\n\n        if dp[0] == INF:\n            return \"\"\n        res = []\n        i = 0\n        while i < n:\n            L = chL[i]\n            res.append(chr(97 + chC[i]) * L)\n            i += L\n        return \"\".join(res)\n"}

