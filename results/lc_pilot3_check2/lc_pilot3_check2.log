TOOL submit_solution {"ticket_id": "Q-1940", "code": "from typing import List\n\nclass Solution:\n    def minArraySum(self, nums: List[int], k: int, op1: int, op2: int) -> int:\n        INF = float('inf')\n        # dp[a][b] = minimum sum so far using a op1's and b op2's\n        dp = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n        dp[0][0] = 0\n        for x in nums:\n            half = (x + 1) // 2  # op1 result\n            # possible transformations: (cost_op1, cost_op2, value, use1, use2)\n            opts = []\n            opts.append((0, 0, x))  # none\n            opts.append((1, 0, half))  # op1 only\n            if x >= k:\n                opts.append((0, 1, x - k))  # op2 only\n                # both: op2 then op1\n                opts.append((1, 1, (x - k + 1) // 2))\n            # both: op1 then op2 (requires half >= k)\n            if half >= k:\n                opts.append((1, 1, half - k))\n            new = [[INF] * (op2 + 1) for _ in range(op1 + 1)]\n            for a in range(op1 + 1):\n                row = dp[a]\n                for b in range(op2 + 1):\n                    cur = row[b]\n                    if cur == INF:\n                        continue\n                    for u1, u2, val in opts:\n                        na, nb = a + u1, b + u2\n                        if na <= op1 and nb <= op2:\n                            v = cur + val\n                            if v < new[na][nb]:\n                                new[na][nb] = v\n            dp = new\n        return int(min(min(row) for row in dp))\n"}

