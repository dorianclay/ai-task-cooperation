TOOL submit_solution {"ticket_id": "Q-5301", "code": "from typing import List\nimport bisect\n\nclass Solution:\n    def shortestMatchingSubstring(self, s: str, p: str) -> int:\n        n = len(s)\n        i1 = p.index('*')\n        i2 = p.index('*', i1 + 1)\n        A = p[:i1]\n        B = p[i1 + 1:i2]\n        C = p[i2 + 1:]\n\n        def find_all(pat, text):\n            m = len(pat)\n            if m == 0:\n                return list(range(len(text) + 1))\n            comb = pat + '#' + text\n            L = len(comb)\n            pi = [0] * L\n            k = 0\n            for q in range(1, L):\n                while k > 0 and comb[q] != comb[k]:\n                    k = pi[k - 1]\n                if comb[q] == comb[k]:\n                    k += 1\n                pi[q] = k\n            res = []\n            for q in range(m + 1, L):\n                if pi[q] == m:\n                    res.append(q - 2 * m)\n            return res\n\n        occA = find_all(A, s)\n        occB = find_all(B, s)\n        occC = find_all(C, s)\n        lenA, lenB, lenC = len(A), len(B), len(C)\n\n        best = -1\n        for a in occA:\n            ib = bisect.bisect_left(occB, a + lenA)\n            if ib >= len(occB):\n                continue\n            b = occB[ib]\n            ic = bisect.bisect_left(occC, b + lenB)\n            if ic >= len(occC):\n                continue\n            c = occC[ic]\n            length = c + lenC - a\n            if best == -1 or length < best:\n                best = length\n        return best\n"}

